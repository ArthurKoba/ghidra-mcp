:"IF GT" "AR" "=" ALUY "+ 1" is type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=2
{ if(AZF!=0) goto inst_next; if(ANF!=AVF) goto inst_next; local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }
:"IF LT" "AR" "=" ALUY "+ 1" is type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=4
{ if(ANF==AVF) goto inst_next; local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }
:"IF NE" "AR" "=" AluConst "+ 1" is type9=4 & z18=0 & amf5=17 & AluConst & cond4=1
{ if(AZF!=0) goto inst_next; local c:2=AluConst; AR=c+1; alu_flags_add(c,1:2,AR); }
:"IF GT" "AR" "=" AluConst "+ 1" is type9=4 & z18=0 & amf5=17 & AluConst & cond4=2
{ if(AZF!=0) goto inst_next; if(ANF!=AVF) goto inst_next; local c:2=AluConst; AR=c+1; alu_flags_add(c,1:2,AR); }
:"IF GT" "AR" "=" AluConst "- 1" is type9=4 & z18=0 & amf5=24 & AluConst & cond4=2
{ if(AZF!=0) goto inst_next; if(ANF!=AVF) goto inst_next; local c:2=AluConst; AR=c-1; alu_flags_sub(c,1:2,AR); }
:"IF GT" "AR" "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=2
{ if(AZF!=0) goto inst_next; if(ANF!=AVF) goto inst_next; local x:2=ALUX; local y:2=ALUY; AR=x+y; alu_flags_add(x,y,AR); }
:"IF NE" "AR" "=" ALUX "AND" AluConst is type9=4 & z18=0 & amf5=28 & ALUX & AluConst & cond4=1
{ if(AZF!=0) goto inst_next; AR=ALUX&AluConst; alu_flags_logic(AR); }
:"IF NE" "AR" "=" ALUX "OR" AluConst is type9=4 & z18=0 & amf5=29 & ALUX & AluConst & cond4=1
{ if(AZF!=0) goto inst_next; AR=ALUX|AluConst; alu_flags_logic(AR); }

# Type 12: shift plus DM read/write.
:SR "=" "LSHIFT" ShiftX "(HI)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=0 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{ local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 a; local src:4=zext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <t12lhi_r>; res=src<<count; goto <t12lhi_d>; <t12lhi_r> count=-count; res=src>>count; <t12lhi_d> SR0=res:2; SR1=res[16,16]; DReg4=fetched; ShiftDagI=a+m; }
:SR "=" "ASHIFT" ShiftX "(HI)," "DM(" ShiftDagI "," ShiftDagM ")" "=" DReg4 is type12=9 & shift_d=1 & sf4=4 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{ local a:2=ShiftDagI; local m:2=ShiftDagM; local stored:2=DReg4; local src:4=sext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <t12awh_r>; res=src<<count; goto <t12awh_d>; <t12awh_r> count=-count; res=src s>>count; <t12awh_d> SR0=res:2; SR1=res[16,16]; *[DM]:2 a=stored; ShiftDagI=a+m; }
:SR "=" "ASHIFT" ShiftX "(LO)," "DM(" ShiftDagI "," ShiftDagM ")" "=" DReg4 is type12=9 & shift_d=1 & sf4=6 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{ local a:2=ShiftDagI; local m:2=ShiftDagM; local stored:2=DReg4; local src:4=sext(ShiftX); local count:2=SE; local res:4=src; if(count s<0) goto <t12awl_r>; res=src<<count; goto <t12awl_d>; <t12awl_r> count=-count; res=src s>>count; <t12awl_d> SR0=res:2; SR1=res[16,16]; *[DM]:2 a=stored; ShiftDagI=a+m; }

# Type 14/16 additional shifter forms.
:SR "=" "LSHIFT" ShiftX "(HI)," DReg4 "=" DReg is op8=0x10 & sf4=0 & ShiftX & DReg4 & DReg
{ local moved:2=DReg; local src:4=zext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <t14hi_r>; res=src<<count; goto <t14hi_d>; <t14hi_r> count=-count; res=src>>count; <t14hi_d> SR0=res:2; SR1=res[16,16]; DReg4=moved; }
:SR "=" "SR OR LSHIFT" ShiftX "(LO)," DReg4 "=" DReg is op8=0x10 & sf4=3 & ShiftX & DReg4 & DReg
{ local moved:2=DReg; local src:4=zext(ShiftX); local count:2=SE; local shifted:4=src; if(count s<0) goto <t14or_r>; shifted=src<<count; goto <t14or_d>; <t14or_r> count=-count; shifted=src>>count; <t14or_d> local old:4=(zext(SR1)<<16)|zext(SR0); local res:4=old|shifted; SR0=res:2; SR1=res[16,16]; DReg4=moved; }
:SR "=" "LSHIFT" ShiftX "(HI)" is op8=0x0e & sf4=0 & ShiftX & mid4=0 & cond4=15
{ local src:4=zext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <t16hi_r>; res=src<<count; goto <t16hi_d>; <t16hi_r> count=-count; res=src>>count; <t16hi_d> SR0=res:2; SR1=res[16,16]; }
:SR "=" "ASHIFT" ShiftX "(LO)" is op8=0x0e & sf4=6 & ShiftX & mid4=0 & cond4=15
{ local src:4=sext(ShiftX); local count:2=SE; local res:4=src; if(count s<0) goto <t16alo_r>; res=src<<count; goto <t16alo_d>; <t16alo_r> count=-count; res=src s>>count; <t16alo_d> SR0=res:2; SR1=res[16,16]; }

# Deep shift reachable forms.
:SR "=" "LSHIFT" ShiftX "(LO)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=2 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{ local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 a; local src:4=zext(ShiftX); local count:2=SE; local res:4=src; if(count s<0) goto <deep_t12llo_r>; res=src<<count; goto <deep_t12llo_d>; <deep_t12llo_r> count=-count; res=src>>count; <deep_t12llo_d> SR0=res:2; SR1=res[16,16]; DReg4=fetched; ShiftDagI=a+m; }
:SR "=" "ASHIFT" ShiftX "(HI)," DReg4 "=" DReg is op8=0x10 & sf4=4 & ShiftX & DReg4 & DReg
{ local moved:2=DReg; local src:4=sext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <deep_t14ahi_r>; res=src<<count; goto <deep_t14ahi_d>; <deep_t14ahi_r> count=-count; res=src s>>count; <deep_t14ahi_d> SR0=res:2; SR1=res[16,16]; DReg4=moved; }
:SR "=" "ASHIFT" ShiftX "(LO)," DReg4 "=" DReg is op8=0x10 & sf4=6 & ShiftX & DReg4 & DReg
{ local moved:2=DReg; local src:4=sext(ShiftX); local count:2=SE; local res:4=src; if(count s<0) goto <deep_t14alo_r>; res=src<<count; goto <deep_t14alo_d>; <deep_t14alo_r> count=-count; res=src s>>count; <deep_t14alo_d> SR0=res:2; SR1=res[16,16]; DReg4=moved; }
:SR "=" "ASHIFT" ShiftX "(HI)" is op8=0x0e & sf4=4 & ShiftX & mid4=0 & cond4=15
{ local src:4=sext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <deep_t16ahi_r>; res=src<<count; goto <deep_t16ahi_d>; <deep_t16ahi_r> count=-count; res=src s>>count; <deep_t16ahi_d> SR0=res:2; SR1=res[16,16]; }


:SR "=" "SR OR LSHIFT" ShiftX "(HI)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=1 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{
    local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 a; local src:4=zext(ShiftX)<<16; local count:2=SE; local shifted:4=src;
    if(count s<0) goto <final_t12orhi_r>; shifted=src<<count; goto <final_t12orhi_d>;
<final_t12orhi_r> count=-count; shifted=src>>count;
<final_t12orhi_d> local old:4=(zext(SR1)<<16)|zext(SR0); local res:4=old|shifted; SR0=res:2; SR1=res[16,16]; DReg4=fetched; ShiftDagI=a+m;
}
:SR "=" "SR OR LSHIFT" ShiftX "(LO)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=3 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{
    local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 a; local src:4=zext(ShiftX); local count:2=SE; local shifted:4=src;
    if(count s<0) goto <final_t12orlo_r>; shifted=src<<count; goto <final_t12orlo_d>;
<final_t12orlo_r> count=-count; shifted=src>>count;
<final_t12orlo_d> local old:4=(zext(SR1)<<16)|zext(SR0); local res:4=old|shifted; SR0=res:2; SR1=res[16,16]; DReg4=fetched; ShiftDagI=a+m;
}

# Deep T9 rounded subtract.
:"MR = MR -" MACX "*" MACY "(RND)" is type9=4 & z18=0 & amf5=3 & MACX & MACY & mid4=0 & cond4=15
{ dsp_mac_sub_round_xy(MACX,MACY); }

# Deep Type 8 reachable forms.
:AR "=" ALUY "-" ALUX "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=25 & ALUX & ALUY & DReg4 & DReg
{ local moved:2=DReg; local y:2=ALUY; local x:2=ALUX; AR=y-x; DReg4=moved; alu_flags_sub(y,x,AR); }
:AF "=" ALUX "XOR" ALUY "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=30 & ALUX & ALUY & DReg4 & DReg
{ local moved:2=DReg; AF=ALUX^ALUY; DReg4=moved; alu_flags_logic(AF); }
:"MR =" MACX "*" MACY "(SU)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=5 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; local x:4=sext(MACX); local y:4=zext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <deep_t8su_d>; MR2=0xffff; <deep_t8su_d> DReg4=moved; MVF=0; }
:"MR =" MACX "*" MACY "(US)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=6 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; local x:4=zext(MACX); local y:4=sext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <deep_t8us_d>; MR2=0xffff; <deep_t8us_d> DReg4=moved; MVF=0; }

:AF "=" ALUY "- 1," DReg4 "=" DReg is type9=5 & z18=1 & amf5=24 & ALUY & DReg4 & DReg
{ local moved:2=DReg; local y:2=ALUY; AF=y-1; DReg4=moved; alu_flags_sub(y,1:2,AF); }
:AR "=" ALUX "OR" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=29 & ALUX & ALUY & DReg4 & DReg
{ local moved:2=DReg; AR=ALUX|ALUY; DReg4=moved; alu_flags_logic(AR); }
:"MF = MR +" MACX "*" MACY "(SS)," DReg4 "=" DReg is type9=5 & z18=1 & amf5=8 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MF=res[16,16]; DReg4=moved; }

