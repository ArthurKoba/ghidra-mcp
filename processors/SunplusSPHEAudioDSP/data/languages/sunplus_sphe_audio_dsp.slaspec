# ADSP-218x Instruction Set Reference rev.2: A-6 and ALU operand table.
# Independently reproduced native 061000=DIVS AF,AX0 and 071000=DIVQ AX0.
# The former table incorrectly shifted X selections and allowed non-Y registers.
DivX: AX0 is xop3=0 & AX0 { export AX0; }
DivX: AX1 is xop3=1 & AX1 { export AX1; }
DivX: AR  is xop3=2 & AR  { export AR; }
DivX: MR0 is xop3=3 & MR0 { export MR0; }
DivX: MR1 is xop3=4 & MR1 { export MR1; }
DivX: MR2 is xop3=5 & MR2 { export MR2; }
DivX: SR0 is xop3=6 & SR0 { export SR0; }
DivX: SR1 is xop3=7 & SR1 { export SR1; }
DivY: AY1 is yop2=1 & AY1 { export AY1; }
DivY: AF  is yop2=2 & AF  { export AF; }

JumpAddr: addr14 is addr14 { export *[PM]:2 addr14; }
LoopAddr: loop14 is loop14 { export *[PM]:2 loop14; }

# ADSP-218x Hardware Reference 4-8: BIT_REV reverses the fourteen
# DAG1 address output lines, NOT the index register or its post-update.
# This branch-free network avoids manufacturing a conditional CFG edge.
# Target acceptance remains separate; linear/circular I updates are unchanged.
macro dag1_dm_address(index, effective) {
    local br_pair:2 = ((index & 0x5555) << 1) | ((index >> 1) & 0x5555);
    local br_quad:2 = ((br_pair & 0x3333) << 2) | ((br_pair >> 2) & 0x3333);
    local br_octet:2 = ((br_quad & 0x0f0f) << 4) | ((br_quad >> 4) & 0x0f0f);
    local br_word:2 = (br_octet << 8) | (br_octet >> 8);
    local br_address:2 = br_word >> 2;
    local br_mask:2 = 0 - ((MSTAT >> 1) & 1);
    effective = (index & ~br_mask) | (br_address & br_mask);
}

# Compile-time DAG selection: DAG2 has no dependency on BIT_REV.
# Export fresh address values; memory access must never change I0..I7.
DagDmAddress: is g20=0 & DagI {
    local effective:2;
    dag1_dm_address(DagI, effective);
    export effective;
}
DagDmAddress: is g20=1 & DagI { export DagI; }

DualDmAddress: is DmI {
    local effective:2;
    dag1_dm_address(DmI, effective);
    export effective;
}

ShiftDmAddress: is shift_g=0 & ShiftDagI {
    local effective:2;
    dag1_dm_address(ShiftDagI, effective);
    export effective;
}
ShiftDmAddress: is shift_g=1 & ShiftDagI { export ShiftDagI; }


# ADSP-218x Chapter 4: I/M/L are 14-bit, M signed, L zero selects linear.
# Base B is the current valid I rounded down to a multiple of ceilpow2(L).
# Circular mode requires I in [B, B+L) and |M|<L (processor specification).
# This P-code implements one valid wrap per update without branching.
macro dsp_dag_postmodify(target, oldindex, delta, length) {
    local index14:2 = oldindex & 0x3fff;
    local mod14:2 = delta & 0x3fff;
    local signed14:2 = (mod14 << 2) s>> 2;
    local i32:4 = zext(index14);
    local m32:4 = sext(signed14);
    local l32:4 = zext(length & 0x3fff);
    local rounded:4 = l32 - 1;
    rounded = rounded | (rounded >> 1);
    rounded = rounded | (rounded >> 2);
    rounded = rounded | (rounded >> 4);
    rounded = rounded | (rounded >> 8);
    local base:4 = i32 & ~rounded;
    local candidate:4 = i32 + m32;
    local enabled:4 = 0 - zext(l32 != 0);
    local lower:4 = 0 - zext(candidate s< base);
    local upper:4 = 0 - zext(candidate s>= (base + l32));
    local adjusted:4 = candidate + (l32 & lower & enabled) - (l32 & upper & enabled);
    # Preserve the pre-existing full 16-bit register update with L==0.
    # Only enabled circular mode confines the physical address to 14 bits.
    local mode:2 = 0 - zext(length != 0);
    local linear:2 = oldindex + delta;
    local circular:2 = adjusted:2 & 0x3fff;
    target = (linear & ~mode) | (circular & mode);
}

macro alu_flags_add(a, b, r) {
    AZF = (r == 0);
    ANF = (r s< 0);
    AVF = scarry(a, b);
}

macro alu_flags_sub(a, b, r) {
    AZF = (r == 0);
    ANF = (r s< 0);
    AVF = sborrow(a, b);
}

macro alu_flags_logic(r) {
    AZF = (r == 0);
    ANF = (r s< 0);
    AVF = 0;
}

# -----------------------------------------------------------------------------
define pcodeop dsp_resident_tailcall;
@include "sunplus_stack_runtime.sinc"

# Counted nested CE loops need two separate stacks:
#   - a CNTR write saves the active outer loop's remaining count;
#   - a DO saves its return loop start, not the counter itself.
# The four-count/frame model is scoped to the observed codec instructions.
macro codec_cntr_load(newvalue) {
    local incoming:2 = newvalue;
    if (DSP_LOOP_DEPTH == 0) goto <cntr_done>;
    if (DSP_COUNT_DEPTH == 0) goto <cntr_save0>;
    if (DSP_COUNT_DEPTH == 1) goto <cntr_save1>;
    if (DSP_COUNT_DEPTH == 2) goto <cntr_save2>;
    if (DSP_COUNT_DEPTH == 3) goto <cntr_save3>;
    goto <cntr_done>; # unmodelled stack-overflow status, no push
<cntr_save0> DSP_COUNT0 = CNTR; DSP_COUNT_DEPTH = 1; goto <cntr_done>;
<cntr_save1> DSP_COUNT1 = CNTR; DSP_COUNT_DEPTH = 2; goto <cntr_done>;
<cntr_save2> DSP_COUNT2 = CNTR; DSP_COUNT_DEPTH = 3; goto <cntr_done>;
<cntr_save3> DSP_COUNT3 = CNTR; DSP_COUNT_DEPTH = 4;
<cntr_done> CNTR = incoming;
}

# Native CALL/RTS uses the ADSP PC stack. Ghidra's CALL P-code branches to the
# target, but does not populate synthetic PCSTACKTOP on its own. Keep a
# deliberately bounded return stack for the explicitly opted-in nested mode.
# This is not a full model of the 16-deep hardware PC stack shared with DO.
macro codec_call_push(nextword) {
    local ret:2 = nextword;
    if (DSP_CALL_DEPTH == 0) goto <call_push0>;
    if (DSP_CALL_DEPTH == 1) goto <call_push1>;
    if (DSP_CALL_DEPTH == 2) goto <call_push2>;
    if (DSP_CALL_DEPTH == 3) goto <call_push3>;
    goto <call_done>;
<call_push0> DSP_CALL_RET0 = ret; DSP_CALL_DEPTH = 1; goto <call_done>;
<call_push1> DSP_CALL_RET1 = ret; DSP_CALL_DEPTH = 2; goto <call_done>;
<call_push2> DSP_CALL_RET2 = ret; DSP_CALL_DEPTH = 3; goto <call_done>;
<call_push3> DSP_CALL_RET3 = ret; DSP_CALL_DEPTH = 4;
<call_done>
}

# In opted-in nested mode, RTS (including conditional variants) consumes
# the synthetic call stack. Hardware PC-stack sharing with DO is not modeled.
macro codec_call_return() {
    if (DSP_CALL_DEPTH == 1) goto <call_ret0>;
    if (DSP_CALL_DEPTH == 2) goto <call_ret1>;
    if (DSP_CALL_DEPTH == 3) goto <call_ret2>;
    if (DSP_CALL_DEPTH == 4) goto <call_ret3>;
    return [PCSTACKTOP];
<call_ret0> DSP_CALL_DEPTH = 0; return [DSP_CALL_RET0];
<call_ret1> DSP_CALL_DEPTH = 1; return [DSP_CALL_RET1];
<call_ret2> DSP_CALL_DEPTH = 2; return [DSP_CALL_RET2];
<call_ret3> DSP_CALL_DEPTH = 3; return [DSP_CALL_RET3];
}

# Generic end-of-loop processing must wrap all normal instruction constructors:
# the block-end instruction executes first, then CE counter/back-edge.
# Kept separate from the specialized srvdsp PM:186C implementation.
codecLoopStart: is epsilon { export *:2 DSP_LOOP_START; }
codecDirectLoopStart: codec_ce_direct_start is codec_ce_direct_start {
    export *[PM]:2 codec_ce_direct_start;
}
# A proven direct backedge stays analyzable even across a resident CALL:
# runtime DSP_LOOP_START is held on silicon, but the decompiler need not
# infer its value across a callee whose ABI cannot establish preservation.
# This path is opt-in for individually verified DO/end instruction pairs.
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & codec_ce_loop_end=1 & codec_ce_direct_backedge=1 & codec_ce_nested_mode=0 & instruction & codecDirectLoopStart [ codec_ce_phase=1; ] {
    build instruction;
    CNTR = CNTR - 1;
    if (CNTR == 0) goto <codec_ce_direct_done>;
    goto codecDirectLoopStart;
<codec_ce_direct_done>
    DSP_LOOP_START = DSP_LOOP_START_SHADOW;
    CNTR = DSP_LOOP_COUNT_SHADOW;
}
# Opt-in deterministic outer backedge for hardware-nested codec loops.
# Unlike the nonnested direct CE constructor, the nested outer end must NOT
# restore CNTR from DSP_LOOP_COUNT_SHADOW: the inner CNTR load saves the outer
# counter in DSP_STATIC_CNTR_OUTER and the inner-end restores it already.
# The outer DO constructor stores its start separately; the direct target is
# a statically verified DO fallthrough, never a guessed dynamic address.
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & codec_ce_loop_end=1 & codec_ce_direct_backedge=1 & codec_ce_nested_mode=1 & codec_ce_static_depth=1 & instruction & codecDirectLoopStart [ codec_ce_phase=1; ] {
    build instruction;
    CNTR = CNTR - 1;
    if (CNTR == 0) goto <codec_ce_nested_outer_done>;
    goto codecDirectLoopStart;
<codec_ce_nested_outer_done>
}
# EXPERIMENT: opt-in STATIC INNER (depth=2) CE direct backedge.
# Requires the proven CNTR-save constructor at native depth-2 counter writers.
# The inner CE must restore the saved outer count only on exit.
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & codec_ce_loop_end=1 & codec_ce_direct_backedge=1 & codec_ce_nested_mode=1 & codec_ce_static_depth=2 & instruction & codecDirectLoopStart [ codec_ce_phase=1; ] {
    build instruction;
    CNTR = CNTR - 1;
    if (CNTR == 0) goto <codec_ce_nested_inner_direct_done>;
    goto codecDirectLoopStart;
<codec_ce_nested_inner_direct_done>
    CNTR = DSP_STATIC_CNTR_OUTER;
}
# Full software sequencer execution, without per-site CE or loop-depth hints.
:^instruction is codec_arch_stack_mode=1 & codec_ce_phase=0 & instruction [ codec_ce_phase=1; ] {
    DSP_PC_POP_ACTIVE=DSP_PC_POP_PENDING;
    DSP_PC_POP_PENDING=0;
    arch_sstat();
    build instruction;
    arch_complete_pending_pc();
    arch_end_instruction(inst_start / 3);
    local next_word:2=inst_next / 3;
    if (next_word < 0x4000) goto <no_pc_wrap>;
    goto [0:2];
<no_pc_wrap>
}

# Keep the proven lightweight single-loop C recovery as the default.
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & codec_ce_loop_end=1 & codec_ce_direct_backedge=0 & codec_ce_nested_mode=0 & instruction & codecLoopStart [ codec_ce_phase=1; ] {
    build instruction;
    CNTR = CNTR - 1;
    if (CNTR == 0) goto <simple_done>;
    goto [DSP_LOOP_START];
<simple_done>
    DSP_LOOP_START = DSP_LOOP_START_SHADOW;
    CNTR = DSP_LOOP_COUNT_SHADOW;
}
# EXPERIMENT: deterministic two-level CE endpoints for CFG recovery.
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & codec_ce_loop_end=1 & codec_ce_direct_backedge=0 & codec_ce_nested_mode=1 & codec_ce_static_depth=1 & instruction & codecLoopStart [ codec_ce_phase=1; ] {
    build instruction;
    CNTR = CNTR - 1;
    if (CNTR == 0) goto <static_outer_done>;
    goto [DSP_STATIC_START_OUTER];
<static_outer_done>
}
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & codec_ce_loop_end=1 & codec_ce_direct_backedge=0 & codec_ce_nested_mode=1 & codec_ce_static_depth=2 & instruction & codecLoopStart [ codec_ce_phase=1; ] {
    build instruction;
    CNTR = CNTR - 1;
    if (CNTR == 0) goto <static_inner_done>;
    goto [DSP_STATIC_START_INNER];
<static_inner_done>
    CNTR = DSP_STATIC_CNTR_OUTER;
}
# Expanded stack handling is selected only for proven nested DO regions.
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & codec_ce_loop_end=1 & codec_ce_direct_backedge=0 & codec_ce_nested_mode=1 & instruction & codecLoopStart [ codec_ce_phase=1; ] {
    build instruction;
    CNTR = CNTR - 1;
    if (CNTR == 0) goto <codec_ce_done>;
    goto [DSP_LOOP_START];
<codec_ce_done>
    if (DSP_LOOP_DEPTH == 1) goto <ce_pop1>;
    if (DSP_LOOP_DEPTH == 2) goto <ce_pop2>;
    if (DSP_LOOP_DEPTH == 3) goto <ce_pop3>;
    if (DSP_LOOP_DEPTH == 4) goto <ce_pop4>;
    goto <ce_count_restore>;
<ce_pop1> DSP_LOOP_START = 0; DSP_LOOP_DEPTH = 0; goto <ce_count_restore>;
<ce_pop2> DSP_LOOP_START = DSP_LOOP_START_SHADOW; DSP_LOOP_DEPTH = 1; goto <ce_count_restore>;
<ce_pop3> DSP_LOOP_START = DSP_LOOP_START_SHADOW2; DSP_LOOP_DEPTH = 2; goto <ce_count_restore>;
<ce_pop4> DSP_LOOP_START = DSP_LOOP_START_SHADOW3; DSP_LOOP_DEPTH = 3;
<ce_count_restore>
    if (DSP_COUNT_DEPTH == 0) goto <ce_finish>;
    if (DSP_COUNT_DEPTH == 1) goto <ce_count0>;
    if (DSP_COUNT_DEPTH == 2) goto <ce_count1>;
    if (DSP_COUNT_DEPTH == 3) goto <ce_count2>;
    if (DSP_COUNT_DEPTH == 4) goto <ce_count3>;
    goto <ce_finish>;
<ce_count0> CNTR = DSP_COUNT0; DSP_COUNT_DEPTH = 0; goto <ce_finish>;
<ce_count1> CNTR = DSP_COUNT1; DSP_COUNT_DEPTH = 1; goto <ce_finish>;
<ce_count2> CNTR = DSP_COUNT2; DSP_COUNT_DEPTH = 2; goto <ce_finish>;
<ce_count3> CNTR = DSP_COUNT3; DSP_COUNT_DEPTH = 3;
<ce_finish>
}
:^instruction is codec_arch_stack_mode=0 & codec_ce_phase=0 & instruction [ codec_ce_phase=1; ] {
    build instruction;
}
with : codec_ce_phase=1 {

# Type 1 dual DM+PM fetch and Type 2 immediate DM write.
# Type-1 reads are parallel/read-first; PM low 8 bits are captured in PX.
# -----------------------------------------------------------------------------

:"" PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=0 & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM;
    local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress;
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL);
}
:"MR =" MACX "*" MACY "(SS)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=4 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress;
    local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2;
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL); MVF=0;
}
:AR "=" ALUX "-" ALUY "," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=23 & ALUX & ALUY & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress;
    local x:2=ALUX; local y:2=ALUY; AR=x-y; alu_flags_sub(x,y,AR);
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL);
}

:"DM(" DagI "," DagM ")" "=" t2_data is type3=5 & DagI & DagM & t2_data & DagDmAddress & DagL
{
    local a:2=DagI; *[DM]:2 DagDmAddress=t2_data; dsp_dag_postmodify(DagI, DagI, DagM, DagL);
}

# -----------------------------------------------------------------------------
# Type 5 pure Program Memory read/write (AMF=0). PM is 24-bit: reads place
# PMD23..8 in DREG and PMD7..0 in PX; writes combine DREG<<8 with PX[7:0].
# -----------------------------------------------------------------------------

:"" DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=0 & yop2=0 & xop3=0 & DReg4 & DagI & DagM & DagL
{
    local a:2 = DagI;
    local word:3 = dsp_pm_load24(a);
    DReg4 = word[8,16];
    PX = zext(word[0,8]);
    dsp_dag_postmodify(DagI, DagI, DagM, DagL);
}

:"PM(" DagI "," DagM ")" "=" DReg4 is op4=5 & d19=1 & z18=0 & amf5=0 & yop2=0 & xop3=0 & DReg4 & DagI & DagM & DagL
{
    local a:2 = DagI;
    local hi:3 = zext(DReg4) << 8;
    local lo:3 = zext(PX) & 0xff;
    local word:3 = hi | lo;
    dsp_pm_store24(a,word);
    dsp_dag_postmodify(DagI, DagI, DagM, DagL);
}

# -----------------------------------------------------------------------------
# Direct/immediate moves (Types 3, 6, 7).
# -----------------------------------------------------------------------------

# Explicit codec counter loads also model the counter-stack push on write.
# The srvdsp wrapper retains its existing isolated language semantics.
# EXPERIMENT: inner-loop counter saves the statically known outer counter.
:DMREAD CNTR, addr14 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=1 & codec_ce_static_depth=2 & type3=4 & dir20=0 & rgp=3 & reg4=0x5 & CNTR & addr14
{
    local addr:2=addr14;
    local newval:2=*[DM]:2 addr;
    DSP_STATIC_CNTR_OUTER = CNTR;
    CNTR = newval;
}

:DMREAD CNTR, addr14 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=1 & type3=4 & dir20=0 & rgp=3 & reg4=0x5 & CNTR & addr14
{
    local dmaddr:2 = addr14;
    local incoming:2 = *[DM]:2 dmaddr;
    codec_cntr_load(incoming);
}

:DMREAD RegSel, addr14 is type3=4 & dir20=0 & RegSel & addr14
{
    local dmaddr:2 = addr14;
    RegSel = *[DM]:2 dmaddr;
}

:DMWRITE addr14, RegSel is type3=4 & dir20=1 & RegSel & addr14
{
    local dmaddr:2 = addr14;
    *[DM]:2 dmaddr = RegSel;
}

:LDI DReg, imm16 is op4=4 & DReg & imm16
{
    DReg = imm16;
}

# LDI CNTR is the other corpus-proven counter-stack push instruction.
# EXPERIMENT: inner-loop immediate counter with one static saved frame.
:LDI CNTR, data14 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=1 & codec_ce_static_depth=2 & op4=3 & rgp=3 & reg4=0x5 & CNTR & data14
{
    DSP_STATIC_CNTR_OUTER = CNTR;
    CNTR = data14;
}

:LDI CNTR, data14 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=1 & op4=3 & rgp=3 & reg4=0x5 & CNTR & data14
{
    codec_cntr_load(data14:2);
}

:LDI RegSel, data14 is op4=3 & RegSel & data14
{
    RegSel = data14;
}

# -----------------------------------------------------------------------------
# Type 4: ALU/MAC with DM read/write.
# srvdsp uses the no-compute DM-write form at PM:186c. The proven DO ...
# UNTIL CE sequence is a single-instruction hardware loop; the DO constructor
# marks that loop-end instruction in decode context so its P-code can expose
# the real CNTR-controlled back edge to the behavior engine.
# -----------------------------------------------------------------------------

:DMWRITE DagI, DagM, DReg4 is srvdsp_ce_loop_end=1 & type3=3 & d19=1 & amf5=0 & DagI & DagM & DReg4 & DagDmAddress & DagL
{
    local dmaddr:2 = DagI;
    *[DM]:2 DagDmAddress = DReg4;
    dsp_dag_postmodify(DagI, DagI, DagM, DagL);
    CNTR = CNTR - 1;
    if (CNTR != 0) goto inst_start;
}

:DMWRITE DagI, DagM, DReg4 is srvdsp_ce_loop_end=0 & type3=3 & d19=1 & amf5=0 & DagI & DagM & DReg4 & DagDmAddress & DagL
{
    local dmaddr:2 = DagI;
    *[DM]:2 DagDmAddress = DReg4;
    dsp_dag_postmodify(DagI, DagI, DagM, DagL);
}

:DMREAD DReg4, DagI, DagM is type3=3 & d19=0 & amf5=0 & DagI & DagM & DReg4 & DagDmAddress & DagL
{
    local dmaddr:2 = DagI;
    DReg4 = *[DM]:2 DagDmAddress;
    dsp_dag_postmodify(DagI, DagI, DagM, DagL);
}

# Corpus-proven Type-4 ALU + DM-read multifunction forms.  All source values
# are sampled before result/register/pointer writes, matching parallel DSP
# semantics.
:AR "=" ALUX "+" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local a:2 = DagI;
    local m:2 = DagM;
    local fetched:2 = *[DM]:2 DagDmAddress;
    local r:2 = x + y;
    AR = r;
    DReg4 = fetched;
    dsp_dag_postmodify(DagI, a, m, DagL);
    alu_flags_add(x, y, r);
}

:AR "=" ALUY "- 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=24 & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local y:2 = ALUY;
    local a:2 = DagI;
    local m:2 = DagM;
    local fetched:2 = *[DM]:2 DagDmAddress;
    local r:2 = y - 1;
    AR = r;
    DReg4 = fetched;
    dsp_dag_postmodify(DagI, a, m, DagL);
    alu_flags_sub(y, 1:2, r);
}

# -----------------------------------------------------------------------------
# Type 8 codec-profile forms.
#
# Low byte 0xAA is the ISA's NONE=<ALU> status-only encoding (Table A-9),
# not a self-move.  It updates ASTAT predicates while preserving AR/AF.
# General Type-8 arithmetic+move forms are parallel/read-first: snapshot all
# sources before writing either result.  The ISA declares dual-destination
# conflicts unsupported, so no ordering is invented for illegal encodings.
# -----------------------------------------------------------------------------

:NONE "=" ALUX "+" ALUY is type9=5 & z18=0 & amf5=19 & ALUX & ALUY & t4_dreg=0xa & dreg4=0xa
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local r:2 = x + y;
    alu_flags_add(x, y, r);
}

:NONE "=" ALUX "-" ALUY is type9=5 & z18=0 & amf5=23 & ALUX & ALUY & t4_dreg=0xa & dreg4=0xa
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local r:2 = x - y;
    alu_flags_sub(x, y, r);
}

:AR "=" ALUX "+" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x + y;
    AR = r;
    DReg4 = moved;
    alu_flags_add(x, y, r);
}

:AF "=" ALUX "+" ALUY "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x + y;
    AF = r;
    DReg4 = moved;
    alu_flags_add(x, y, r);
}

:AR "=" ALUX "-" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x - y;
    AR = r;
    DReg4 = moved;
    alu_flags_sub(x, y, r);
}

:AF "=" ALUX "-" ALUY "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=23 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x - y;
    AF = r;
    DReg4 = moved;
    alu_flags_sub(x, y, r);
}

# Type-9 constant operand subset observed in codec profiles.  Values follow
# ADSP-218x Table A-60 (YY/CC/BO).  Additional codes remain unsupported until
# exercised or needed.
AluConst: 0x0001 is yy2=0 & cc2=0 & bo2=1 { export 0x0001:2; }
AluConst: 0x0002 is yy2=0 & cc2=1 & bo2=1 { export 0x0002:2; }
AluConst: 0x0008 is yy2=0 & cc2=3 & bo2=1 { export 0x0008:2; }
AluConst: 0x0010 is yy2=1 & cc2=0 & bo2=1 { export 0x0010:2; }
AluConst: 0x0020 is yy2=1 & cc2=1 & bo2=1 { export 0x0020:2; }
AluConst: 0x0040 is yy2=1 & cc2=2 & bo2=1 { export 0x0040:2; }
AluConst: 0x0080 is yy2=1 & cc2=3 & bo2=1 { export 0x0080:2; }
AluConst: 0x4000 is yy2=3 & cc2=2 & bo2=1 { export 0x4000:2; }
AluConst: 0x0004 is yy2=0 & cc2=2 & bo2=1 { export 0x0004:2; }
AluConst: 0x0100 is yy2=2 & cc2=0 & bo2=1 { export 0x0100:2; }
AluConst: 0x0200 is yy2=2 & cc2=1 & bo2=1 { export 0x0200:2; }
AluConst: 0x0400 is yy2=2 & cc2=2 & bo2=1 { export 0x0400:2; }
AluConst: 0x0800 is yy2=2 & cc2=3 & bo2=1 { export 0x0800:2; }
AluConst: 0x1000 is yy2=3 & cc2=0 & bo2=1 { export 0x1000:2; }
AluConst: 0x2000 is yy2=3 & cc2=1 & bo2=1 { export 0x2000:2; }
AluConst: 0x8000 is yy2=3 & cc2=3 & bo2=1 { export 0x8000:2; }
AluConst: 0xfffe is yy2=0 & cc2=0 & bo2=3 { export 0xfffe:2; }
AluConst: 0xfffd is yy2=0 & cc2=1 & bo2=3 { export 0xfffd:2; }
AluConst: 0xfffb is yy2=0 & cc2=2 & bo2=3 { export 0xfffb:2; }
AluConst: 0xfff7 is yy2=0 & cc2=3 & bo2=3 { export 0xfff7:2; }
AluConst: 0xffef is yy2=1 & cc2=0 & bo2=3 { export 0xffef:2; }
AluConst: 0xffdf is yy2=1 & cc2=1 & bo2=3 { export 0xffdf:2; }
AluConst: 0xffbf is yy2=1 & cc2=2 & bo2=3 { export 0xffbf:2; }
AluConst: 0xff7f is yy2=1 & cc2=3 & bo2=3 { export 0xff7f:2; }

# -----------------------------------------------------------------------------

:"MR = MR +" MACX "*" MACY "(SU)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=9 & MACX & MACY & DReg4 & DReg
{
    local moved:2=DReg; local x:8=sext(MACX); local y:8=zext(MACY); local prod:8=x*y;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=moved;
}

# Type 9: unconditional ALU/MAC forms present in srvdsp.
# -----------------------------------------------------------------------------

:AR "=" ALUY "- 1" is type9=4 & z18=0 & amf5=24 & ALUY & mid4=0 & cond4=15
{
    local old:2 = ALUY;
    AR = old - 1;
    alu_flags_sub(old, 1:2, AR);
}

:AR "=" ALUX "-" ALUY is type9=4 & z18=0 & amf5=23 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AR = oldx - oldy;
    alu_flags_sub(oldx, oldy, AR);
}

:AF "=" ALUX "+" ALUY is type9=4 & z18=1 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AF = oldx + oldy;
    alu_flags_add(oldx, oldy, AF);
}

:AR "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AR = oldx + oldy;
    alu_flags_add(oldx, oldy, AR);
}

:AR "=" "ABS" ALUX is type9=4 & z18=0 & amf5=31 & ALUX & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    if (oldx s>= 0) goto <abs_pos>;
    AR = -oldx;
    goto <abs_done>;
<abs_pos>
    AR = oldx;
<abs_done>
    AZF = (AR == 0);
    ANF = (AR s< 0);
    AVF = (oldx == 0x8000);
    ASF = (oldx s< 0);
}

:AF "=" "ABS" ALUX is type9=4 & z18=1 & amf5=31 & ALUX & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    if (oldx s>= 0) goto <absf_pos>;
    AF = -oldx;
    goto <absf_done>;
<absf_pos>
    AF = oldx;
<absf_done>
    AZF = (AF == 0);
    ANF = (AF s< 0);
    AVF = (oldx == 0x8000);
    ASF = (oldx s< 0);
}

:AR "=" ALUX "XOR" ALUY is type9=4 & z18=0 & amf5=30 & ALUX & ALUY & mid4=0 & cond4=15
{
    AR = ALUX ^ ALUY;
    alu_flags_logic(AR);
}


:AF "=" ALUX "-" ALUY is type9=4 & z18=1 & amf5=23 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AF = oldx - oldy;
    alu_flags_sub(oldx, oldy, AF);
}

:AF "=" ALUY "-" ALUX is type9=4 & z18=1 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AF = oldy - oldx;
    alu_flags_sub(oldy, oldx, AF);
}

:MR "=" MACX "*" MACY is type9=4 & z18=0 & amf5=4 & MACX & MACY & mid4=0 & cond4=15
{
    local sx:4 = sext(MACX);
    local sy:4 = sext(MACY);
    local prod:4 = sx * sy;
    MR0 = prod:2;
    MR1 = prod[16,16];
    MR2 = 0;
    MVF = 0;
}

# AUX corpus form: MR = MR + MX0 * 0 (SS).  The multiplier term is exactly
# zero, so MR is unchanged; MV reflects no MAC overflow for the zero addend.
:"MR = MR + MX0 * 0 (SS)" is type9=4 & z18=0 & amf5=8 & xop3=0 & yop2=3 & mid4=0 & cond4=15
{
    MVF = 0;
}

# Type-9 constant forms used by srvdsp (BO=01 => positive power-of-two).
:AR "=" ALUX "+ 1" is type9=4 & z18=0 & amf5=19 & yy2=0 & ALUX & cc2=0 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx + 1;
    alu_flags_add(oldx, 1:2, AR);
}

:AR "=" ALUX "- 1" is type9=4 & z18=0 & amf5=23 & yy2=0 & ALUX & cc2=0 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx - 1;
    alu_flags_sub(oldx, 1:2, AR);
}

:AF "=" ALUX "+ 1" is type9=4 & z18=1 & amf5=19 & yy2=0 & ALUX & cc2=0 & bo2=1 & cond4=15
{
