:"MR = MR -" MACX "*" MACY "(SS)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=12 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=v; DagI=a+m; }
:"MR = MR +" MACX "*" MACY "(RND)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; dsp_mac_acc_round_xy(MACX,MACY); DReg4=v; DagI=a+m; }
:"MR = MR -" MACX "*" MACY "(RND)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=3 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; dsp_mac_sub_round_xy(MACX,MACY); DReg4=v; DagI=a+m; }
:AF "=" ALUX "-" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local x:2=ALUX; local y:2=ALUY; AF=x-y; DReg4=v; DagI=a+m; alu_flags_sub(x,y,AF); }

