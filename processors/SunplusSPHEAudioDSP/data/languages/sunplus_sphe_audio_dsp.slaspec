}
:"IF LT" "AR" "=" ALUX "+" AluConst is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=19 & ALUX & AluConst & cond4=4
{ if(ANF==AVF) goto inst_next; local x:2=ALUX; local c:2=AluConst; AR=x+c; alu_flags_add(x,c,AR); }
:"IF LT" "AR" "=" ALUX "+" AluConst is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=19 & ALUX & AluConst & cond4=4
{ if(ANF==AVF) goto <arch_condition_skipped>; local x:2=ALUX; local c:2=AluConst; AR=x+c; alu_flags_add(x,c,AR);
<arch_condition_skipped>
}
:"IF NOT AV" "AR" "=" ALUX "OR" ALUY is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=29 & ALUX & ALUY & mid4=0 & cond4=7
{ if(AVF!=0) goto inst_next; AR=ALUX|ALUY; alu_flags_logic(AR); }
:"IF NOT AV" "AR" "=" ALUX "OR" ALUY is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=29 & ALUX & ALUY & mid4=0 & cond4=7
{ if(AVF!=0) goto <arch_condition_skipped>; AR=ALUX|ALUY; alu_flags_logic(AR);
<arch_condition_skipped>
}

# -----------------------------------------------------------------------------
# Type 10 flow control.  srvdsp uses NE, GT, LT, and ALWAYS.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Resident PM handoff.
#
# srvdsp is a wrapper image loaded at PM:0x1800. Several terminal/conditional
# jumps hand control to resident DSP firmware below that window. Those bytes are
# not present in srvdsp.bin, so model the handoff as an opaque userop rather than
# inventing resident instructions or making the decompiler chase unmapped PM.
# The numeric target remains explicit in P-code/C output.
# -----------------------------------------------------------------------------



macro resident_tail(target) {
    dsp_resident_tailcall(target);
    return [PCSTACKTOP];
}

# Unconditional resident targets observed in the srvdsp corpus.
:JUMP_RESIDENT_00E0 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x00e0 & cond4=15 { resident_tail(0x00e0:2); }
:JUMP_RESIDENT_0036 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0036 & cond4=15 { resident_tail(0x0036:2); }
:JUMP_RESIDENT_0539 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0539 & cond4=15 { resident_tail(0x0539:2); }
:JUMP_RESIDENT_05A4 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x05a4 & cond4=15 { resident_tail(0x05a4:2); }
:JUMP_RESIDENT_08ED is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x08ed & cond4=15 { resident_tail(0x08ed:2); }
:JUMP_RESIDENT_0EBB is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0ebb & cond4=15 { resident_tail(0x0ebb:2); }
:JUMP_RESIDENT_04BC is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x04bc & cond4=15 { resident_tail(0x04bc:2); }
:JUMP_RESIDENT_092C is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x092c & cond4=15 { resident_tail(0x092c:2); }
:JUMP_RESIDENT_0398 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0398 & cond4=15 { resident_tail(0x0398:2); }
:JUMP_RESIDENT_10C5 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x10c5 & cond4=15 { resident_tail(0x10c5:2); }
:JUMP_RESIDENT_0231 is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0231 & cond4=15 { resident_tail(0x0231:2); }

# Conditional resident handoffs used by srvdsp.
:"IF GT JUMP_RESIDENT_0539" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0539 & cond4=2
{
    local gt:1 = (AZF == 0) && (ANF == AVF);
    if (gt == 0) goto inst_next;
    resident_tail(0x0539:2);
}

:"IF LT JUMP_RESIDENT_0539" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0539 & cond4=4
{
    if (ANF == AVF) goto inst_next;
    resident_tail(0x0539:2);
}

:"IF NE JUMP_RESIDENT_0D04" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0d04 & cond4=1
{
    if (AZF != 0) goto inst_next;
    resident_tail(0x0d04:2);
}

:JUMP JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=15 & JumpAddr
{
    goto JumpAddr;
}

:CALL JumpAddr is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & type10=3 & call18=1 & cond4=15 & JumpAddr
{
    codec_call_push(inst_next / 3);
    call JumpAddr;
}

:CALL JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=1 & cond4=15 & JumpAddr
{
    call JumpAddr;
}

:"IF EQ JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=0 & JumpAddr
{
    if (AZF != 0) goto JumpAddr;
}

# Static-flow opt-in: all inputs to the native conditional predicate are
# exactly proven false on every reachable entry.  No jump edge exists.
:"IF NE JUMP" JumpAddr is codec_arch_stack_mode=0 & codec_branch_proven_not_taken=1 & type10=3 & call18=0 & cond4=1 & JumpAddr
{
}

:"IF NE JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=1 & JumpAddr
{
    if (AZF == 0) goto JumpAddr;
}

:"IF GT JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=2 & JumpAddr
{
    if (AZF != 0) goto <gt_fallthrough>;
    if (ANF == AVF) goto JumpAddr;
<gt_fallthrough>
}



# Opt-in only when a bounded native predecessor chain makes LE definitively
# true for all incoming states. Other IF LE sites keep their original flags.
:"IF LE JUMP" JumpAddr is codec_arch_stack_mode=0 & codec_le_proven_taken=1 & type10=3 & call18=0 & cond4=3 & JumpAddr
{
    goto JumpAddr;
}

# Scope to an independently proven constant-false LE at this native site.
:"IF LE JUMP" JumpAddr is codec_arch_stack_mode=0 & codec_branch_proven_not_taken=1 & type10=3 & call18=0 & cond4=3 & JumpAddr
{
}

:"IF LE JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=3 & JumpAddr
{
    local le:1 = (AZF != 0) || (ANF != AVF);
    if (le != 0) goto JumpAddr;
}

:"IF NE CALL" JumpAddr is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & type10=3 & call18=1 & cond4=1 & JumpAddr
{
    if (AZF != 0) goto inst_next;
    codec_call_push(inst_next / 3);
    call JumpAddr;
}

:"IF NE CALL" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=1 & cond4=1 & JumpAddr
{
    if (AZF != 0) goto inst_next;
    call JumpAddr;
}

:"IF LT JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=4 & JumpAddr
{
    if (ANF != AVF) goto JumpAddr;
}

:"IF NEG JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=10 & JumpAddr
{
    if (ASF != 0) goto JumpAddr;
}

:"IF POS JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=11 & JumpAddr
{
    if (ASF == 0) goto JumpAddr;
}

:"IF GE JUMP" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=0 & cond4=5 & JumpAddr
{
    if (ANF == AVF) goto JumpAddr;
}

:"IF GT CALL" JumpAddr is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & type10=3 & call18=1 & cond4=2 & JumpAddr
{
    if(AZF!=0) goto inst_next;
    if(ANF!=AVF) goto inst_next;
    codec_call_push(inst_next / 3);
    call JumpAddr;
}

:"IF GT CALL" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=1 & cond4=2 & JumpAddr
{
    if(AZF!=0) goto inst_next;
    if(ANF!=AVF) goto inst_next;
    call JumpAddr;
}

:"IF LT CALL" JumpAddr is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & type10=3 & call18=1 & cond4=4 & JumpAddr
{
    if (ANF == AVF) goto inst_next;
    codec_call_push(inst_next / 3);
    call JumpAddr;
}

:"IF LT CALL" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=1 & cond4=4 & JumpAddr
{
    if (ANF == AVF) goto inst_next;
    call JumpAddr;
}

:"IF EQ CALL" JumpAddr is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & type10=3 & call18=1 & cond4=0 & JumpAddr
{
    if (AZF == 0) goto inst_next;
    codec_call_push(inst_next / 3);
    call JumpAddr;
}

:"IF EQ CALL" JumpAddr is codec_arch_stack_mode=0 & type10=3 & call18=1 & cond4=0 & JumpAddr
{
    if (AZF == 0) goto inst_next;
    call JumpAddr;
}

# -----------------------------------------------------------------------------
# Type 11 zero-overhead loop setup.
#
# The canonical srvdsp corpus contains one proven CE loop:
#   DO PM:186C UNTIL CE
# followed by the single loop-body/end instruction at PM:186C. Mark that
# instruction with decode context. Its specialized DMWRITE constructor above
# emits the CNTR decrement/back-edge, allowing the behavior engine to recover
# a real loop instead of an opaque userop. Other DO targets intentionally stay
# unsupported until observed in corpus.
# -----------------------------------------------------------------------------


:"DO" LoopAddr "UNTIL CE" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=0 & type11=5 & term4=14 & LoopAddr
    [ codec_ce_loop_end=1; globalset(LoopAddr, codec_ce_loop_end); ]
{
    DSP_LOOP_START_SHADOW = DSP_LOOP_START;
    DSP_LOOP_COUNT_SHADOW = CNTR;
    DSP_LOOP_START = inst_next / 3;
}

# EXPERIMENT: depth known per native instruction, so no runtime stack switch.
:"DO" LoopAddr "UNTIL CE" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=1 & codec_ce_static_depth=1 & type11=5 & term4=14 & LoopAddr
    [ codec_ce_loop_end=1; globalset(LoopAddr, codec_ce_loop_end); ]
{
    DSP_STATIC_START_OUTER = inst_next / 3;
}
:"DO" LoopAddr "UNTIL CE" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=1 & codec_ce_static_depth=2 & type11=5 & term4=14 & LoopAddr
    [ codec_ce_loop_end=1; globalset(LoopAddr, codec_ce_loop_end); ]
{
    DSP_STATIC_START_INNER = inst_next / 3;
}

:"DO" LoopAddr "UNTIL CE" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=0 & codec_ce_nested_mode=1 & type11=5 & term4=14 & LoopAddr
    [ codec_ce_loop_end=1; globalset(LoopAddr, codec_ce_loop_end); ]
{
    local start:2 = inst_next / 3; # PM addresses are 24-bit instruction words
    if (DSP_LOOP_DEPTH == 0) goto <do_first>;
    if (DSP_LOOP_DEPTH == 1) goto <do_second>;
    if (DSP_LOOP_DEPTH == 2) goto <do_third>;
    if (DSP_LOOP_DEPTH == 3) goto <do_fourth>;
    goto <do_done>; # stack full: DO acts as no-op; overflow status not modeled
<do_first> DSP_LOOP_DEPTH = 1; goto <do_start>;
<do_second> DSP_LOOP_START_SHADOW = DSP_LOOP_START; DSP_LOOP_DEPTH = 2; goto <do_start>;
<do_third> DSP_LOOP_START_SHADOW2 = DSP_LOOP_START; DSP_LOOP_DEPTH = 3; goto <do_start>;
<do_fourth> DSP_LOOP_START_SHADOW3 = DSP_LOOP_START; DSP_LOOP_DEPTH = 4;
<do_start> DSP_LOOP_START = start;
<do_done>
}

:"DO" LoopAddr "UNTIL CE" is codec_arch_stack_mode=0 & srvdsp_wrapper_mode=1 & type11=5 & loop14=0x186c & term4=14 & LoopAddr
    [ srvdsp_ce_loop_end=1; globalset(LoopAddr, srvdsp_ce_loop_end); ]
{
}

# -----------------------------------------------------------------------------
# Type 12/13 shift+memory forms reached by codec profiles.
# -----------------------------------------------------------------------------

:SR "=" "ASHIFT" ShiftX "(HI)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=4 & ShiftX & DReg4 & ShiftDagI & ShiftDagM & ShiftDmAddress & ShiftDagL
{
    local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 ShiftDmAddress; local src:4=sext(ShiftX)<<16; local count:2=SE; local res:4=src;
    if (count s<0) goto <t12ahi_r>; res=src<<count; goto <t12ahi_d>;
<t12ahi_r> count=-count; res=src s>>count;
<t12ahi_d> SR0=res:2; SR1=res[16,16]; DReg4=fetched; dsp_dag_postmodify(ShiftDagI, a, m, ShiftDagL);
}
:SR "=" "ASHIFT" ShiftX "(LO)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=6 & ShiftX & DReg4 & ShiftDagI & ShiftDagM & ShiftDmAddress & ShiftDagL
{
    local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 ShiftDmAddress; local src:4=sext(ShiftX); local count:2=SE; local negative:1=count s<0; local mask:4=-zext(negative); local countmask:2=mask:2; local magnitude:2=-count; local leftcount:2=count & ~countmask; local rightcount:2=magnitude & countmask; local leftval:4=src<<leftcount; local rightval:4=src s>>rightcount; local res:4=(leftval & ~mask) | (rightval & mask); SR0=res:2; SR1=res[16,16]; DReg4=fetched; dsp_dag_postmodify(ShiftDagI, a, m, ShiftDagL);
}
:SR "=" "LSHIFT" ShiftX "(LO)," DReg4 "=" "PM(" DagI "," DagM ")" is op8=0x11 & shift_d=0 & sf4=2 & ShiftX & DReg4 & DagI & DagM & DagL
{
    local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local src:4=zext(ShiftX); local count:2=SE; local res:4=src;
    if (count s<0) goto <t13l_r>; res=src<<count; goto <t13l_d>;
<t13l_r> count=-count; res=src>>count;
<t13l_d> SR0=res:2; SR1=res[16,16]; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL);
}


:SR "=" "SR OR LSHIFT" ShiftX "(LO)," DReg4 "=" "PM(" DagI "," DagM ")" is op8=0x11 & shift_d=0 & sf4=3 & ShiftX & DReg4 & DagI & DagM & DagL
{
    local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local src:4=zext(ShiftX); local count:2=SE; local shifted:4=src;
    if(count s<0) goto <final_t13or_r>; shifted=src<<count; goto <final_t13or_d>;
<final_t13or_r> count=-count; shifted=src>>count;
<final_t13or_d> local old:4=(zext(SR1)<<16)|zext(SR0); local res:4=old|shifted; SR0=res:2; SR1=res[16,16]; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL);
}

# Immediate logical shift OR forms: split by the encoded sign to avoid
# a synthetic impossible C branch on a constant immediate value.
:SR "=" "SR OR LSHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=1 & sexp_sign=0 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX) << 16;
    local count:1 = sexp8;
    local shifted:4 = src << count;
    local old:4 = (zext(SR1) << 16) | zext(SR0);
    local value:4 = old | shifted;
    SR0 = value:2;
    SR1 = value[16,16];
}

:SR "=" "SR OR LSHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=1 & sexp_sign=1 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX) << 16;
    local count:1 = -sexp8;
    local shifted:4 = src >> count;
    local old:4 = (zext(SR1) << 16) | zext(SR0);
    local value:4 = old | shifted;
    SR0 = value:2;
    SR1 = value[16,16];
}

:SR "=" "SR OR LSHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=3 & sexp_sign=0 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX);
    local count:1 = sexp8;
    local shifted:4 = src << count;
    local old:4 = (zext(SR1) << 16) | zext(SR0);
    local value:4 = old | shifted;
    SR0 = value:2;
    SR1 = value[16,16];
}

:SR "=" "SR OR LSHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=3 & sexp_sign=1 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX);
    local count:1 = -sexp8;
    local shifted:4 = src >> count;
    local old:4 = (zext(SR1) << 16) | zext(SR0);
    local value:4 = old | shifted;
    SR0 = value:2;
    SR1 = value[16,16];
}

# EXP(HI) is reference-identified; detailed SE/SS semantics remain explicit.
:"EXP(HI)" ShiftX is op8=0x0e & sf4=12 & ShiftX & mid4=0 & cond4=15
{ dsp_exp_hi(ShiftX); }

# Type 19 unconditional indirect flow. The observed corpus uses I4-I7.
:"JUMP (" JumpI ")" is codec_arch_stack_mode=0 & op8=0x0b & ind_s=0 & cond4=15 & JumpI
{ goto [JumpI]; }
:"CALL (" JumpI ")" is codec_arch_stack_mode=0 & op8=0x0b & ind_s=1 & cond4=15 & JumpI
{ call [JumpI]; }

# -----------------------------------------------------------------------------
# Bounded adjacent-LDI-SE source-verified Type16 bare LSHIFT(LO).
# Generic signed-count LSHIFT remains default elsewhere.
:SR "=" "LSHIFT" ShiftX "(LO)" is codec_se_proven_negative=1 & codec_se_proven_nonnegative=0 & op8=0x0e & sf4=2 & ShiftX & mid4=0 & cond4=15
{
 local src:4=zext(ShiftX);
 local magnitude:2=-SE;
 local output:4=src >> magnitude;
 SR0=output:2; SR1=output[16,16];
}
:SR "=" "LSHIFT" ShiftX "(LO)" is codec_se_proven_nonnegative=1 & codec_se_proven_negative=0 & op8=0x0e & sf4=2 & ShiftX & mid4=0 & cond4=15
{
 local src:4=zext(ShiftX);
 local output:4=src << SE;
 SR0=output:2; SR1=output[16,16];
}

# Type 14/16 codec-profile shifter forms.  Non-immediate shifts use SE.
# These are limited to the LO variants exercised in the current corpus.
# -----------------------------------------------------------------------------

:SR "=" "LSHIFT" ShiftX "(LO)," DReg4 "=" DReg is op8=0x10 & sf4=2 & ShiftX & DReg4 & DReg
{
    local src:4 = zext(ShiftX);
    local moved:2 = DReg;
    local count:2 = SE;
    local negative:1 = count s< 0;
    local mask:4 = -zext(negative);
    local countmask:2 = mask:2;
    local magnitude:2 = -count;
    local leftcount:2 = count & ~countmask;
    local rightcount:2 = magnitude & countmask;
    local leftval:4 = src << leftcount;
    local rightval:4 = src >> rightcount;
    local res:4 = (leftval & ~mask) | (rightval & mask);
    SR0 = res:2;
    SR1 = res[16,16];
    DReg4 = moved;
}

:SR "=" "LSHIFT" ShiftX "(LO)" is op8=0x0e & sf4=2 & ShiftX & mid4=0 & cond4=15
{
    local src:4 = zext(ShiftX);
    local count:2 = SE;
    local negative:1 = count s< 0;
    local mask:4 = -zext(negative);
    local countmask:2 = mask:2;
    local magnitude:2 = -count;
    local leftcount:2 = count & ~countmask;
    local rightcount:2 = magnitude & countmask;
    local leftval:4 = src << leftcount;
    local rightval:4 = src >> rightcount;
    local res:4 = (leftval & ~mask) | (rightval & mask);
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "SR OR LSHIFT" ShiftX "(LO)" is op8=0x0e & sf4=3 & ShiftX & mid4=0 & cond4=15
{
    local src:4 = zext(ShiftX);
    local count:2 = SE;
    local shifted:4 = src;
    if (count s< 0) goto <t16_or_right>;
    shifted = src << count;
    goto <t16_or_done>;
<t16_or_right>
    count = -count;
    shifted = src >> count;
<t16_or_done>
    local oldsr:4 = (zext(SR1) << 16) | zext(SR0);
    local res:4 = oldsr | shifted;
    SR0 = res:2;
    SR1 = res[16,16];
}

# Scoped branch-free nonnegative SE variants: opt-in ONLY where the
# incoming SE is statically proven >= 0.  Dynamic SE keeps normal semantics.
:SR "=" "ASHIFT" ShiftX "(HI)" is codec_se_proven_nonnegative=1 & op8=0x0e & sf4=4 & ShiftX & mid4=0 & cond4=15
{
    local src:4 = sext(ShiftX) << 16;
    local res:4 = src << SE;
    SR0 = res:2;
    SR1 = res[16,16];
}
:SR "=" "SR OR LSHIFT" ShiftX "(LO)" is codec_se_proven_nonnegative=1 & op8=0x0e & sf4=3 & ShiftX & mid4=0 & cond4=15
{
    local src:4 = zext(ShiftX);
    local shifted:4 = src << SE;
    local oldsr:4 = (zext(SR1) << 16) | zext(SR0);
    local res:4 = oldsr | shifted;
    SR0 = res:2;
    SR1 = res[16,16];
}

# -----------------------------------------------------------------------------
# Type 15 immediate shifter.  srvdsp uses ASHIFT (LO) MR1 BY +4.
# -----------------------------------------------------------------------------

:SR "=" "ASHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=4 & sexp_sign=0 & ShiftX & sexp8
{
    local src:4 = sext(ShiftX) << 16;
    local count:1 = sexp8;
    local res:4 = src << count;
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "ASHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=4 & sexp_sign=1 & ShiftX & sexp8
{
    local src:4 = sext(ShiftX) << 16;
    local count:1 = -sexp8;
    local res:4 = src s>> count;
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "ASHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=6 & sexp_sign=0 & ShiftX & sexp8
{
    local src:4 = sext(ShiftX);
    local count:1 = sexp8;
    local res:4 = src << count;
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "ASHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=6 & sexp_sign=1 & ShiftX & sexp8
{
    local src:4 = sext(ShiftX);
    local count:1 = -sexp8;
    local res:4 = src s>> count;
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "LSHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=0 & sexp_sign=0 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX) << 16;
    local count:1 = sexp8;
    local res:4 = src << count;
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "LSHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=0 & sexp_sign=1 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX) << 16;
    local count:1 = -sexp8;
    local res:4 = src >> count;
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "LSHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=2 & sexp_sign=0 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX);
    local count:1 = sexp8;
    local res:4 = src << count;
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "LSHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=2 & sexp_sign=1 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX);
    local count:1 = -sexp8;
    local res:4 = src >> count;
    SR0 = res:2;
    SR1 = res[16,16];
}


# Type 23/24 division steps. AQF models the architectural AQ quotient bit.
:DIVS DivY "," DivX is op8=0x06 & divs_fixed3=0 & DivY & DivX & sexp8=0
{
    # The dividend upper half is Y; X is the preserved divisor.
    # Reference 4-65: shift the dividend into AF:AY0, append the quotient sign.
    local divisor:2=DivX;
    local upper:2=DivY;
    local oldq:2=AY0;
    AQF=((upper s<0) != (divisor s<0));
    AF=(upper<<1)|(oldq>>15);
    AY0=(oldq<<1)|zext(AQF);
    ASTAT=(ASTAT & 0xffdf)|(zext(AQF)<<5);
}
:DIVQ DivX is op8=0x07 & divq_fixed5=2 & DivX & sexp8=0
{
    local divisor:2=DivX;
    local upper:2=AF;
    local oldq:2=AY0;
    local partial:2=upper;
    # Respect software initialization of the architectural AQ bit as well
    # as the value produced by a preceding DIVS/DIVQ (reference 4-63/4-65).
    if((ASTAT & 0x0020)!=0) goto <divq_add>;
    partial=upper-divisor;
    goto <divq_calc>;
<divq_add> partial=upper+divisor;
<divq_calc>
    local newaq:1=((partial s<0)!=(divisor s<0));
    AF=(partial<<1)|(oldq>>15);
    AY0=(oldq<<1)|zext(newaq==0);
    AQF=newaq;
    ASTAT=(ASTAT & 0xffdf)|(zext(newaq)<<5);
}

# -----------------------------------------------------------------------------
# Type 17 internal data-register move.
# -----------------------------------------------------------------------------

# Opt-in two-level loop counter save before a native Type17 register move
# such as CNTR = AR or CNTR = AY0. Only depth 2 uses the outer frame;
# the generic Type17 move remains unchanged for all other instructions.
:"" IntDst "=" IntSrc is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & codec_ce_static_depth=2 & type17=0x0d0 & dst_rgp=3 & dst_reg=0x5 & IntDst & IntSrc
{
    DSP_STATIC_CNTR_OUTER = CNTR;
    IntDst = IntSrc;
}

:"" IntDst "=" IntSrc is type17=0x0d0 & IntDst & IntSrc
{
    IntDst = IntSrc;
}

# Target-observed mode/interrupt controls.
:DIS_AR_SAT is whole24=0x0c0800 { MSTAT = MSTAT & 0xfff7; }
:ENA_AR_SAT is whole24=0x0c0c00 { MSTAT = MSTAT | 0x0008; }
:ENA_SEC_REG is codec_arch_stack_mode=0 & whole24=0x0c0030 { MSTAT = MSTAT | 0x0001; }
:DIS_SEC_REG is codec_arch_stack_mode=0 & whole24=0x0c0020 { MSTAT = MSTAT & 0xfffe; }
# Mode field BR occupies bits 7:6, not the GO-mode field (bits 3:2).
# Reference A-5 / 4-159. DAG1 indirect-DM output uses dag1_dm_address;
# DAG2, direct DM, PM and index post-updates do not reverse their bits.
:DIS_BIT_REV is whole24=0x0c0080 { MSTAT = MSTAT & 0xfffd; }
:ENA_BIT_REV is whole24=0x0c00c0 { MSTAT = MSTAT | 0x0002; }
:DIS_G_MODE is whole24=0x0c0008 { MSTAT = MSTAT & 0xffbf; }
:ENA_G_MODE is whole24=0x0c000c { MSTAT = MSTAT | 0x0040; }
:DIS_INTS is codec_arch_stack_mode=0 & whole24=0x040040 { dsp_interrupt_disable(); }
:ENA_INTS is codec_arch_stack_mode=0 & whole24=0x040060 { dsp_interrupt_enable(); }

# Reference-defined mode controls exercised by codec profiles.
:DIS_M_MODE is whole24=0x0c2000 { MSTAT = MSTAT & 0xffef; }
:ENA_M_MODE is whole24=0x0c3000 { MSTAT = MSTAT | 0x0010; }
:DIS_TIMER is whole24=0x0c8000 { MSTAT = MSTAT & 0xffdf; }
:ENA_TIMER is whole24=0x0cc000 { MSTAT = MSTAT | 0x0020; }

# Type 21 MODIFY.  Circular-buffer modulus details are not represented by the
# current register-only model; this matches the linear/post-modify behavior
# already used by the modeled DAG memory-access forms.
:"MODIFY(" ModI "," ModM ")" is op8=0x09 & mod_zero11=0 & ModI & ModM & ModL
{
    dsp_dag_postmodify(ModI, ModI, ModM, ModL);
}

# Type 26 exact stack-control word observed in AC-3: POP every architected
# stack class.  Stack backing stores are not modeled, so preserve each effect
# explicitly rather than pretending the pops are no-ops.
:"POP STS, POP CNTR, POP PC, POP LOOP" is codec_arch_stack_mode=0 & whole24=0x04001f
{
    dsp_pop_status_stack();
    dsp_pop_counter_stack();
    dsp_pop_pc_stack();
    dsp_pop_loop_stack();
}

# -----------------------------------------------------------------------------
# Type 20 returns used by srvdsp.
# -----------------------------------------------------------------------------

:RTS is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & ret19=0x5000 & rettype=0 & cond4=15
{
    codec_call_return();
}

:RTS is codec_arch_stack_mode=0 & ret19=0x5000 & rettype=0 & cond4=15
{
    return [PCSTACKTOP];
}

:RTI is codec_arch_stack_mode=0 & ret19=0x5000 & rettype=1 & cond4=15
{
    dsp_rti_restore_status();
    return [PCSTACKTOP];
}

:"IF EQ RTS" is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & ret19=0x5000 & rettype=0 & cond4=0
{
    if (AZF == 0) goto inst_next;
    codec_call_return();
}

:"IF EQ RTS" is codec_arch_stack_mode=0 & ret19=0x5000 & rettype=0 & cond4=0
{
    if (AZF == 0) goto inst_next;
    return [PCSTACKTOP];
}

:"IF GT RTS" is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & ret19=0x5000 & rettype=0 & cond4=2
{
    if (AZF != 0) goto inst_next;
    if (ANF != AVF) goto inst_next;
    codec_call_return();
}

:"IF GT RTS" is codec_arch_stack_mode=0 & ret19=0x5000 & rettype=0 & cond4=2
{
    if (AZF != 0) goto inst_next;
    if (ANF != AVF) goto inst_next;
    return [PCSTACKTOP];
}

:"IF LT RTS" is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & ret19=0x5000 & rettype=0 & cond4=4
{
    if (ANF == AVF) goto inst_next;
    codec_call_return();
}

:"IF LT RTS" is codec_arch_stack_mode=0 & ret19=0x5000 & rettype=0 & cond4=4
{
    if (ANF == AVF) goto inst_next;
    return [PCSTACKTOP];
}

:"IF NE RTS" is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & ret19=0x5000 & rettype=0 & cond4=1
{
    if (AZF != 0) goto inst_next;
    codec_call_return();
}

:"IF NE RTS" is codec_arch_stack_mode=0 & ret19=0x5000 & rettype=0 & cond4=1
{
    if (AZF != 0) goto inst_next;
    return [PCSTACKTOP];
}

:"IF GE RTS" is codec_arch_stack_mode=0 & codec_ce_nested_mode=1 & ret19=0x5000 & rettype=0 & cond4=5
{
    if (ANF != AVF) goto inst_next;
    codec_call_return();
}

:"IF GE RTS" is codec_arch_stack_mode=0 & ret19=0x5000 & rettype=0 & cond4=5
{
    if (ANF != AVF) goto inst_next;
    return [PCSTACKTOP];
}


# Exact core-control forms observed in codec profiles. Detailed architectural
# side effects remain explicit userops until the full MR/status model is present.
:SAT_MR is whole24=0x050000 { dsp_saturate_mr(); }
:IDLE is whole24=0x028000 { dsp_idle(); }

# -----------------------------------------------------------------------------
# Type 29 I/O-space read/write.
# -----------------------------------------------------------------------------

:IOWRITE ioaddr, IODReg is type29=1 & iodir=1 & ioaddr & IODReg
{
    local a:2 = ioaddr;
    *[IO]:2 a = IODReg;
}

:IOREAD IODReg, ioaddr is type29=1 & iodir=0 & ioaddr & IODReg
{
    local a:2 = ioaddr;
    IODReg = *[IO]:2 a;
}

:NOP is whole24=0x000000
{
}

@include "sunplus_stack_instructions.sinc"

} # end generic codec loop instruction layer
