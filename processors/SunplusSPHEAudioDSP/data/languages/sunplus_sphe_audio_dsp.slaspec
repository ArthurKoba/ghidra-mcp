{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; dsp_mac_sub_round_xy(MACX,MACY); *[DM]:2 a=stored; DagI=a+m; }
:"MR =" MACX "*" MACY "(SS)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <deep_t4ss_d>; MR2=0xffff; <deep_t4ss_d> *[DM]:2 a=stored; DagI=a+m; MVF=0; }
