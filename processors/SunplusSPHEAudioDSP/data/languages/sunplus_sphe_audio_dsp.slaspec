# Sunplus SPHE audio DSP
#
# The recovered target uses fixed 24-bit program words whose currently proven
# instruction forms match ADSP-218x encodings. Keep target-specific behavior
# explicit instead of silently inheriting unproved ADSP-218x integration
# details.

define endian=big;
define alignment=3;

# PM is addressed in 24-bit instruction words. DM is modeled with the
# standard ADSP-218x 16-bit word width for the instruction forms implemented
# here; Sunplus-specific wider service values are not asserted by this model.
define space PM       type=ram_space      size=2 wordsize=3 default;
define space DM       type=ram_space      size=2 wordsize=2;
define space IO       type=ram_space      size=2 wordsize=2;
define space register type=register_space size=2;

define register offset=0x000 size=2 [
    AX0 AX1 MX0 MX1 AY0 AY1 MY0 MY1
    SI SE AR MR0 MR1 MR2 SR0 SR1
];

define register offset=0x040 size=2 [
    I0 I1 I2 I3 I4 I5 I6 I7
    M0 M1 M2 M3 M4 M5 M6 M7
    L0 L1 L2 L3 L4 L5 L6 L7
];

define register offset=0x080 size=2 [
    ASTAT MSTAT SSTAT IMASK ICNTL CNTR SB PX
    RX0 TX0 RX1 TX1 IFC OWRCNTR PMOVLAY DMOVLAY
];

define register offset=0x020 size=2 [ AF MF ];
define register offset=0x0c0 size=2 [ PC PCSTACKTOP SP ];
# Internal condition latches used by the SLEIGH model.  srvdsp does not
# directly write ASTAT, so keeping the predicates explicit produces stable
# P-code while ASTAT remains available as the architectural register.
define register offset=0x0d0 size=1 [ AZF ANF AVF ACF MVF CEF AQF ASF ];
# Decoder-only context used for the proven srvdsp single-instruction
# DO ... UNTIL CE loop. This is not an architectural DSP register.
define register offset=0x0e0 size=4 [ DSPCTX ];

# RTI restores architectural status-stack state in addition to the saved PC.
# The detailed status-stack storage is not yet modeled; keep that side effect
# explicit instead of aliasing RTI to RTS.
define pcodeop dsp_rti_restore_status;
define pcodeop dsp_interrupt_disable;
define pcodeop dsp_interrupt_enable;
define pcodeop dsp_saturate_mr;
define pcodeop dsp_idle;
define pcodeop dsp_do_until_ce;
define pcodeop dsp_pop_status_stack;
define pcodeop dsp_pop_counter_stack;
define pcodeop dsp_pop_pc_stack;
define pcodeop dsp_pop_loop_stack;
define pcodeop dsp_mac_round_xy;
define pcodeop dsp_mac_acc_round_xy;
define pcodeop dsp_mac_sub_round_xy;
define pcodeop dsp_mac_round_mf_xy;
define pcodeop dsp_exp_hi;
define context DSPCTX
    srvdsp_ce_loop_end=(0,0) noflow
    srvdsp_wrapper_mode=(1,1) noflow
;

define token inst24(24) endian = big
    whole24 = (0,23)

    # Type 3 / 6 / 7 common direct/immediate fields.
    type3   = (21,23)
    dir20   = (20,20)
    rgp     = (18,19)
    addr14  = (4,17)
    reg4    = (0,3)
    op4     = (20,23)
    imm16   = (4,19)
    data14  = (4,17)
    dreg4   = (0,3)

    # Type 4 / 9 ALU-MAC fields.
    g20     = (20,20)
    d19     = (19,19)
    z18     = (18,18)
    amf5    = (13,17)
    yop2    = (11,12)
    xop3    = (8,10)
    t4_dreg = (4,7)
    dag_i2  = (2,3)
    dag_m2  = (0,1)
    type9   = (19,23)
    mid4    = (4,7)
    yy2     = (11,12)
    cc2     = (6,7)
    bo2     = (4,5)

    # Type 10 / 11 flow fields.
    type10  = (19,23)
    call18  = (18,18)
    cond4   = (0,3)
    type11  = (18,23)
    loop14  = (4,17)
    term4   = (0,3)

    # Type 15 immediate shifter.
    type15  = (15,23)
    sf4     = (11,14)
    shx3    = (8,10)
    sexp8   = (0,7) signed
    divq_fixed5 = (11,15)
    divs_fixed3 = (13,15)

    # Type 17 internal register move.
    type17  = (12,23)
    dst_rgp = (10,11)
    src_rgp = (8,9)
    dst_reg = (4,7)
    src_reg = (0,3)


    # Type 14/16 shifter and Type 21 address-modify fields.
    op8     = (16,23)
    mod_g   = (4,4)
    mod_i   = (2,3)
    mod_m   = (0,1)
    mod_zero11 = (5,15)

    # Type 1 dual fetch / Type 2 immediate DM write.
    t1_type = (22,23)
    t1_pd   = (20,21)
    t1_dd   = (18,19)
    t1_pmi  = (6,7)
    t1_pmm  = (4,5)
    t1_dmi  = (2,3)
    t1_dmm  = (0,1)
    t2_data = (4,19)

    # Type 12/13 shifter+memory and Type 19 indirect flow.
    type12  = (17,23)
    shift_g = (16,16)
    shift_d = (15,15)
    ind_i2  = (6,7)
    ind_s   = (4,4)

    # Type 20 conditional return.
    ret19   = (5,23)
    rettype = (4,4)

    # Type 29 I/O-space move.
    type29  = (16,23)
    iodir   = (15,15)
    ioaddr  = (4,14)
    iodreg  = (0,3)
;

DReg: AX0 is dreg4=0x0 & AX0 { export AX0; }
DReg: AX1 is dreg4=0x1 & AX1 { export AX1; }
DReg: MX0 is dreg4=0x2 & MX0 { export MX0; }
DReg: MX1 is dreg4=0x3 & MX1 { export MX1; }
DReg: AY0 is dreg4=0x4 & AY0 { export AY0; }
DReg: AY1 is dreg4=0x5 & AY1 { export AY1; }
DReg: MY0 is dreg4=0x6 & MY0 { export MY0; }
DReg: MY1 is dreg4=0x7 & MY1 { export MY1; }
DReg: SI  is dreg4=0x8 & SI { export SI; }
DReg: SE  is dreg4=0x9 & SE { export SE; }
DReg: AR  is dreg4=0xa & AR { export AR; }
DReg: MR0 is dreg4=0xb & MR0 { export MR0; }
DReg: MR1 is dreg4=0xc & MR1 { export MR1; }
DReg: MR2 is dreg4=0xd & MR2 { export MR2; }
DReg: SR0 is dreg4=0xe & SR0 { export SR0; }
DReg: SR1 is dreg4=0xf & SR1 { export SR1; }

RegSel: AX0 is rgp=0 & reg4=0x0 & AX0 { export AX0; }
RegSel: AX1 is rgp=0 & reg4=0x1 & AX1 { export AX1; }
RegSel: MX0 is rgp=0 & reg4=0x2 & MX0 { export MX0; }
RegSel: MX1 is rgp=0 & reg4=0x3 & MX1 { export MX1; }
RegSel: AY0 is rgp=0 & reg4=0x4 & AY0 { export AY0; }
RegSel: AY1 is rgp=0 & reg4=0x5 & AY1 { export AY1; }
RegSel: MY0 is rgp=0 & reg4=0x6 & MY0 { export MY0; }
RegSel: MY1 is rgp=0 & reg4=0x7 & MY1 { export MY1; }
RegSel: SI  is rgp=0 & reg4=0x8 & SI { export SI; }
RegSel: SE  is rgp=0 & reg4=0x9 & SE { export SE; }
RegSel: AR  is rgp=0 & reg4=0xa & AR { export AR; }
RegSel: MR0 is rgp=0 & reg4=0xb & MR0 { export MR0; }
RegSel: MR1 is rgp=0 & reg4=0xc & MR1 { export MR1; }
RegSel: MR2 is rgp=0 & reg4=0xd & MR2 { export MR2; }
RegSel: SR0 is rgp=0 & reg4=0xe & SR0 { export SR0; }
RegSel: SR1 is rgp=0 & reg4=0xf & SR1 { export SR1; }

RegSel: I0 is rgp=1 & reg4=0x0 & I0 { export I0; }
RegSel: I1 is rgp=1 & reg4=0x1 & I1 { export I1; }
RegSel: I2 is rgp=1 & reg4=0x2 & I2 { export I2; }
RegSel: I3 is rgp=1 & reg4=0x3 & I3 { export I3; }
RegSel: M0 is rgp=1 & reg4=0x4 & M0 { export M0; }
RegSel: M1 is rgp=1 & reg4=0x5 & M1 { export M1; }
RegSel: M2 is rgp=1 & reg4=0x6 & M2 { export M2; }
RegSel: M3 is rgp=1 & reg4=0x7 & M3 { export M3; }
RegSel: L0 is rgp=1 & reg4=0x8 & L0 { export L0; }
RegSel: L1 is rgp=1 & reg4=0x9 & L1 { export L1; }
RegSel: L2 is rgp=1 & reg4=0xa & L2 { export L2; }
RegSel: L3 is rgp=1 & reg4=0xb & L3 { export L3; }
RegSel: PMOVLAY is rgp=1 & reg4=0xe & PMOVLAY { export PMOVLAY; }
RegSel: DMOVLAY is rgp=1 & reg4=0xf & DMOVLAY { export DMOVLAY; }

RegSel: I4 is rgp=2 & reg4=0x0 & I4 { export I4; }
RegSel: I5 is rgp=2 & reg4=0x1 & I5 { export I5; }
RegSel: I6 is rgp=2 & reg4=0x2 & I6 { export I6; }
RegSel: I7 is rgp=2 & reg4=0x3 & I7 { export I7; }
RegSel: M4 is rgp=2 & reg4=0x4 & M4 { export M4; }
RegSel: M5 is rgp=2 & reg4=0x5 & M5 { export M5; }
RegSel: M6 is rgp=2 & reg4=0x6 & M6 { export M6; }
RegSel: M7 is rgp=2 & reg4=0x7 & M7 { export M7; }
RegSel: L4 is rgp=2 & reg4=0x8 & L4 { export L4; }
RegSel: L5 is rgp=2 & reg4=0x9 & L5 { export L5; }
RegSel: L6 is rgp=2 & reg4=0xa & L6 { export L6; }
RegSel: L7 is rgp=2 & reg4=0xb & L7 { export L7; }

RegSel: ASTAT   is rgp=3 & reg4=0x0 & ASTAT { export ASTAT; }
RegSel: MSTAT   is rgp=3 & reg4=0x1 & MSTAT { export MSTAT; }
RegSel: SSTAT   is rgp=3 & reg4=0x2 & SSTAT { export SSTAT; }
RegSel: IMASK   is rgp=3 & reg4=0x3 & IMASK { export IMASK; }
RegSel: ICNTL   is rgp=3 & reg4=0x4 & ICNTL { export ICNTL; }
RegSel: CNTR    is rgp=3 & reg4=0x5 & CNTR { export CNTR; }
RegSel: SB      is rgp=3 & reg4=0x6 & SB { export SB; }
RegSel: PX      is rgp=3 & reg4=0x7 & PX { export PX; }
RegSel: RX0     is rgp=3 & reg4=0x8 & RX0 { export RX0; }
RegSel: TX0     is rgp=3 & reg4=0x9 & TX0 { export TX0; }
RegSel: RX1     is rgp=3 & reg4=0xa & RX1 { export RX1; }
RegSel: TX1     is rgp=3 & reg4=0xb & TX1 { export TX1; }
RegSel: IFC     is rgp=3 & reg4=0xc & IFC { export IFC; }
RegSel: OWRCNTR is rgp=3 & reg4=0xd & OWRCNTR { export OWRCNTR; }

# -----------------------------------------------------------------------------
# Operand subtables used by the srvdsp instruction corpus.
# -----------------------------------------------------------------------------

DReg4: AX0 is t4_dreg=0x0 & AX0 { export AX0; }
DReg4: AX1 is t4_dreg=0x1 & AX1 { export AX1; }
DReg4: MX0 is t4_dreg=0x2 & MX0 { export MX0; }
DReg4: MX1 is t4_dreg=0x3 & MX1 { export MX1; }
DReg4: AY0 is t4_dreg=0x4 & AY0 { export AY0; }
DReg4: AY1 is t4_dreg=0x5 & AY1 { export AY1; }
DReg4: MY0 is t4_dreg=0x6 & MY0 { export MY0; }
DReg4: MY1 is t4_dreg=0x7 & MY1 { export MY1; }
DReg4: SI  is t4_dreg=0x8 & SI  { export SI; }
DReg4: SE  is t4_dreg=0x9 & SE  { export SE; }
DReg4: AR  is t4_dreg=0xa & AR  { export AR; }
DReg4: MR0 is t4_dreg=0xb & MR0 { export MR0; }
DReg4: MR1 is t4_dreg=0xc & MR1 { export MR1; }
DReg4: MR2 is t4_dreg=0xd & MR2 { export MR2; }
DReg4: SR0 is t4_dreg=0xe & SR0 { export SR0; }
DReg4: SR1 is t4_dreg=0xf & SR1 { export SR1; }


# Type-17 register operands. Reserved register codes remain unsupported.
IntDst: AX0 is dst_rgp=0 & dst_reg=0x0 & AX0 { export AX0; }
IntSrc: AX0 is src_rgp=0 & src_reg=0x0 & AX0 { export AX0; }
IntDst: AX1 is dst_rgp=0 & dst_reg=0x1 & AX1 { export AX1; }
IntSrc: AX1 is src_rgp=0 & src_reg=0x1 & AX1 { export AX1; }
IntDst: MX0 is dst_rgp=0 & dst_reg=0x2 & MX0 { export MX0; }
IntSrc: MX0 is src_rgp=0 & src_reg=0x2 & MX0 { export MX0; }
IntDst: MX1 is dst_rgp=0 & dst_reg=0x3 & MX1 { export MX1; }
IntSrc: MX1 is src_rgp=0 & src_reg=0x3 & MX1 { export MX1; }
IntDst: AY0 is dst_rgp=0 & dst_reg=0x4 & AY0 { export AY0; }
IntSrc: AY0 is src_rgp=0 & src_reg=0x4 & AY0 { export AY0; }
IntDst: AY1 is dst_rgp=0 & dst_reg=0x5 & AY1 { export AY1; }
IntSrc: AY1 is src_rgp=0 & src_reg=0x5 & AY1 { export AY1; }
IntDst: MY0 is dst_rgp=0 & dst_reg=0x6 & MY0 { export MY0; }
IntSrc: MY0 is src_rgp=0 & src_reg=0x6 & MY0 { export MY0; }
IntDst: MY1 is dst_rgp=0 & dst_reg=0x7 & MY1 { export MY1; }
IntSrc: MY1 is src_rgp=0 & src_reg=0x7 & MY1 { export MY1; }
IntDst: SI is dst_rgp=0 & dst_reg=0x8 & SI { export SI; }
IntSrc: SI is src_rgp=0 & src_reg=0x8 & SI { export SI; }
IntDst: SE is dst_rgp=0 & dst_reg=0x9 & SE { export SE; }
IntSrc: SE is src_rgp=0 & src_reg=0x9 & SE { export SE; }
IntDst: AR is dst_rgp=0 & dst_reg=0xa & AR { export AR; }
IntSrc: AR is src_rgp=0 & src_reg=0xa & AR { export AR; }
IntDst: MR0 is dst_rgp=0 & dst_reg=0xb & MR0 { export MR0; }
IntSrc: MR0 is src_rgp=0 & src_reg=0xb & MR0 { export MR0; }
IntDst: MR1 is dst_rgp=0 & dst_reg=0xc & MR1 { export MR1; }
IntSrc: MR1 is src_rgp=0 & src_reg=0xc & MR1 { export MR1; }
IntDst: MR2 is dst_rgp=0 & dst_reg=0xd & MR2 { export MR2; }
IntSrc: MR2 is src_rgp=0 & src_reg=0xd & MR2 { export MR2; }
IntDst: SR0 is dst_rgp=0 & dst_reg=0xe & SR0 { export SR0; }
IntSrc: SR0 is src_rgp=0 & src_reg=0xe & SR0 { export SR0; }
IntDst: SR1 is dst_rgp=0 & dst_reg=0xf & SR1 { export SR1; }
IntSrc: SR1 is src_rgp=0 & src_reg=0xf & SR1 { export SR1; }
IntDst: I0 is dst_rgp=1 & dst_reg=0x0 & I0 { export I0; }
IntSrc: I0 is src_rgp=1 & src_reg=0x0 & I0 { export I0; }
IntDst: I1 is dst_rgp=1 & dst_reg=0x1 & I1 { export I1; }
IntSrc: I1 is src_rgp=1 & src_reg=0x1 & I1 { export I1; }
IntDst: I2 is dst_rgp=1 & dst_reg=0x2 & I2 { export I2; }
IntSrc: I2 is src_rgp=1 & src_reg=0x2 & I2 { export I2; }
IntDst: I3 is dst_rgp=1 & dst_reg=0x3 & I3 { export I3; }
IntSrc: I3 is src_rgp=1 & src_reg=0x3 & I3 { export I3; }
IntDst: M0 is dst_rgp=1 & dst_reg=0x4 & M0 { export M0; }
IntSrc: M0 is src_rgp=1 & src_reg=0x4 & M0 { export M0; }
IntDst: M1 is dst_rgp=1 & dst_reg=0x5 & M1 { export M1; }
IntSrc: M1 is src_rgp=1 & src_reg=0x5 & M1 { export M1; }
IntDst: M2 is dst_rgp=1 & dst_reg=0x6 & M2 { export M2; }
IntSrc: M2 is src_rgp=1 & src_reg=0x6 & M2 { export M2; }
IntDst: M3 is dst_rgp=1 & dst_reg=0x7 & M3 { export M3; }
IntSrc: M3 is src_rgp=1 & src_reg=0x7 & M3 { export M3; }
IntDst: L0 is dst_rgp=1 & dst_reg=0x8 & L0 { export L0; }
IntSrc: L0 is src_rgp=1 & src_reg=0x8 & L0 { export L0; }
IntDst: L1 is dst_rgp=1 & dst_reg=0x9 & L1 { export L1; }
IntSrc: L1 is src_rgp=1 & src_reg=0x9 & L1 { export L1; }
IntDst: L2 is dst_rgp=1 & dst_reg=0xa & L2 { export L2; }
IntSrc: L2 is src_rgp=1 & src_reg=0xa & L2 { export L2; }
IntDst: L3 is dst_rgp=1 & dst_reg=0xb & L3 { export L3; }
IntSrc: L3 is src_rgp=1 & src_reg=0xb & L3 { export L3; }
IntDst: PMOVLAY is dst_rgp=1 & dst_reg=0xe & PMOVLAY { export PMOVLAY; }
IntSrc: PMOVLAY is src_rgp=1 & src_reg=0xe & PMOVLAY { export PMOVLAY; }
IntDst: DMOVLAY is dst_rgp=1 & dst_reg=0xf & DMOVLAY { export DMOVLAY; }
IntSrc: DMOVLAY is src_rgp=1 & src_reg=0xf & DMOVLAY { export DMOVLAY; }
IntDst: I4 is dst_rgp=2 & dst_reg=0x0 & I4 { export I4; }
IntSrc: I4 is src_rgp=2 & src_reg=0x0 & I4 { export I4; }
IntDst: I5 is dst_rgp=2 & dst_reg=0x1 & I5 { export I5; }
IntSrc: I5 is src_rgp=2 & src_reg=0x1 & I5 { export I5; }
IntDst: I6 is dst_rgp=2 & dst_reg=0x2 & I6 { export I6; }
IntSrc: I6 is src_rgp=2 & src_reg=0x2 & I6 { export I6; }
IntDst: I7 is dst_rgp=2 & dst_reg=0x3 & I7 { export I7; }
IntSrc: I7 is src_rgp=2 & src_reg=0x3 & I7 { export I7; }
IntDst: M4 is dst_rgp=2 & dst_reg=0x4 & M4 { export M4; }
IntSrc: M4 is src_rgp=2 & src_reg=0x4 & M4 { export M4; }
IntDst: M5 is dst_rgp=2 & dst_reg=0x5 & M5 { export M5; }
IntSrc: M5 is src_rgp=2 & src_reg=0x5 & M5 { export M5; }
IntDst: M6 is dst_rgp=2 & dst_reg=0x6 & M6 { export M6; }
IntSrc: M6 is src_rgp=2 & src_reg=0x6 & M6 { export M6; }
IntDst: M7 is dst_rgp=2 & dst_reg=0x7 & M7 { export M7; }
IntSrc: M7 is src_rgp=2 & src_reg=0x7 & M7 { export M7; }
IntDst: L4 is dst_rgp=2 & dst_reg=0x8 & L4 { export L4; }
IntSrc: L4 is src_rgp=2 & src_reg=0x8 & L4 { export L4; }
IntDst: L5 is dst_rgp=2 & dst_reg=0x9 & L5 { export L5; }
IntSrc: L5 is src_rgp=2 & src_reg=0x9 & L5 { export L5; }
IntDst: L6 is dst_rgp=2 & dst_reg=0xa & L6 { export L6; }
IntSrc: L6 is src_rgp=2 & src_reg=0xa & L6 { export L6; }
IntDst: L7 is dst_rgp=2 & dst_reg=0xb & L7 { export L7; }
IntSrc: L7 is src_rgp=2 & src_reg=0xb & L7 { export L7; }
IntDst: ASTAT is dst_rgp=3 & dst_reg=0x0 & ASTAT { export ASTAT; }
IntSrc: ASTAT is src_rgp=3 & src_reg=0x0 & ASTAT { export ASTAT; }
IntDst: MSTAT is dst_rgp=3 & dst_reg=0x1 & MSTAT { export MSTAT; }
IntSrc: MSTAT is src_rgp=3 & src_reg=0x1 & MSTAT { export MSTAT; }
IntDst: SSTAT is dst_rgp=3 & dst_reg=0x2 & SSTAT { export SSTAT; }
IntSrc: SSTAT is src_rgp=3 & src_reg=0x2 & SSTAT { export SSTAT; }
IntDst: IMASK is dst_rgp=3 & dst_reg=0x3 & IMASK { export IMASK; }
IntSrc: IMASK is src_rgp=3 & src_reg=0x3 & IMASK { export IMASK; }
IntDst: ICNTL is dst_rgp=3 & dst_reg=0x4 & ICNTL { export ICNTL; }
IntSrc: ICNTL is src_rgp=3 & src_reg=0x4 & ICNTL { export ICNTL; }
IntDst: CNTR is dst_rgp=3 & dst_reg=0x5 & CNTR { export CNTR; }
IntSrc: CNTR is src_rgp=3 & src_reg=0x5 & CNTR { export CNTR; }
IntDst: SB is dst_rgp=3 & dst_reg=0x6 & SB { export SB; }
IntSrc: SB is src_rgp=3 & src_reg=0x6 & SB { export SB; }
IntDst: PX is dst_rgp=3 & dst_reg=0x7 & PX { export PX; }
IntSrc: PX is src_rgp=3 & src_reg=0x7 & PX { export PX; }
IntDst: RX0 is dst_rgp=3 & dst_reg=0x8 & RX0 { export RX0; }
IntSrc: RX0 is src_rgp=3 & src_reg=0x8 & RX0 { export RX0; }
IntDst: TX0 is dst_rgp=3 & dst_reg=0x9 & TX0 { export TX0; }
IntSrc: TX0 is src_rgp=3 & src_reg=0x9 & TX0 { export TX0; }
IntDst: RX1 is dst_rgp=3 & dst_reg=0xa & RX1 { export RX1; }
IntSrc: RX1 is src_rgp=3 & src_reg=0xa & RX1 { export RX1; }
IntDst: TX1 is dst_rgp=3 & dst_reg=0xb & TX1 { export TX1; }
IntSrc: TX1 is src_rgp=3 & src_reg=0xb & TX1 { export TX1; }
IntDst: IFC is dst_rgp=3 & dst_reg=0xc & IFC { export IFC; }
IntSrc: IFC is src_rgp=3 & src_reg=0xc & IFC { export IFC; }
IntDst: OWRCNTR is dst_rgp=3 & dst_reg=0xd & OWRCNTR { export OWRCNTR; }
IntSrc: OWRCNTR is src_rgp=3 & src_reg=0xd & OWRCNTR { export OWRCNTR; }

# Type-1 dual-fetch destinations and fixed DAGs.
PDReg: AY0 is t1_pd=0 & AY0 { export AY0; }
PDReg: AY1 is t1_pd=1 & AY1 { export AY1; }
PDReg: MY0 is t1_pd=2 & MY0 { export MY0; }
PDReg: MY1 is t1_pd=3 & MY1 { export MY1; }
DDReg: AX0 is t1_dd=0 & AX0 { export AX0; }
DDReg: AX1 is t1_dd=1 & AX1 { export AX1; }
DDReg: MX0 is t1_dd=2 & MX0 { export MX0; }
DDReg: MX1 is t1_dd=3 & MX1 { export MX1; }
PmI: I4 is t1_pmi=0 & I4 { export I4; }
PmI: I5 is t1_pmi=1 & I5 { export I5; }
PmI: I6 is t1_pmi=2 & I6 { export I6; }
PmI: I7 is t1_pmi=3 & I7 { export I7; }
PmM: M4 is t1_pmm=0 & M4 { export M4; }
PmM: M5 is t1_pmm=1 & M5 { export M5; }
PmM: M6 is t1_pmm=2 & M6 { export M6; }
PmM: M7 is t1_pmm=3 & M7 { export M7; }
DmI: I0 is t1_dmi=0 & I0 { export I0; }
DmI: I1 is t1_dmi=1 & I1 { export I1; }
DmI: I2 is t1_dmi=2 & I2 { export I2; }
DmI: I3 is t1_dmi=3 & I3 { export I3; }
DmM: M0 is t1_dmm=0 & M0 { export M0; }
DmM: M1 is t1_dmm=1 & M1 { export M1; }
DmM: M2 is t1_dmm=2 & M2 { export M2; }
DmM: M3 is t1_dmm=3 & M3 { export M3; }
JumpI: I4 is ind_i2=0 & I4 { export I4; }
JumpI: I5 is ind_i2=1 & I5 { export I5; }
JumpI: I6 is ind_i2=2 & I6 { export I6; }
JumpI: I7 is ind_i2=3 & I7 { export I7; }

IODReg: AX0 is iodreg=0x0 & AX0 { export AX0; }
IODReg: AX1 is iodreg=0x1 & AX1 { export AX1; }
IODReg: MX0 is iodreg=0x2 & MX0 { export MX0; }
IODReg: MX1 is iodreg=0x3 & MX1 { export MX1; }
IODReg: AY0 is iodreg=0x4 & AY0 { export AY0; }
IODReg: AY1 is iodreg=0x5 & AY1 { export AY1; }
IODReg: MY0 is iodreg=0x6 & MY0 { export MY0; }
IODReg: MY1 is iodreg=0x7 & MY1 { export MY1; }
IODReg: SI  is iodreg=0x8 & SI  { export SI; }
IODReg: SE  is iodreg=0x9 & SE  { export SE; }
IODReg: AR  is iodreg=0xa & AR  { export AR; }
IODReg: MR0 is iodreg=0xb & MR0 { export MR0; }
IODReg: MR1 is iodreg=0xc & MR1 { export MR1; }
IODReg: MR2 is iodreg=0xd & MR2 { export MR2; }
IODReg: SR0 is iodreg=0xe & SR0 { export SR0; }
IODReg: SR1 is iodreg=0xf & SR1 { export SR1; }

ALUX: AX0 is xop3=0 & AX0 { export AX0; }
ALUX: AX1 is xop3=1 & AX1 { export AX1; }
ALUX: AR  is xop3=2 & AR  { export AR; }
ALUX: MR0 is xop3=3 & MR0 { export MR0; }
ALUX: MR1 is xop3=4 & MR1 { export MR1; }
ALUX: MR2 is xop3=5 & MR2 { export MR2; }
ALUX: SR0 is xop3=6 & SR0 { export SR0; }
ALUX: SR1 is xop3=7 & SR1 { export SR1; }

ALUY: AY0 is yop2=0 & AY0 { export AY0; }
ALUY: AY1 is yop2=1 & AY1 { export AY1; }
ALUY: AF  is yop2=2 & AF  { export AF; }
ALUY: 0   is yop2=3 { export 0:2; }

MACX: MX0 is xop3=0 & MX0 { export MX0; }
MACX: MX1 is xop3=1 & MX1 { export MX1; }
MACX: AR  is xop3=2 & AR  { export AR; }
MACX: MR0 is xop3=3 & MR0 { export MR0; }
MACX: MR1 is xop3=4 & MR1 { export MR1; }
MACX: MR2 is xop3=5 & MR2 { export MR2; }
MACX: SR0 is xop3=6 & SR0 { export SR0; }
MACX: SR1 is xop3=7 & SR1 { export SR1; }
MACXSq: MX0 is xop3=0 & MX0 { export MX0; }
MACXSq: MX1 is xop3=1 & MX1 { export MX1; }
MACXSq: AR  is xop3=2 & AR  { export AR; }
MACXSq: MR0 is xop3=3 & MR0 { export MR0; }
MACXSq: MR1 is xop3=4 & MR1 { export MR1; }
MACXSq: MR2 is xop3=5 & MR2 { export MR2; }
MACXSq: SR0 is xop3=6 & SR0 { export SR0; }
MACXSq: SR1 is xop3=7 & SR1 { export SR1; }

MACX2: MX0 is xop3=0 & MX0 { export MX0; }
MACX2: MX1 is xop3=1 & MX1 { export MX1; }
MACX2: AR  is xop3=2 & AR  { export AR; }
MACX2: MR0 is xop3=3 & MR0 { export MR0; }
MACX2: MR1 is xop3=4 & MR1 { export MR1; }
MACX2: MR2 is xop3=5 & MR2 { export MR2; }
MACX2: SR0 is xop3=6 & SR0 { export SR0; }
MACX2: SR1 is xop3=7 & SR1 { export SR1; }

MACY: MY0 is yop2=0 & MY0 { export MY0; }
MACY: MY1 is yop2=1 & MY1 { export MY1; }
MACY: MF  is yop2=2 & MF  { export MF; }
MACY: 0   is yop2=3 { export 0:2; }

ShiftX: SI  is shx3=0 & SI  { export SI; }
ShiftX: AR  is shx3=2 & AR  { export AR; }
ShiftX: MR0 is shx3=3 & MR0 { export MR0; }
ShiftX: MR1 is shx3=4 & MR1 { export MR1; }
ShiftX: MR2 is shx3=5 & MR2 { export MR2; }
ShiftX: SR0 is shx3=6 & SR0 { export SR0; }
ShiftX: SR1 is shx3=7 & SR1 { export SR1; }

DagI: I0 is g20=0 & dag_i2=0 & I0 { export I0; }
DagI: I1 is g20=0 & dag_i2=1 & I1 { export I1; }
DagI: I2 is g20=0 & dag_i2=2 & I2 { export I2; }
DagI: I3 is g20=0 & dag_i2=3 & I3 { export I3; }
DagI: I4 is g20=1 & dag_i2=0 & I4 { export I4; }
DagI: I5 is g20=1 & dag_i2=1 & I5 { export I5; }
DagI: I6 is g20=1 & dag_i2=2 & I6 { export I6; }
DagI: I7 is g20=1 & dag_i2=3 & I7 { export I7; }

DagM: M0 is g20=0 & dag_m2=0 & M0 { export M0; }
DagM: M1 is g20=0 & dag_m2=1 & M1 { export M1; }
DagM: M2 is g20=0 & dag_m2=2 & M2 { export M2; }
DagM: M3 is g20=0 & dag_m2=3 & M3 { export M3; }
DagM: M4 is g20=1 & dag_m2=0 & M4 { export M4; }
DagM: M5 is g20=1 & dag_m2=1 & M5 { export M5; }
DagM: M6 is g20=1 & dag_m2=2 & M6 { export M6; }
DagM: M7 is g20=1 & dag_m2=3 & M7 { export M7; }

ModI: I0 is mod_g=0 & mod_i=0 & I0 { export I0; }
ModI: I1 is mod_g=0 & mod_i=1 & I1 { export I1; }
ModI: I2 is mod_g=0 & mod_i=2 & I2 { export I2; }
ModI: I3 is mod_g=0 & mod_i=3 & I3 { export I3; }
ModI: I4 is mod_g=1 & mod_i=0 & I4 { export I4; }
ModI: I5 is mod_g=1 & mod_i=1 & I5 { export I5; }
ModI: I6 is mod_g=1 & mod_i=2 & I6 { export I6; }
ModI: I7 is mod_g=1 & mod_i=3 & I7 { export I7; }
ModM: M0 is mod_g=0 & mod_m=0 & M0 { export M0; }
ModM: M1 is mod_g=0 & mod_m=1 & M1 { export M1; }
ModM: M2 is mod_g=0 & mod_m=2 & M2 { export M2; }
ModM: M3 is mod_g=0 & mod_m=3 & M3 { export M3; }
ModM: M4 is mod_g=1 & mod_m=0 & M4 { export M4; }
ModM: M5 is mod_g=1 & mod_m=1 & M5 { export M5; }
ModM: M6 is mod_g=1 & mod_m=2 & M6 { export M6; }
ModM: M7 is mod_g=1 & mod_m=3 & M7 { export M7; }

ShiftDagI: I0 is shift_g=0 & dag_i2=0 & I0 { export I0; }
ShiftDagI: I1 is shift_g=0 & dag_i2=1 & I1 { export I1; }
ShiftDagI: I2 is shift_g=0 & dag_i2=2 & I2 { export I2; }
ShiftDagI: I3 is shift_g=0 & dag_i2=3 & I3 { export I3; }
ShiftDagI: I4 is shift_g=1 & dag_i2=0 & I4 { export I4; }
ShiftDagI: I5 is shift_g=1 & dag_i2=1 & I5 { export I5; }
ShiftDagI: I6 is shift_g=1 & dag_i2=2 & I6 { export I6; }
ShiftDagI: I7 is shift_g=1 & dag_i2=3 & I7 { export I7; }
ShiftDagM: M0 is shift_g=0 & dag_m2=0 & M0 { export M0; }
ShiftDagM: M1 is shift_g=0 & dag_m2=1 & M1 { export M1; }
ShiftDagM: M2 is shift_g=0 & dag_m2=2 & M2 { export M2; }
ShiftDagM: M3 is shift_g=0 & dag_m2=3 & M3 { export M3; }
ShiftDagM: M4 is shift_g=1 & dag_m2=0 & M4 { export M4; }
ShiftDagM: M5 is shift_g=1 & dag_m2=1 & M5 { export M5; }
ShiftDagM: M6 is shift_g=1 & dag_m2=2 & M6 { export M6; }
ShiftDagM: M7 is shift_g=1 & dag_m2=3 & M7 { export M7; }


DivX: MR2 is xop3=0 & MR2 { export MR2; }
DivX: AX0 is xop3=1 & AX0 { export AX0; }
DivX: AX1 is xop3=2 & AX1 { export AX1; }
DivX: MR1 is xop3=3 & MR1 { export MR1; }
DivX: AR  is xop3=4 & AR  { export AR; }
DivX: MR0 is xop3=5 & MR0 { export MR0; }
DivX: SR1 is xop3=6 & SR1 { export SR1; }
DivX: SR0 is xop3=7 & SR0 { export SR0; }
DivY: AY1 is yop2=0 & AY1 { export AY1; }
DivY: AF  is yop2=1 & AF  { export AF; }
DivY: SR1 is yop2=2 & SR1 { export SR1; }
DivY: SR0 is yop2=3 & SR0 { export SR0; }

JumpAddr: addr14 is addr14 { export *[PM]:2 addr14; }
LoopAddr: loop14 is loop14 { export *[PM]:2 loop14; }

macro alu_flags_add(a, b, r) {
    AZF = (r == 0);
    ANF = (r s< 0);
    AVF = scarry(a, b);
}

macro alu_flags_sub(a, b, r) {
    AZF = (r == 0);
    ANF = (r s< 0);
    AVF = sborrow(a, b);
}

macro alu_flags_logic(r) {
    AZF = (r == 0);
    ANF = (r s< 0);
    AVF = 0;
}

# -----------------------------------------------------------------------------
# Type 1 dual DM+PM fetch and Type 2 immediate DM write.
# Type-1 reads are parallel/read-first; PM low 8 bits are captured in PX.
# -----------------------------------------------------------------------------

:PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=0 & PDReg & DDReg & PmI & PmM & DmI & DmM
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM;
    local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da;
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm;
}
:"MR =" MACX "*" MACY "(SS)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=4 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da;
    local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; if (prod s>=0) goto <t1ss_sign_done>; MR2=0xffff; <t1ss_sign_done>
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm; MVF=0;
}
:AR "=" ALUX "-" ALUY "," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=23 & ALUX & ALUY & PDReg & DDReg & PmI & PmM & DmI & DmM
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da;
    local x:2=ALUX; local y:2=ALUY; AR=x-y; alu_flags_sub(x,y,AR);
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm;
}

:"DM(" DagI "," DagM ")" "=" t2_data is type3=5 & DagI & DagM & t2_data
{
    local a:2=DagI; *[DM]:2 a=t2_data; DagI=DagI+DagM;
}

# -----------------------------------------------------------------------------
# Type 5 pure Program Memory read/write (AMF=0). PM is 24-bit: reads place
# PMD23..8 in DREG and PMD7..0 in PX; writes combine DREG<<8 with PX[7:0].
# -----------------------------------------------------------------------------

:"" DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=0 & yop2=0 & xop3=0 & DReg4 & DagI & DagM
{
    local a:2 = DagI;
    local word:3 = *[PM]:3 a;
    DReg4 = word[8,16];
    PX = zext(word[0,8]);
    DagI = DagI + DagM;
}

:"PM(" DagI "," DagM ")" "=" DReg4 is op4=5 & d19=1 & z18=0 & amf5=0 & yop2=0 & xop3=0 & DReg4 & DagI & DagM
{
    local a:2 = DagI;
    local hi:3 = zext(DReg4) << 8;
    local lo:3 = zext(PX) & 0xff;
    local word:3 = hi | lo;
    *[PM]:3 a = word;
    DagI = DagI + DagM;
}

# -----------------------------------------------------------------------------
# Direct/immediate moves (Types 3, 6, 7).
# -----------------------------------------------------------------------------

:DMREAD RegSel, addr14 is type3=4 & dir20=0 & RegSel & addr14
{
    local dmaddr:2 = addr14;
    RegSel = *[DM]:2 dmaddr;
}

:DMWRITE addr14, RegSel is type3=4 & dir20=1 & RegSel & addr14
{
    local dmaddr:2 = addr14;
    *[DM]:2 dmaddr = RegSel;
}

:LDI DReg, imm16 is op4=4 & DReg & imm16
{
    DReg = imm16;
}

:LDI RegSel, data14 is op4=3 & RegSel & data14
{
    RegSel = data14;
}

# -----------------------------------------------------------------------------
# Type 4: ALU/MAC with DM read/write.
# srvdsp uses the no-compute DM-write form at PM:186c. The proven DO ...
# UNTIL CE sequence is a single-instruction hardware loop; the DO constructor
# marks that loop-end instruction in decode context so its P-code can expose
# the real CNTR-controlled back edge to the behavior engine.
# -----------------------------------------------------------------------------

:DMWRITE DagI, DagM, DReg4 is srvdsp_ce_loop_end=1 & type3=3 & d19=1 & amf5=0 & DagI & DagM & DReg4
{
    local dmaddr:2 = DagI;
    *[DM]:2 dmaddr = DReg4;
    DagI = DagI + DagM;
    CNTR = CNTR - 1;
    if (CNTR != 0) goto inst_start;
}

:DMWRITE DagI, DagM, DReg4 is srvdsp_ce_loop_end=0 & type3=3 & d19=1 & amf5=0 & DagI & DagM & DReg4
{
    local dmaddr:2 = DagI;
    *[DM]:2 dmaddr = DReg4;
    DagI = DagI + DagM;
}

:DMREAD DReg4, DagI, DagM is type3=3 & d19=0 & amf5=0 & DagI & DagM & DReg4
{
    local dmaddr:2 = DagI;
    DReg4 = *[DM]:2 dmaddr;
    DagI = DagI + DagM;
}

# Corpus-proven Type-4 ALU + DM-read multifunction forms.  All source values
# are sampled before result/register/pointer writes, matching parallel DSP
# semantics.
:AR "=" ALUX "+" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local a:2 = DagI;
    local m:2 = DagM;
    local fetched:2 = *[DM]:2 a;
    local r:2 = x + y;
    AR = r;
    DReg4 = fetched;
    DagI = a + m;
    alu_flags_add(x, y, r);
}

:AR "=" ALUY "- 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=24 & ALUY & DReg4 & DagI & DagM
{
    local y:2 = ALUY;
    local a:2 = DagI;
    local m:2 = DagM;
    local fetched:2 = *[DM]:2 a;
    local r:2 = y - 1;
    AR = r;
    DReg4 = fetched;
    DagI = a + m;
    alu_flags_sub(y, 1:2, r);
}

# -----------------------------------------------------------------------------
# Type 8 codec-profile forms.
#
# Low byte 0xAA is the ISA's NONE=<ALU> status-only encoding (Table A-9),
# not a self-move.  It updates ASTAT predicates while preserving AR/AF.
# General Type-8 arithmetic+move forms are parallel/read-first: snapshot all
# sources before writing either result.  The ISA declares dual-destination
# conflicts unsupported, so no ordering is invented for illegal encodings.
# -----------------------------------------------------------------------------

:NONE "=" ALUX "+" ALUY is type9=5 & z18=0 & amf5=19 & ALUX & ALUY & t4_dreg=0xa & dreg4=0xa
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local r:2 = x + y;
    alu_flags_add(x, y, r);
}

:NONE "=" ALUX "-" ALUY is type9=5 & z18=0 & amf5=23 & ALUX & ALUY & t4_dreg=0xa & dreg4=0xa
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local r:2 = x - y;
    alu_flags_sub(x, y, r);
}

:AR "=" ALUX "+" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x + y;
    AR = r;
    DReg4 = moved;
    alu_flags_add(x, y, r);
}

:AF "=" ALUX "+" ALUY "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x + y;
    AF = r;
    DReg4 = moved;
    alu_flags_add(x, y, r);
}

:AR "=" ALUX "-" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x - y;
    AR = r;
    DReg4 = moved;
    alu_flags_sub(x, y, r);
}

:AF "=" ALUX "-" ALUY "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=23 & ALUX & ALUY & DReg4 & DReg
{
    local x:2 = ALUX;
    local y:2 = ALUY;
    local moved:2 = DReg;
    local r:2 = x - y;
    AF = r;
    DReg4 = moved;
    alu_flags_sub(x, y, r);
}

# Type-9 constant operand subset observed in codec profiles.  Values follow
# ADSP-218x Table A-60 (YY/CC/BO).  Additional codes remain unsupported until
# exercised or needed.
AluConst: 0x0001 is yy2=0 & cc2=0 & bo2=1 { export 0x0001:2; }
AluConst: 0x0002 is yy2=0 & cc2=1 & bo2=1 { export 0x0002:2; }
AluConst: 0x0008 is yy2=0 & cc2=3 & bo2=1 { export 0x0008:2; }
AluConst: 0x0010 is yy2=1 & cc2=0 & bo2=1 { export 0x0010:2; }
AluConst: 0x0020 is yy2=1 & cc2=1 & bo2=1 { export 0x0020:2; }
AluConst: 0x0040 is yy2=1 & cc2=2 & bo2=1 { export 0x0040:2; }
AluConst: 0x0080 is yy2=1 & cc2=3 & bo2=1 { export 0x0080:2; }
AluConst: 0x4000 is yy2=3 & cc2=2 & bo2=1 { export 0x4000:2; }
AluConst: 0x0004 is yy2=0 & cc2=2 & bo2=1 { export 0x0004:2; }
AluConst: 0x0100 is yy2=2 & cc2=0 & bo2=1 { export 0x0100:2; }
AluConst: 0x0200 is yy2=2 & cc2=1 & bo2=1 { export 0x0200:2; }
AluConst: 0x0400 is yy2=2 & cc2=2 & bo2=1 { export 0x0400:2; }
AluConst: 0x0800 is yy2=2 & cc2=3 & bo2=1 { export 0x0800:2; }
AluConst: 0x1000 is yy2=3 & cc2=0 & bo2=1 { export 0x1000:2; }
AluConst: 0x2000 is yy2=3 & cc2=1 & bo2=1 { export 0x2000:2; }
AluConst: 0x8000 is yy2=3 & cc2=3 & bo2=1 { export 0x8000:2; }
AluConst: 0xfffe is yy2=0 & cc2=0 & bo2=3 { export 0xfffe:2; }
AluConst: 0xfffd is yy2=0 & cc2=1 & bo2=3 { export 0xfffd:2; }
AluConst: 0xfffb is yy2=0 & cc2=2 & bo2=3 { export 0xfffb:2; }
AluConst: 0xfff7 is yy2=0 & cc2=3 & bo2=3 { export 0xfff7:2; }
AluConst: 0xffef is yy2=1 & cc2=0 & bo2=3 { export 0xffef:2; }
AluConst: 0xffdf is yy2=1 & cc2=1 & bo2=3 { export 0xffdf:2; }
AluConst: 0xffbf is yy2=1 & cc2=2 & bo2=3 { export 0xffbf:2; }
AluConst: 0xff7f is yy2=1 & cc2=3 & bo2=3 { export 0xff7f:2; }

# -----------------------------------------------------------------------------

:"MR = MR +" MACX "*" MACY "(SU)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=9 & MACX & MACY & DReg4 & DReg
{
    local moved:2=DReg; local x:8=sext(MACX); local y:8=zext(MACY); local prod:8=x*y;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=moved;
}

# Type 9: unconditional ALU/MAC forms present in srvdsp.
# -----------------------------------------------------------------------------

:AR "=" ALUY "- 1" is type9=4 & z18=0 & amf5=24 & ALUY & mid4=0 & cond4=15
{
    local old:2 = ALUY;
    AR = old - 1;
    alu_flags_sub(old, 1:2, AR);
}

:AR "=" ALUX "-" ALUY is type9=4 & z18=0 & amf5=23 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AR = oldx - oldy;
    alu_flags_sub(oldx, oldy, AR);
}

:AF "=" ALUX "+" ALUY is type9=4 & z18=1 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AF = oldx + oldy;
    alu_flags_add(oldx, oldy, AF);
}

:AR "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AR = oldx + oldy;
    alu_flags_add(oldx, oldy, AR);
}

:AR "=" "ABS" ALUX is type9=4 & z18=0 & amf5=31 & ALUX & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    if (oldx s>= 0) goto <abs_pos>;
    AR = -oldx;
    goto <abs_done>;
<abs_pos>
    AR = oldx;
<abs_done>
    AZF = (AR == 0);
    ANF = (AR s< 0);
    AVF = (oldx == 0x8000);
    ASF = (oldx s< 0);
}

:AF "=" "ABS" ALUX is type9=4 & z18=1 & amf5=31 & ALUX & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    if (oldx s>= 0) goto <absf_pos>;
    AF = -oldx;
    goto <absf_done>;
<absf_pos>
    AF = oldx;
<absf_done>
    AZF = (AF == 0);
    ANF = (AF s< 0);
    AVF = (oldx == 0x8000);
    ASF = (oldx s< 0);
}

:AR "=" ALUX "XOR" ALUY is type9=4 & z18=0 & amf5=30 & ALUX & ALUY & mid4=0 & cond4=15
{
    AR = ALUX ^ ALUY;
    alu_flags_logic(AR);
}


:AF "=" ALUX "-" ALUY is type9=4 & z18=1 & amf5=23 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AF = oldx - oldy;
    alu_flags_sub(oldx, oldy, AF);
}

:AF "=" ALUY "-" ALUX is type9=4 & z18=1 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=15
{
    local oldx:2 = ALUX;
    local oldy:2 = ALUY;
    AF = oldy - oldx;
    alu_flags_sub(oldy, oldx, AF);
}

:MR "=" MACX "*" MACY is type9=4 & z18=0 & amf5=4 & MACX & MACY & mid4=0 & cond4=15
{
    local sx:4 = sext(MACX);
    local sy:4 = sext(MACY);
    local prod:4 = sx * sy;
    MR0 = prod:2;
    MR1 = prod[16,16];
    MR2 = 0;
    MVF = 0;
}

# AUX corpus form: MR = MR + MX0 * 0 (SS).  The multiplier term is exactly
# zero, so MR is unchanged; MV reflects no MAC overflow for the zero addend.
:"MR = MR + MX0 * 0 (SS)" is type9=4 & z18=0 & amf5=8 & xop3=0 & yop2=3 & mid4=0 & cond4=15
{
    MVF = 0;
}

# Type-9 constant forms used by srvdsp (BO=01 => positive power-of-two).
:AR "=" ALUX "+ 1" is type9=4 & z18=0 & amf5=19 & yy2=0 & ALUX & cc2=0 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx + 1;
    alu_flags_add(oldx, 1:2, AR);
}

:AR "=" ALUX "- 1" is type9=4 & z18=0 & amf5=23 & yy2=0 & ALUX & cc2=0 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx - 1;
    alu_flags_sub(oldx, 1:2, AR);
}

:AF "=" ALUX "+ 1" is type9=4 & z18=1 & amf5=19 & yy2=0 & ALUX & cc2=0 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AF = oldx + 1;
    alu_flags_add(oldx, 1:2, AF);
}

:AR "=" ALUX "- 2" is type9=4 & z18=0 & amf5=23 & yy2=0 & ALUX & cc2=1 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx - 2;
    alu_flags_sub(oldx, 2:2, AR);
}


:AR "=" ALUX "+ 0x20" is type9=4 & z18=0 & amf5=19 & yy2=1 & ALUX & cc2=1 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx + 0x20;
    alu_flags_add(oldx, 0x20:2, AR);
}

:AR "=" ALUX "+ 0x40" is type9=4 & z18=0 & amf5=19 & yy2=1 & ALUX & cc2=2 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx + 0x40;
    alu_flags_add(oldx, 0x40:2, AR);
}

:AR "=" ALUX "- 0x80" is type9=4 & z18=0 & amf5=23 & yy2=1 & ALUX & cc2=3 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx - 0x80;
    alu_flags_sub(oldx, 0x80:2, AR);
}

:AR "=" ALUX "- 0x200" is type9=4 & z18=0 & amf5=23 & yy2=2 & ALUX & cc2=1 & bo2=1 & cond4=15
{
    local oldx:2 = ALUX;
    AR = oldx - 0x200;
    alu_flags_sub(oldx, 0x200:2, AR);
}


:"IF LT" "AR" "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=4
{
    if (ANF == AVF) goto inst_next;
    local x:2 = ALUX;
    local y:2 = ALUY;
    AR = x + y;
    alu_flags_add(x, y, AR);
}

# Codec-profile Type-9 ALU forms.
:AR "=" ALUX "+" AluConst is type9=4 & z18=0 & amf5=19 & ALUX & AluConst & cond4=15
{ local x:2 = ALUX; local c:2 = AluConst; AR = x + c; alu_flags_add(x, c, AR); }
:AF "=" ALUX "+" AluConst is type9=4 & z18=1 & amf5=19 & ALUX & AluConst & cond4=15
{ local x:2 = ALUX; local c:2 = AluConst; AF = x + c; alu_flags_add(x, c, AF); }
:AR "=" ALUX "-" AluConst is type9=4 & z18=0 & amf5=23 & ALUX & AluConst & cond4=15
{ local x:2 = ALUX; local c:2 = AluConst; AR = x - c; alu_flags_sub(x, c, AR); }
:AF "=" ALUX "-" AluConst is type9=4 & z18=1 & amf5=23 & ALUX & AluConst & cond4=15
{ local x:2 = ALUX; local c:2 = AluConst; AF = x - c; alu_flags_sub(x, c, AF); }
:AR "=" AluConst "-" ALUX is type9=4 & z18=0 & amf5=25 & ALUX & AluConst & cond4=15
{ local c:2 = AluConst; local x:2 = ALUX; AR = c - x; alu_flags_sub(c, x, AR); }
:AR "=" ALUX "AND" AluConst is type9=4 & z18=0 & amf5=28 & ALUX & AluConst & cond4=15
{ AR = ALUX & AluConst; alu_flags_logic(AR); }
:AR "=" ALUX "OR" AluConst is type9=4 & z18=0 & amf5=29 & ALUX & AluConst & cond4=15
{ AR = ALUX | AluConst; alu_flags_logic(AR); }

:AR "=" ALUX "AND" ALUY is type9=4 & z18=0 & amf5=28 & ALUX & ALUY & mid4=0 & cond4=15
{ AR = ALUX & ALUY; alu_flags_logic(AR); }
:AR "=" ALUX "OR" ALUY is type9=4 & z18=0 & amf5=29 & ALUX & ALUY & mid4=0 & cond4=15
{ AR = ALUX | ALUY; alu_flags_logic(AR); }
:AR "=" ALUY "-" ALUX is type9=4 & z18=0 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=15
{ local y:2 = ALUY; local x:2 = ALUX; AR = y - x; alu_flags_sub(y, x, AR); }
:AR "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=15
{ AR = ALUY; alu_flags_logic(AR); }
:"IF EQ" "AR" "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=0
{ if (AZF == 0) goto inst_next; AR = ALUY; alu_flags_logic(AR); }
:"IF GE" "AR" "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=5
{ if (ANF != AVF) goto inst_next; AR = ALUY; alu_flags_logic(AR); }
:"IF GE" "AR" "=" ALUX "-" ALUY is type9=4 & z18=0 & amf5=23 & ALUX & ALUY & mid4=0 & cond4=5
{ if (ANF != AVF) goto inst_next; local x:2=ALUX; local y:2=ALUY; AR=x-y; alu_flags_sub(x,y,AR); }

# -----------------------------------------------------------------------------
# Reachable codec-profile expansion (ADSP-218x reference forms).
# The current corpus only needs the predicates below; leave other conditions
# unsupported until they are reached with status semantics proven.
# -----------------------------------------------------------------------------

# Conditional Type-9 ALU forms.
:"IF EQ" "AR" "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=0
{ if (AZF == 0) goto inst_next; local x:2=ALUX; local y:2=ALUY; AR=x+y; alu_flags_add(x,y,AR); }
:"IF NE" "AR" "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=1
{ if (AZF != 0) goto inst_next; local x:2=ALUX; local y:2=ALUY; AR=x+y; alu_flags_add(x,y,AR); }
:"IF LE" "AR" "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=3
{ local take:1=(AZF!=0)||(ANF!=AVF); if (take==0) goto inst_next; local x:2=ALUX; local y:2=ALUY; AR=x+y; alu_flags_add(x,y,AR); }
:"IF GE" "AR" "=" ALUX "+" ALUY is type9=4 & z18=0 & amf5=19 & ALUX & ALUY & mid4=0 & cond4=5
{ if (ANF != AVF) goto inst_next; local x:2=ALUX; local y:2=ALUY; AR=x+y; alu_flags_add(x,y,AR); }
:"IF NE" "AR" "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=1
{ if (AZF != 0) goto inst_next; AR=ALUY; alu_flags_logic(AR); }
:"IF LE" "AR" "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=3
{ local take:1=(AZF!=0)||(ANF!=AVF); if (take==0) goto inst_next; AR=ALUY; alu_flags_logic(AR); }
:"IF LT" "AR" "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=4
{ if (ANF == AVF) goto inst_next; AR=ALUY; alu_flags_logic(AR); }
:"IF EQ" "AR" "=" ALUY "+ 1" is type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=0
{ if (AZF == 0) goto inst_next; local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }

# Conditional constant forms reached by codec profiles.
:"IF EQ" "AR" "=" AluConst is type9=4 & z18=0 & amf5=16 & AluConst & cond4=0
{ if (AZF == 0) goto inst_next; AR=AluConst; alu_flags_logic(AR); }
:"IF GE" "AR" "=" AluConst is type9=4 & z18=0 & amf5=16 & AluConst & cond4=5
{ if (ANF != AVF) goto inst_next; AR=AluConst; alu_flags_logic(AR); }
:"IF LE" "AR" "=" AluConst "+ 1" is type9=4 & z18=0 & amf5=17 & AluConst & cond4=3
{ local take:1=(AZF!=0)||(ANF!=AVF); if (take==0) goto inst_next; local c:2=AluConst; AR=c+1; alu_flags_add(c,1:2,AR); }
:"IF GE" "AR" "=" AluConst "- 1" is type9=4 & z18=0 & amf5=24 & AluConst & cond4=5
{ if (ANF != AVF) goto inst_next; local c:2=AluConst; AR=c-1; alu_flags_sub(c,1:2,AR); }
:"IF NE" "AR" "=" ALUX "+" AluConst is type9=4 & z18=0 & amf5=19 & ALUX & AluConst & cond4=1
{ if (AZF != 0) goto inst_next; local x:2=ALUX; local c:2=AluConst; AR=x+c; alu_flags_add(x,c,AR); }

# Additional unconditional Type-9 ALU/MAC forms.
:AF "=" ALUY is type9=4 & z18=1 & amf5=16 & ALUY & mid4=0 & cond4=15
{ AF=ALUY; alu_flags_logic(AF); }
:AR "=" ALUY "+ 1" is type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }
:AF "=" ALUX "AND" ALUY is type9=4 & z18=1 & amf5=28 & ALUX & ALUY & mid4=0 & cond4=15
{ AF=ALUX & ALUY; alu_flags_logic(AF); }
:AF "=" ALUX "OR" ALUY is type9=4 & z18=1 & amf5=29 & ALUX & ALUY & mid4=0 & cond4=15
{ AF=ALUX | ALUY; alu_flags_logic(AF); }
:AF "=" ALUX "AND" AluConst is type9=4 & z18=1 & amf5=28 & ALUX & AluConst & cond4=15
{ AF=ALUX & AluConst; alu_flags_logic(AF); }

# MAC formats reached in Type 9.  RND remains an explicit userop because its
# 40-bit rounding/saturation result depends on MAC mode details not yet modeled.
:"MR =" MACX "*" MACY "(RND)" is type9=4 & z18=0 & amf5=1 & MACX & MACY & mid4=0 & cond4=15
{ dsp_mac_round_xy(MACX,MACY); }
:"MR =" MACX "*" MACY "(UU)" is type9=4 & z18=0 & amf5=7 & MACX & MACY & mid4=0 & cond4=15
{
    local x:4=zext(MACX); local y:4=zext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; MVF=0;
}
:"MR = MR +" MACX "*" MACY "(SS)" is type9=4 & z18=0 & amf5=8 & MACX & MACY & mid4=0 & cond4=15
{
    local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16];
}

# Type 8 ALU/MAC plus data-register move, read-first/write-second.
:AR "=" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=16 & ALUY & DReg4 & DReg
{ local y:2=ALUY; local moved:2=DReg; AR=y; DReg4=moved; alu_flags_logic(AR); }
:AF "=" ALUY "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=16 & ALUY & DReg4 & DReg
{ local y:2=ALUY; local moved:2=DReg; AF=y; DReg4=moved; alu_flags_logic(AF); }
:AR "=" ALUY "+ 1," DReg4 "=" DReg is type9=5 & z18=0 & amf5=17 & ALUY & DReg4 & DReg
{ local y:2=ALUY; local moved:2=DReg; AR=y+1; DReg4=moved; alu_flags_add(y,1:2,AR); }
:AR "=" ALUX "AND" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=28 & ALUX & ALUY & DReg4 & DReg
{ local x:2=ALUX; local y:2=ALUY; local moved:2=DReg; AR=x&y; DReg4=moved; alu_flags_logic(AR); }
:"MR =" MACX "*" MACY "(SS)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DReg
{
    local moved:2=DReg; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; if (prod s>=0) goto <t8ss_sign_done>; MR2=0xffff; <t8ss_sign_done> DReg4=moved; MVF=0;
}
:"MR =" MACX "*" MACY "(UU)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=7 & MACX & MACY & DReg4 & DReg
{
    local moved:2=DReg; local x:4=zext(MACX); local y:4=zext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; DReg4=moved; MVF=0;
}
:"MR =" MACX "*" MACY "(RND)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; dsp_mac_round_xy(MACX,MACY); DReg4=moved; }

# Type 4 computation + DM read. Only D=0 forms are currently reachable.
:"MR =" MACX "*" MACY "(RND)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; dsp_mac_round_xy(MACX,MACY); DReg4=v; DagI=a+m; }
:"MR =" MACX "*" MACY "(SS)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; if (prod s>=0) goto <t4ss_sign_done>; MR2=0xffff; <t4ss_sign_done> DReg4=v; DagI=a+m; MVF=0;
}
:AF "=" ALUY "+ 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=17 & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local y:2=ALUY; AF=y+1; DReg4=v; DagI=a+m; alu_flags_add(y,1:2,AF); }
:AR "=" "-" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=21 & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local y:2=ALUY; AR=-y; DReg4=v; DagI=a+m; alu_flags_sub(0:2,y,AR); }
:AR "=" ALUX "-" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local x:2=ALUX; local y:2=ALUY; AR=x-y; DReg4=v; DagI=a+m; alu_flags_sub(x,y,AR); }
:AR "=" ALUX "AND" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=28 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; AR=ALUX&ALUY; DReg4=v; DagI=a+m; alu_flags_logic(AR); }


:AR "=" "ABS" ALUX "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=31 & ALUX & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local x:2=ALUX;
    if(x s>=0) goto <final_t4abs_pos>; AR=-x; goto <final_t4abs_done>;
<final_t4abs_pos> AR=x;
<final_t4abs_done> DReg4=v; DagI=a+m; AZF=(AR==0); ANF=(AR s<0); AVF=(x==0x8000); ASF=(x s<0);
}
:AR "=" ALUY "+ 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=17 & ALUY & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local y:2=ALUY; AR=y+1; DReg4=v; DagI=a+m; alu_flags_add(y,1:2,AR);
}


:AR "=" ALUY "-" ALUX "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=25 & ALUX & ALUY & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local y:2=ALUY; local x:2=ALUX;
    AR=y-x; *[DM]:2 a=stored; DagI=a+m; alu_flags_sub(y,x,AR);
}

# Type 5 computation + PM read. PMD low 8 bits flow through PX implicitly.
:"MR =" MACX "*" MACY "(RND)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; dsp_mac_round_xy(MACX,MACY);
    DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m;
}
:AR "=" "ABS" ALUX "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=31 & ALUX & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local x:2=ALUX;
    if (x s>= 0) goto <t5_abs_pos>; AR=-x; goto <t5_abs_done>;
<t5_abs_pos> AR=x;
<t5_abs_done> DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; AZF=(AR==0); ANF=(AR s<0); AVF=(x==0x8000); ASF=(x s<0);
}



:AR "=" ALUX "-" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local x:2=ALUX; local y:2=ALUY;
    AR=x-y; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; alu_flags_sub(x,y,AR);
}

# -----------------------------------------------------------------------------
# Broad reachable-code completion pass.
# These forms are all present on reachable AUX/PCM/AC-3/DTS routes and map to
# ADSP-218x reference encodings. Parallel forms snapshot memory/register inputs
# before writing results. Rounded MAC accumulation remains an explicit userop.
# -----------------------------------------------------------------------------

# Type 1: ALU/MAC plus simultaneous PM/DM reads.
:"MR = MR +" MACX "*" MACY "(SS)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=8 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM;
    local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da;
    local sx:8=sext(MACX); local sy:8=sext(MACY); local prod:8=sx*sy;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm;
}
:"MR = MR -" MACX "*" MACY "(SS)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=12 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM;
    local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da;
    local sx:8=sext(MACX); local sy:8=sext(MACY); local prod:8=sx*sy;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm;
}
:AR "=" ALUX "+" ALUY "," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=19 & ALUX & ALUY & PDReg & DDReg & PmI & PmM & DmI & DmM
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da;
    local x:2=ALUX; local y:2=ALUY; AR=x+y; alu_flags_add(x,y,AR);
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm;
}

# Type 4: ALU/MAC with DM read/write.
:"MR = MR +" MACX "*" MACY "(SS)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=8 & MACX & MACY & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local sx:8=sext(MACX); local sy:8=sext(MACY); local prod:8=sx*sy;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=v; DagI=a+m;
}
:AF "=" ALUX "+" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local x:2=ALUX; local y:2=ALUY; AF=x+y; DReg4=v; DagI=a+m; alu_flags_add(x,y,AF); }
:AR "=" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=16 & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; AR=ALUY; DReg4=v; DagI=a+m; alu_flags_logic(AR); }
:AR "=" ALUY "-" ALUX "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=25 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local y:2=ALUY; local x:2=ALUX; AR=y-x; DReg4=v; DagI=a+m; alu_flags_sub(y,x,AR); }
:AF "=" ALUY "- 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=24 & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 a; local y:2=ALUY; AF=y-1; DReg4=v; DagI=a+m; alu_flags_sub(y,1:2,AF); }
:AR "=" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=16 & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local y:2=ALUY; AR=y; *[DM]:2 a=stored; DagI=a+m; alu_flags_logic(AR); }

:AR "=" ALUX "+" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AR=x+y; *[DM]:2 a=stored; DagI=a+m; alu_flags_add(x,y,AR); }
:"MR =" MACX "*" MACY "(RND)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; dsp_mac_round_xy(MACX,MACY); *[DM]:2 a=stored; DagI=a+m; }

# Type 5: ALU/MAC with PM read.
:"MR = MR +" MACX "*" MACY "(RND)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; dsp_mac_acc_round_xy(MACX,MACY); DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; }
:"MR =" MACX "*" MACY "(SS)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <t5ss_d>; MR2=0xffff; <t5ss_d> DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; MVF=0; }
:"MR =" MACX "*" MACY "(UU)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=7 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local x:4=zext(MACX); local y:4=zext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; MVF=0; }
:"MR = MR +" MACX "*" MACY "(SS)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=8 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; }
:AR "=" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=16 & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; AR=ALUY; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; alu_flags_logic(AR); }
:AR "=" ALUX "+" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local x:2=ALUX; local y:2=ALUY; AR=x+y; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; alu_flags_add(x,y,AR); }
:AF "=" ALUX "+" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local x:2=ALUX; local y:2=ALUY; AF=x+y; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; alu_flags_add(x,y,AF); }

# Type 8: ALU/MAC plus data-register move.
:"MR = MR +" MACX "*" MACY "(RND)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; dsp_mac_acc_round_xy(MACX,MACY); DReg4=moved; }
:"MR = MR -" MACX "*" MACY "(RND)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=3 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; dsp_mac_sub_round_xy(MACX,MACY); DReg4=moved; }
:"MR = MR +" MACX "*" MACY "(SS)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=8 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=moved; }
:"MR = MR -" MACX "*" MACY "(SS)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=12 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=moved; }
:AF "=" ALUY "-" ALUX "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=25 & ALUX & ALUY & DReg4 & DReg
{ local moved:2=DReg; local y:2=ALUY; local x:2=ALUX; AF=y-x; DReg4=moved; alu_flags_sub(y,x,AF); }


# ADSP-218x Type-9 square encoding: bits 12..11=00 and bits 7..4=0001
# select xop*xop instead of xop*yop. Current reachable codec corpus uses
# unconditional signed accumulate-to-MR form (AMF=01000).
:"MR = MR +" MACX "*" MACXSq "(SS)" is type9=4 & z18=0 & amf5=8 & yy2=0 & MACX & MACXSq & mid4=1 & cond4=15
{
    local x:8=sext(MACX);
    local prod:8=x*x;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0);
    local res:8=cur+prod;
    MR0=res:2;
    MR1=res[16,16];
    MR2=res[32,16];
}

# Type 9 additional ALU/MAC forms.

:"MR =" MACX "*" MACX2 "(SS)" is type9=4 & z18=0 & amf5=4 & yop2=0 & MACX & MACX2 & mid4=1 & cond4=15
{
    local x:4=sext(MACX); local x2:4=sext(MACX2); local prod:4=x*x2;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <final_square_ss_done>; MR2=0xffff; <final_square_ss_done> MVF=0;
}

:"MR = MR -" MACX "*" MACX2 "(SS)" is type9=4 & z18=0 & amf5=12 & yop2=0 & MACX & MACX2 & mid4=1 & cond4=15
{
    local x:8=sext(MACX); local x2:8=sext(MACX2); local prod:8=x*x2;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16];
}



:"MR = MR -" MACX "*" MACY "(SS)" is type9=4 & z18=0 & amf5=12 & MACX & MACY & mid4=0 & cond4=15
{
    local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16];
}
:"MF =" MACX "*" MACY "(SU)" is type9=4 & z18=1 & amf5=5 & MACX & MACY & mid4=0 & cond4=15
{
    local x:4=sext(MACX); local y:4=zext(MACY); local prod:4=x*y; MF=prod[16,16]; MVF=0;
}
:"IF EQ" "AR" "=" ALUY "-" ALUX is type9=4 & z18=0 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=0
{
    if(AZF==0) goto inst_next; local y:2=ALUY; local x:2=ALUX; AR=y-x; alu_flags_sub(y,x,AR);
}

:"MR = MR +" MACX "*" MACY "(RND)" is type9=4 & z18=0 & amf5=2 & MACX & MACY & mid4=0 & cond4=15
{ dsp_mac_acc_round_xy(MACX,MACY); }
:"MR =" MACX "*" MACY "(SU)" is type9=4 & z18=0 & amf5=5 & MACX & MACY & mid4=0 & cond4=15
{ local x:4=sext(MACX); local y:4=zext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <t9su_d>; MR2=0xffff; <t9su_d> MVF=0; }
:"MR = MR +" MACX "*" MACY "(UU)" is type9=4 & z18=0 & amf5=11 & MACX & MACY & mid4=0 & cond4=15
{ local x:8=zext(MACX); local y:8=zext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; }
:MF "=" MACX "*" MACY "(SS)" is type9=4 & z18=1 & amf5=4 & MACX & MACY & mid4=0 & cond4=15
{ local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y; MF=prod[16,16]; MVF=0; }
:AF "=" ALUY "+ 1" is type9=4 & z18=1 & amf5=17 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AF=y+1; alu_flags_add(y,1:2,AF); }
:AF "=" ALUY "- 1" is type9=4 & z18=1 & amf5=24 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AF=y-1; alu_flags_sub(y,1:2,AF); }
:AR "=" "-" ALUY is type9=4 & z18=0 & amf5=21 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AR=0-y; alu_flags_sub(0:2,y,AR); }

:AR "=" "NOT" ALUX is type9=4 & z18=0 & amf5=27 & ALUX & mid4=0 & cond4=15
{ AR=~ALUX; alu_flags_logic(AR); }
:AF "=" ALUX "XOR" ALUY is type9=4 & z18=1 & amf5=30 & ALUX & ALUY & mid4=0 & cond4=15
{ AF=ALUX^ALUY; alu_flags_logic(AF); }
:AR "=" ALUX "XOR" AluConst is type9=4 & z18=0 & amf5=30 & ALUX & AluConst & cond4=15
{ AR=ALUX^AluConst; alu_flags_logic(AR); }

# Type 9 conditional forms reached after deeper flow expansion.
:"IF NE" "AR" "=" AluConst is type9=4 & z18=0 & amf5=16 & AluConst & cond4=1
{ if(AZF!=0) goto inst_next; AR=AluConst; alu_flags_logic(AR); }
:"IF GT" "AR" "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=2
{ if(AZF!=0) goto inst_next; if(ANF!=AVF) goto inst_next; AR=ALUY; alu_flags_logic(AR); }
:"IF NE" "AR" "=" ALUY "+ 1" is type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=1
