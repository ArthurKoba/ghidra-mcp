{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; dsp_mac_sub_round_xy(MACX,MACY); *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); }
# Exact zero product, parallel DM write: latch old DReg4 before clearing the accumulator.
:"MR = MX0 * 0 (SS)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=4 & xop3=0 & yop2=3 & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local a:2=DagI; local m:2=DagM; local stored:2=DReg4;
    MR0=0; MR1=0; MR2=0;
    *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); MVF=0;
}

:"MR =" MACX "*" MACY "(SS)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); MVF=0; }
:AR "=" ALUX "-" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AR=x-y; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(x,y,AR); }

# Deep Type 4 DM-read forms.
:"MR = MR -" MACX "*" MACY "(SS)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=12 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); }
:"MR = MR +" MACX "*" MACY "(RND)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; dsp_mac_acc_round_xy(MACX,MACY); DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); }
:"MR = MR -" MACX "*" MACY "(RND)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=3 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; dsp_mac_sub_round_xy(MACX,MACY); DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); }
:AF "=" ALUX "-" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local x:2=ALUX; local y:2=ALUY; AF=x-y; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(x,y,AF); }

# Deep Type 1 reachable forms.
:"MR = MR +" MACX "*" MACY "(RND)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=2 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{ local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress; dsp_mac_acc_round_xy(MACX,MACY); PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL); }
:"MR = MR -" MACX "*" MACY "(RND)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=3 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{ local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress; dsp_mac_sub_round_xy(MACX,MACY); PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL); }


# Final reachable codec-profile ALU/MAC + memory forms.
:AF "=" ALUX "+" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AF=x+y; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(x,y,AF); }
:"MR = MR +" MACX "*" MACY "(RND)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; dsp_mac_acc_round_xy(MACX,MACY); *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); }
:AF "=" ALUX "-" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=1 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AF=x-y; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(x,y,AF); }
:"MR =" MACX "*" MACY "(SU)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=5 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:4=sext(MACX); local y:4=zext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); MVF=0; }

:AR "=" ALUY "-" ALUX "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=25 & ALUX & ALUY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local y:2=ALUY; local x:2=ALUX; AR=y-x; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(y,x,AR); }
:"MR = MR -" MACX "*" MACY "(RND)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=3 & MACX & MACY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); dsp_mac_sub_round_xy(MACX,MACY); DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); }
:AR "=" ALUX "+" ALUY "," "PM(" DagI "," DagM ")" "=" DReg4 is op4=5 & d19=1 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AR=x+y; local word:3=(zext(stored)<<8)|(zext(PX)&0xff); dsp_pm_store24(a,word); dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(x,y,AR); }

:"MF = MR +" MACX "*" MACY "(SS)" is type9=4 & z18=1 & amf5=8 & MACX & MACY & mid4=0 & cond4=15
{ local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MF=res[16,16]; }
:"MF =" MACX "*" MACY "(RND)" is type9=4 & z18=1 & amf5=1 & MACX & MACY & mid4=0 & cond4=15
{ dsp_mac_round_mf_xy(MACX,MACY); }
:"MR = MR +" MACX "*" MACY "(SU)" is type9=4 & z18=0 & amf5=9 & MACX & MACY & mid4=0 & cond4=15
{ local x:8=sext(MACX); local y:8=zext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; }
:"IF LE" "AR" "=" ALUY "+ 1" is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=3
{ local take:1=(AZF!=0)||(ANF!=AVF); if(take==0) goto inst_next; local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }
:"IF LE" "AR" "=" ALUY "+ 1" is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=3
{ local take:1=(AZF!=0)||(ANF!=AVF); if(take==0) goto <arch_condition_skipped>; local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR);
<arch_condition_skipped>
}
:"IF AC" "AR" "=" ALUY is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=8
{ if(ACF==0) goto inst_next; AR=ALUY; alu_flags_logic(AR); }
:"IF AC" "AR" "=" ALUY is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=8
{ if(ACF==0) goto <arch_condition_skipped>; AR=ALUY; alu_flags_logic(AR);
<arch_condition_skipped>
}
:"IF EQ" "AR" "=" ALUX "AND" AluConst is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=28 & ALUX & AluConst & cond4=0
{ if(AZF==0) goto inst_next; AR=ALUX&AluConst; alu_flags_logic(AR); }
:"IF EQ" "AR" "=" ALUX "AND" AluConst is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=28 & ALUX & AluConst & cond4=0
{ if(AZF==0) goto <arch_condition_skipped>; AR=ALUX&AluConst; alu_flags_logic(AR);
<arch_condition_skipped>
}
:"IF NE" "AR" "=" ALUY "-" ALUX is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=1
{ if(AZF!=0) goto inst_next; local y:2=ALUY; local x:2=ALUX; AR=y-x; alu_flags_sub(y,x,AR); }
:"IF NE" "AR" "=" ALUY "-" ALUX is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=1
{ if(AZF!=0) goto <arch_condition_skipped>; local y:2=ALUY; local x:2=ALUX; AR=y-x; alu_flags_sub(y,x,AR);
