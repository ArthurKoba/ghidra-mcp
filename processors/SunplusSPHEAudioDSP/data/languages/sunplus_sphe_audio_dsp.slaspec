# Additional unconditional Type-9 ALU/MAC forms.
:AF "=" ALUY is type9=4 & z18=1 & amf5=16 & ALUY & mid4=0 & cond4=15
{ AF=ALUY; alu_flags_logic(AF); }
:AR "=" ALUY "+ 1" is type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }
:AF "=" ALUX "AND" ALUY is type9=4 & z18=1 & amf5=28 & ALUX & ALUY & mid4=0 & cond4=15
{ AF=ALUX & ALUY; alu_flags_logic(AF); }
:AF "=" ALUX "OR" ALUY is type9=4 & z18=1 & amf5=29 & ALUX & ALUY & mid4=0 & cond4=15
{ AF=ALUX | ALUY; alu_flags_logic(AF); }
:AF "=" ALUX "AND" AluConst is type9=4 & z18=1 & amf5=28 & ALUX & AluConst & cond4=15
{ AF=ALUX & AluConst; alu_flags_logic(AF); }

# MAC formats reached in Type 9.  RND remains an explicit userop because its
# 40-bit rounding/saturation result depends on MAC mode details not yet modeled.
:"MR =" MACX "*" MACY "(RND)" is type9=4 & z18=0 & amf5=1 & MACX & MACY & mid4=0 & cond4=15
{ dsp_mac_round_xy(MACX,MACY); }
:"MR =" MACX "*" MACY "(UU)" is type9=4 & z18=0 & amf5=7 & MACX & MACY & mid4=0 & cond4=15
{
    local x:4=zext(MACX); local y:4=zext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; MVF=0;
}
:"MR = MR +" MACX "*" MACY "(SS)" is type9=4 & z18=0 & amf5=8 & MACX & MACY & mid4=0 & cond4=15
{
    local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16];
}

# Type 8 ALU/MAC plus data-register move, read-first/write-second.
:AR "=" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=16 & ALUY & DReg4 & DReg
{ local y:2=ALUY; local moved:2=DReg; AR=y; DReg4=moved; alu_flags_logic(AR); }
:AF "=" ALUY "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=16 & ALUY & DReg4 & DReg
{ local y:2=ALUY; local moved:2=DReg; AF=y; DReg4=moved; alu_flags_logic(AF); }
:AR "=" ALUY "+ 1," DReg4 "=" DReg is type9=5 & z18=0 & amf5=17 & ALUY & DReg4 & DReg
{ local y:2=ALUY; local moved:2=DReg; AR=y+1; DReg4=moved; alu_flags_add(y,1:2,AR); }
:AR "=" ALUX "AND" ALUY "," DReg4 "=" DReg is type9=5 & z18=0 & amf5=28 & ALUX & ALUY & DReg4 & DReg
{ local x:2=ALUX; local y:2=ALUY; local moved:2=DReg; AR=x&y; DReg4=moved; alu_flags_logic(AR); }
:"MR =" MACX "*" MACY "(SS)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DReg
{
    local moved:2=DReg; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2; DReg4=moved; MVF=0;
}
:"MR =" MACX "*" MACY "(UU)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=7 & MACX & MACY & DReg4 & DReg
{
    local moved:2=DReg; local x:4=zext(MACX); local y:4=zext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; MR2=0; DReg4=moved; MVF=0;
}
:"MR =" MACX "*" MACY "(RND)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; dsp_mac_round_xy(MACX,MACY); DReg4=moved; }

# Exact zero product, parallel DM read: the native signed product MX0*0 cannot be negative.
:"MR = MX0 * 0 (SS)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=4 & xop3=0 & yop2=3 & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local a:2=DagI; local m:2=DagM; local fetched:2=*[DM]:2 DagDmAddress;
    MR0=0; MR1=0; MR2=0;
    DReg4=fetched; dsp_dag_postmodify(DagI, a, m, DagL); MVF=0;
}

# Type 4 computation + DM read. Only D=0 forms are currently reachable.
:"MR =" MACX "*" MACY "(RND)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; dsp_mac_round_xy(MACX,MACY); DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); }
:"MR =" MACX "*" MACY "(SS)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y;
    MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); MVF=0;
}
:AF "=" ALUY "+ 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=17 & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local y:2=ALUY; AF=y+1; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(y,1:2,AF); }
:AR "=" "-" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=21 & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local y:2=ALUY; AR=-y; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(0:2,y,AR); }
:AR "=" ALUX "-" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local x:2=ALUX; local y:2=ALUY; AR=x-y; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(x,y,AR); }
:AR "=" ALUX "AND" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=28 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; AR=ALUX&ALUY; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_logic(AR); }


:AR "=" "ABS" ALUX "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=31 & ALUX & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local x:2=ALUX;
    if(x s>=0) goto <final_t4abs_pos>; AR=-x; goto <final_t4abs_done>;
<final_t4abs_pos> AR=x;
<final_t4abs_done> DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); AZF=(AR==0); ANF=(AR s<0); AVF=(x==0x8000); ASF=(x s<0);
}
:AR "=" ALUY "+ 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=17 & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local y:2=ALUY; AR=y+1; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(y,1:2,AR);
}


:AR "=" ALUY "-" ALUX "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=25 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local y:2=ALUY; local x:2=ALUX;
    AR=y-x; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(y,x,AR);
}

# Type 5 computation + PM read. PMD low 8 bits flow through PX implicitly.
:"MR =" MACX "*" MACY "(RND)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DagI & DagM & DagL
{
    local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); dsp_mac_round_xy(MACX,MACY);
    DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL);
}
:AR "=" "ABS" ALUX "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=31 & ALUX & DReg4 & DagI & DagM & DagL
{
    local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local x:2=ALUX;
    if (x s>= 0) goto <t5_abs_pos>; AR=-x; goto <t5_abs_done>;
<t5_abs_pos> AR=x;
<t5_abs_done> DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); AZF=(AR==0); ANF=(AR s<0); AVF=(x==0x8000); ASF=(x s<0);
}



:AR "=" ALUX "-" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM & DagL
{
    local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local x:2=ALUX; local y:2=ALUY;
    AR=x-y; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(x,y,AR);
}

# -----------------------------------------------------------------------------
# Broad reachable-code completion pass.
# These forms are all present on reachable AUX/PCM/AC-3/DTS routes and map to
# ADSP-218x reference encodings. Parallel forms snapshot memory/register inputs
# before writing results. Rounded MAC accumulation remains an explicit userop.
# -----------------------------------------------------------------------------

# Type 1: ALU/MAC plus simultaneous PM/DM reads.
:"MR = MR +" MACX "*" MACY "(SS)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=8 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM;
    local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress;
    local sx:8=sext(MACX); local sy:8=sext(MACY); local prod:8=sx*sy;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL);
}
:"MR = MR -" MACX "*" MACY "(SS)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=12 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM;
    local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress;
    local sx:8=sext(MACX); local sy:8=sext(MACY); local prod:8=sx*sy;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL);
}
:AR "=" ALUX "+" ALUY "," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=19 & ALUX & ALUY & PDReg & DDReg & PmI & PmM & DmI & DmM & DualDmAddress & PmL & DmL
{
    local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=dsp_pm_load24(pa); local dv:2=*[DM]:2 DualDmAddress;
    local x:2=ALUX; local y:2=ALUY; AR=x+y; alu_flags_add(x,y,AR);
    PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; dsp_dag_postmodify(PmI, pa, pm, PmL); dsp_dag_postmodify(DmI, da, dm, DmL);
}

# Type 4: ALU/MAC with DM read/write.
:"MR = MR +" MACX "*" MACY "(SS)," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=8 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{
    local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local sx:8=sext(MACX); local sy:8=sext(MACY); local prod:8=sx*sy;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL);
}
:AF "=" ALUX "+" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local x:2=ALUX; local y:2=ALUY; AF=x+y; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(x,y,AF); }
:AR "=" ALUY "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=16 & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; AR=ALUY; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_logic(AR); }
:AR "=" ALUY "-" ALUX "," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=0 & amf5=25 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local y:2=ALUY; local x:2=ALUX; AR=y-x; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(y,x,AR); }
:AF "=" ALUY "- 1," DReg4 "=" "DM(" DagI "," DagM ")" is type3=3 & d19=0 & z18=1 & amf5=24 & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local v:2=*[DM]:2 DagDmAddress; local y:2=ALUY; AF=y-1; DReg4=v; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_sub(y,1:2,AF); }
:AR "=" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=16 & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local y:2=ALUY; AR=y; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_logic(AR); }

:AR "=" ALUX "+" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AR=x+y; *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(x,y,AR); }
:"MR =" MACX "*" MACY "(RND)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=1 & MACX & MACY & DReg4 & DagI & DagM & DagDmAddress & DagL
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; dsp_mac_round_xy(MACX,MACY); *[DM]:2 DagDmAddress=stored; dsp_dag_postmodify(DagI, a, m, DagL); }

# Type 5: ALU/MAC with PM read.
:"MR = MR +" MACX "*" MACY "(RND)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); dsp_mac_acc_round_xy(MACX,MACY); DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); }
:"MR =" MACX "*" MACY "(SS)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); MVF=0; }
:"MR =" MACX "*" MACY "(UU)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=7 & MACX & MACY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local x:4=zext(MACX); local y:4=zext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); MVF=0; }
:"MR = MR +" MACX "*" MACY "(SS)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=8 & MACX & MACY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); }
:AR "=" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=16 & ALUY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); AR=ALUY; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_logic(AR); }
:AR "=" ALUX "+" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local x:2=ALUX; local y:2=ALUY; AR=x+y; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(x,y,AR); }
:AF "=" ALUX "+" ALUY "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM & DagL
{ local a:2=DagI; local m:2=DagM; local word:3=dsp_pm_load24(a); local x:2=ALUX; local y:2=ALUY; AF=x+y; DReg4=word[8,16]; PX=zext(word[0,8]); dsp_dag_postmodify(DagI, a, m, DagL); alu_flags_add(x,y,AF); }

# Type 8: ALU/MAC plus data-register move.
:"MR = MR +" MACX "*" MACY "(RND)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; dsp_mac_acc_round_xy(MACX,MACY); DReg4=moved; }
:"MR = MR -" MACX "*" MACY "(RND)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=3 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; dsp_mac_sub_round_xy(MACX,MACY); DReg4=moved; }
:"MR = MR +" MACX "*" MACY "(SS)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=8 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=moved; }
:"MR = MR -" MACX "*" MACY "(SS)," DReg4 "=" DReg is type9=5 & z18=0 & amf5=12 & MACX & MACY & DReg4 & DReg
{ local moved:2=DReg; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; DReg4=moved; }
:AF "=" ALUY "-" ALUX "," DReg4 "=" DReg is type9=5 & z18=1 & amf5=25 & ALUX & ALUY & DReg4 & DReg
{ local moved:2=DReg; local y:2=ALUY; local x:2=ALUX; AF=y-x; DReg4=moved; alu_flags_sub(y,x,AF); }


# ADSP-218x Type-9 square encoding: bits 12..11=00 and bits 7..4=0001
# select xop*xop instead of xop*yop. Current reachable codec corpus uses
# unconditional signed accumulate-to-MR form (AMF=01000).
:"MR = MR +" MACX "*" MACXSq "(SS)" is type9=4 & z18=0 & amf5=8 & yy2=0 & MACX & MACXSq & mid4=1 & cond4=15
{
    local x:8=sext(MACX);
    local prod:8=x*x;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0);
    local res:8=cur+prod;
    MR0=res:2;
    MR1=res[16,16];
    MR2=res[32,16];
}

# Type 9 additional ALU/MAC forms.

:"MR =" MACX "*" MACX2 "(SS)" is type9=4 & z18=0 & amf5=4 & yop2=0 & MACX & MACX2 & mid4=1 & cond4=15
{
    local x:4=sext(MACX); local x2:4=sext(MACX2); local prod:4=x*x2;
    MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2; MVF=0;
}

:"MR = MR -" MACX "*" MACX2 "(SS)" is type9=4 & z18=0 & amf5=12 & yop2=0 & MACX & MACX2 & mid4=1 & cond4=15
{
    local x:8=sext(MACX); local x2:8=sext(MACX2); local prod:8=x*x2;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16];
}



:"MR = MR -" MACX "*" MACY "(SS)" is type9=4 & z18=0 & amf5=12 & MACX & MACY & mid4=0 & cond4=15
{
    local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y;
    local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod;
    MR0=res:2; MR1=res[16,16]; MR2=res[32,16];
}
:"MF =" MACX "*" MACY "(SU)" is type9=4 & z18=1 & amf5=5 & MACX & MACY & mid4=0 & cond4=15
{
    local x:4=sext(MACX); local y:4=zext(MACY); local prod:4=x*y; MF=prod[16,16]; MVF=0;
}
:"IF EQ" "AR" "=" ALUY "-" ALUX is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=0
{
    if(AZF==0) goto inst_next; local y:2=ALUY; local x:2=ALUX; AR=y-x; alu_flags_sub(y,x,AR);
}
:"IF EQ" "AR" "=" ALUY "-" ALUX is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=0
{
    if(AZF==0) goto <arch_condition_skipped>; local y:2=ALUY; local x:2=ALUX; AR=y-x; alu_flags_sub(y,x,AR);

<arch_condition_skipped>
}

:"MR = MR +" MACX "*" MACY "(RND)" is type9=4 & z18=0 & amf5=2 & MACX & MACY & mid4=0 & cond4=15
{ dsp_mac_acc_round_xy(MACX,MACY); }
:"MR =" MACX "*" MACY "(SU)" is type9=4 & z18=0 & amf5=5 & MACX & MACY & mid4=0 & cond4=15
{ local x:4=sext(MACX); local y:4=zext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; local sign:4=prod s>>31; MR2=sign:2; MVF=0; }
:"MR = MR +" MACX "*" MACY "(UU)" is type9=4 & z18=0 & amf5=11 & MACX & MACY & mid4=0 & cond4=15
{ local x:8=zext(MACX); local y:8=zext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; }
:MF "=" MACX "*" MACY "(SS)" is type9=4 & z18=1 & amf5=4 & MACX & MACY & mid4=0 & cond4=15
{ local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y; MF=prod[16,16]; MVF=0; }
:AF "=" ALUY "+ 1" is type9=4 & z18=1 & amf5=17 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AF=y+1; alu_flags_add(y,1:2,AF); }
:AF "=" ALUY "- 1" is type9=4 & z18=1 & amf5=24 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AF=y-1; alu_flags_sub(y,1:2,AF); }
:AR "=" "-" ALUY is type9=4 & z18=0 & amf5=21 & ALUY & mid4=0 & cond4=15
{ local y:2=ALUY; AR=0-y; alu_flags_sub(0:2,y,AR); }

:AR "=" "NOT" ALUX is type9=4 & z18=0 & amf5=27 & ALUX & mid4=0 & cond4=15
{ AR=~ALUX; alu_flags_logic(AR); }
:AF "=" ALUX "XOR" ALUY is type9=4 & z18=1 & amf5=30 & ALUX & ALUY & mid4=0 & cond4=15
{ AF=ALUX^ALUY; alu_flags_logic(AF); }
:AR "=" ALUX "XOR" AluConst is type9=4 & z18=0 & amf5=30 & ALUX & AluConst & cond4=15
{ AR=ALUX^AluConst; alu_flags_logic(AR); }

# Type 9 conditional forms reached after deeper flow expansion.
:"IF NE" "AR" "=" AluConst is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=16 & AluConst & cond4=1
{ if(AZF!=0) goto inst_next; AR=AluConst; alu_flags_logic(AR); }
:"IF NE" "AR" "=" AluConst is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=16 & AluConst & cond4=1
{ if(AZF!=0) goto <arch_condition_skipped>; AR=AluConst; alu_flags_logic(AR);
