{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; dsp_mac_round_xy(MACX,MACY); local word:3=(zext(stored)<<8)|(zext(PX)&0xff); *[PM]:3 a=word; DagI=a+m; }
:"MR =" MACX "*" MACY "(SS)," "PM(" DagI "," DagM ")" "=" DReg4 is op4=5 & d19=1 & z18=0 & amf5=4 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:4=sext(MACX); local y:4=sext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <deep_t5ss_d>; MR2=0xffff; <deep_t5ss_d> local word:3=(zext(stored)<<8)|(zext(PX)&0xff); *[PM]:3 a=word; DagI=a+m; MVF=0; }
:AR "=" ALUX "-" ALUY "," "PM(" DagI "," DagM ")" "=" DReg4 is op4=5 & d19=1 & z18=0 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AR=x-y; local word:3=(zext(stored)<<8)|(zext(PX)&0xff); *[PM]:3 a=word; DagI=a+m; alu_flags_sub(x,y,AR); }

