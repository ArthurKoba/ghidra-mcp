# Opt-in for an exactly proven negative SE at a specific instruction address.
# Context is not inferred from the mnemonic: the generic dynamic-SE semantics
# below stay the default. This constructor is safe only where native trace
# establishes SE<0 and no intervening write/call can change the register.
:SR "=" "ASHIFT" ShiftX "(HI)," "DM(" ShiftDagI "," ShiftDagM ")" "=" DReg4 is codec_se_proven_negative=1 & type12=9 & shift_d=1 & sf4=4 & ShiftX & DReg4 & ShiftDagI & ShiftDagM & ShiftDmAddress & ShiftDagL
{
    local addr:2 = ShiftDagI;
    local step:2 = ShiftDagM;
    local stored:2 = DReg4;
    local src:4 = sext(ShiftX) << 16;
    local magnitude:2 = -SE;
    local res:4 = src s>> magnitude;
    SR0 = res:2;
    SR1 = res[16,16];
    *[DM]:2 ShiftDmAddress = stored;
    dsp_dag_postmodify(ShiftDagI, addr, step, ShiftDagL);
}

:SR "=" "ASHIFT" ShiftX "(HI)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is codec_se_proven_negative=1 & type12=9 & shift_d=0 & sf4=4 & ShiftX & DReg4 & ShiftDagI & ShiftDagM & ShiftDmAddress & ShiftDagL
{
    local addr:2 = ShiftDagI;
    local step:2 = ShiftDagM;
    local fetched:2 = *[DM]:2 ShiftDmAddress;
    local src:4 = sext(ShiftX) << 16;
    local magnitude:2 = -SE;
    local res:4 = src s>> magnitude;
    SR0 = res:2;
    SR1 = res[16,16];
    DReg4 = fetched;
    dsp_dag_postmodify(ShiftDagI, addr, step, ShiftDagL);
}

:SR "=" "ASHIFT" ShiftX "(LO)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is codec_se_proven_negative=1 & type12=9 & shift_d=0 & sf4=6 & ShiftX & DReg4 & ShiftDagI & ShiftDagM & ShiftDmAddress & ShiftDagL
{
