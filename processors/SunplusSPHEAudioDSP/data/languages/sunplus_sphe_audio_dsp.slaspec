# Non-CE predicated register move: preserve the existing CE-end fallback until
# its conditional execution/loop-update interaction has separate proof.
:"IF LT" "AR" "=" ALUY is codec_ce_loop_end=0 & type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=4
{
    # Capture the old condition before selecting every affected destination.
    # A false predicate preserves complete flag bytes, not only bit zero.
    local take:1 = (ANF != AVF);
    local flagmask:1 = -take;
    local wordmask:2 = -zext(take);
    local y:2 = ALUY;
    AR = (AR & ~wordmask) | (y & wordmask);
    AZF = (AZF & ~flagmask) | ((y == 0) & flagmask);
    ANF = (ANF & ~flagmask) | ((y s< 0) & flagmask);
    AVF = AVF & ~flagmask;
}
:"IF LT" "AR" "=" ALUY is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=4
{ if (ANF == AVF) goto inst_next; AR=ALUY; alu_flags_logic(AR); }
:"IF LT" "AR" "=" ALUY is codec_arch_stack_mode=1 & type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=4
{ if (ANF == AVF) goto <arch_condition_skipped>; AR=ALUY; alu_flags_logic(AR);
<arch_condition_skipped>
}
:"IF EQ" "AR" "=" ALUY "+ 1" is codec_arch_stack_mode=0 & type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=0
{ if (AZF == 0) goto inst_next; local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }
