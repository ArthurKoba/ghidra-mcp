{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur-prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; *[DM]:2 a=stored; DagI=a+m; }
