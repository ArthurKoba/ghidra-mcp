    local step:2 = ShiftDagM;
    local fetched:2 = *[DM]:2 ShiftDmAddress;
    local src:4 = sext(ShiftX);
    local magnitude:2 = -SE;
    local res:4 = src s>> magnitude;
    SR0 = res:2;
    SR1 = res[16,16];
    DReg4 = fetched;
    dsp_dag_postmodify(ShiftDagI, addr, step, ShiftDagL);
}

# Proven-negative SE in native register-parallel ASHIFT (LO): the default
# remains the dynamic signed-count branch. This is selected ONLY with the
# instruction-scoped, externally verified codec_se_proven_negative context.
# Read DReg before writing DReg4, preserving DSP parallel-data semantics.
:SR "=" "ASHIFT" ShiftX "(LO)," DReg4 "=" DReg is codec_se_proven_negative=1 & op8=0x10 & sf4=6 & ShiftX & DReg4 & DReg
{
    local moved:2 = DReg;
    local src:4 = sext(ShiftX);
    local magnitude:2 = -SE;
    local result:4 = src s>> magnitude;
    SR0 = result:2;
    SR1 = result[16,16];
    DReg4 = moved;
}

