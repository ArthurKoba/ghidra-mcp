{ local a:2=ShiftDagI; local m:2=ShiftDagM; local stored:2=DReg4; local src:4=sext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <t12awh_r>; res=src<<count; goto <t12awh_d>; <t12awh_r> count=-count; res=src s>>count; <t12awh_d> SR0=res:2; SR1=res[16,16]; *[DM]:2 ShiftDmAddress=stored; dsp_dag_postmodify(ShiftDagI, a, m, ShiftDagL); }
:SR "=" "ASHIFT" ShiftX "(LO)," "DM(" ShiftDagI "," ShiftDagM ")" "=" DReg4 is type12=9 & shift_d=1 & sf4=6 & ShiftX & DReg4 & ShiftDagI & ShiftDagM & ShiftDmAddress & ShiftDagL
