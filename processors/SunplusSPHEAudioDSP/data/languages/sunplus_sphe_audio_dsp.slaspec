{ local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 ShiftDmAddress; local src:4=zext(ShiftX)<<16; local count:2=SE; local res:4=src; if(count s<0) goto <t12lhi_r>; res=src<<count; goto <t12lhi_d>; <t12lhi_r> count=-count; res=src>>count; <t12lhi_d> SR0=res:2; SR1=res[16,16]; DReg4=fetched; dsp_dag_postmodify(ShiftDagI, a, m, ShiftDagL); }
