:"MR = MR +" MACX "*" MACY "(RND)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=2 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM
{ local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da; dsp_mac_acc_round_xy(MACX,MACY); PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm; }
:"MR = MR -" MACX "*" MACY "(RND)," PDReg "=" "PM(" PmI "," PmM ")," DDReg "=" "DM(" DmI "," DmM ")" is t1_type=3 & amf5=3 & MACX & MACY & PDReg & DDReg & PmI & PmM & DmI & DmM
{ local pa:2=PmI; local pm:2=PmM; local da:2=DmI; local dm:2=DmM; local pw:3=*[PM]:3 pa; local dv:2=*[DM]:2 da; dsp_mac_sub_round_xy(MACX,MACY); PDReg=pw[8,16]; PX=zext(pw[0,8]); DDReg=dv; PmI=pa+pm; DmI=da+dm; }


# Final reachable codec-profile ALU/MAC + memory forms.
:AF "=" ALUX "+" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=1 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AF=x+y; *[DM]:2 a=stored; DagI=a+m; alu_flags_add(x,y,AF); }
:"MR = MR +" MACX "*" MACY "(RND)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=2 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; dsp_mac_acc_round_xy(MACX,MACY); *[DM]:2 a=stored; DagI=a+m; }
:AF "=" ALUX "-" ALUY "," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=1 & amf5=23 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AF=x-y; *[DM]:2 a=stored; DagI=a+m; alu_flags_sub(x,y,AF); }
:"MR =" MACX "*" MACY "(SU)," "DM(" DagI "," DagM ")" "=" DReg4 is type3=3 & d19=1 & z18=0 & amf5=5 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:4=sext(MACX); local y:4=zext(MACY); local prod:4=x*y; MR0=prod:2; MR1=prod[16,16]; MR2=0; if(prod s>=0) goto <final_t4su_d>; MR2=0xffff; <final_t4su_d> *[DM]:2 a=stored; DagI=a+m; MVF=0; }

:AR "=" ALUY "-" ALUX "," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=25 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local y:2=ALUY; local x:2=ALUX; AR=y-x; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; alu_flags_sub(y,x,AR); }
:"MR = MR -" MACX "*" MACY "(RND)," DReg4 "=" "PM(" DagI "," DagM ")" is op4=5 & d19=0 & z18=0 & amf5=3 & MACX & MACY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; dsp_mac_sub_round_xy(MACX,MACY); DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m; }
:AR "=" ALUX "+" ALUY "," "PM(" DagI "," DagM ")" "=" DReg4 is op4=5 & d19=1 & z18=0 & amf5=19 & ALUX & ALUY & DReg4 & DagI & DagM
{ local a:2=DagI; local m:2=DagM; local stored:2=DReg4; local x:2=ALUX; local y:2=ALUY; AR=x+y; local word:3=(zext(stored)<<8)|(zext(PX)&0xff); *[PM]:3 a=word; DagI=a+m; alu_flags_add(x,y,AR); }

:"MF = MR +" MACX "*" MACY "(SS)" is type9=4 & z18=1 & amf5=8 & MACX & MACY & mid4=0 & cond4=15
{ local x:8=sext(MACX); local y:8=sext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MF=res[16,16]; }
:"MF =" MACX "*" MACY "(RND)" is type9=4 & z18=1 & amf5=1 & MACX & MACY & mid4=0 & cond4=15
{ dsp_mac_round_mf_xy(MACX,MACY); }
:"MR = MR +" MACX "*" MACY "(SU)" is type9=4 & z18=0 & amf5=9 & MACX & MACY & mid4=0 & cond4=15
{ local x:8=sext(MACX); local y:8=zext(MACY); local prod:8=x*y; local cur:8=(zext(MR2)<<32)|(zext(MR1)<<16)|zext(MR0); local res:8=cur+prod; MR0=res:2; MR1=res[16,16]; MR2=res[32,16]; }
:"IF LE" "AR" "=" ALUY "+ 1" is type9=4 & z18=0 & amf5=17 & ALUY & mid4=0 & cond4=3
{ local take:1=(AZF!=0)||(ANF!=AVF); if(take==0) goto inst_next; local y:2=ALUY; AR=y+1; alu_flags_add(y,1:2,AR); }
:"IF AC" "AR" "=" ALUY is type9=4 & z18=0 & amf5=16 & ALUY & mid4=0 & cond4=8
{ if(ACF==0) goto inst_next; AR=ALUY; alu_flags_logic(AR); }
:"IF EQ" "AR" "=" ALUX "AND" AluConst is type9=4 & z18=0 & amf5=28 & ALUX & AluConst & cond4=0
{ if(AZF==0) goto inst_next; AR=ALUX&AluConst; alu_flags_logic(AR); }
:"IF NE" "AR" "=" ALUY "-" ALUX is type9=4 & z18=0 & amf5=25 & ALUX & ALUY & mid4=0 & cond4=1
{ if(AZF!=0) goto inst_next; local y:2=ALUY; local x:2=ALUX; AR=y-x; alu_flags_sub(y,x,AR); }
:"IF LT" "AR" "=" ALUX "+" AluConst is type9=4 & z18=0 & amf5=19 & ALUX & AluConst & cond4=4
{ if(ANF==AVF) goto inst_next; local x:2=ALUX; local c:2=AluConst; AR=x+c; alu_flags_add(x,c,AR); }
:"IF NOT AV" "AR" "=" ALUX "OR" ALUY is type9=4 & z18=0 & amf5=29 & ALUX & ALUY & mid4=0 & cond4=7
{ if(AVF!=0) goto inst_next; AR=ALUX|ALUY; alu_flags_logic(AR); }

# -----------------------------------------------------------------------------
# Type 10 flow control.  srvdsp uses NE, GT, LT, and ALWAYS.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Resident PM handoff.
#
# srvdsp is a wrapper image loaded at PM:0x1800. Several terminal/conditional
# jumps hand control to resident DSP firmware below that window. Those bytes are
# not present in srvdsp.bin, so model the handoff as an opaque userop rather than
# inventing resident instructions or making the decompiler chase unmapped PM.
# The numeric target remains explicit in P-code/C output.
# -----------------------------------------------------------------------------

define pcodeop dsp_resident_tailcall;

macro resident_tail(target) {
    dsp_resident_tailcall(target);
    return [PCSTACKTOP];
}

# Unconditional resident targets observed in the srvdsp corpus.
:JUMP_RESIDENT_00E0 is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x00e0 & cond4=15 { resident_tail(0x00e0:2); }
:JUMP_RESIDENT_0036 is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0036 & cond4=15 { resident_tail(0x0036:2); }
:JUMP_RESIDENT_0539 is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0539 & cond4=15 { resident_tail(0x0539:2); }
:JUMP_RESIDENT_05A4 is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x05a4 & cond4=15 { resident_tail(0x05a4:2); }
:JUMP_RESIDENT_08ED is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x08ed & cond4=15 { resident_tail(0x08ed:2); }
:JUMP_RESIDENT_0EBB is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0ebb & cond4=15 { resident_tail(0x0ebb:2); }
:JUMP_RESIDENT_04BC is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x04bc & cond4=15 { resident_tail(0x04bc:2); }
:JUMP_RESIDENT_092C is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x092c & cond4=15 { resident_tail(0x092c:2); }
:JUMP_RESIDENT_0398 is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0398 & cond4=15 { resident_tail(0x0398:2); }
:JUMP_RESIDENT_10C5 is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x10c5 & cond4=15 { resident_tail(0x10c5:2); }
:JUMP_RESIDENT_0231 is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0231 & cond4=15 { resident_tail(0x0231:2); }

# Conditional resident handoffs used by srvdsp.
:"IF GT JUMP_RESIDENT_0539" is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0539 & cond4=2
{
    local gt:1 = (AZF == 0) && (ANF == AVF);
    if (gt == 0) goto inst_next;
    resident_tail(0x0539:2);
}

:"IF LT JUMP_RESIDENT_0539" is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0539 & cond4=4
{
    if (ANF == AVF) goto inst_next;
    resident_tail(0x0539:2);
}

:"IF NE JUMP_RESIDENT_0D04" is srvdsp_wrapper_mode=1 & type10=3 & call18=0 & addr14=0x0d04 & cond4=1
{
    if (AZF != 0) goto inst_next;
    resident_tail(0x0d04:2);
}

:JUMP JumpAddr is type10=3 & call18=0 & cond4=15 & JumpAddr
{
    goto JumpAddr;
}

:CALL JumpAddr is type10=3 & call18=1 & cond4=15 & JumpAddr
{
    call JumpAddr;
}

:"IF EQ JUMP" JumpAddr is type10=3 & call18=0 & cond4=0 & JumpAddr
{
    if (AZF != 0) goto JumpAddr;
}

:"IF NE JUMP" JumpAddr is type10=3 & call18=0 & cond4=1 & JumpAddr
{
    if (AZF == 0) goto JumpAddr;
}

:"IF GT JUMP" JumpAddr is type10=3 & call18=0 & cond4=2 & JumpAddr
{
    if (AZF != 0) goto <gt_fallthrough>;
    if (ANF == AVF) goto JumpAddr;
<gt_fallthrough>
}


:"IF LE JUMP" JumpAddr is type10=3 & call18=0 & cond4=3 & JumpAddr
{
    local le:1 = (AZF != 0) || (ANF != AVF);
    if (le != 0) goto JumpAddr;
}

:"IF NE CALL" JumpAddr is type10=3 & call18=1 & cond4=1 & JumpAddr
{
    if (AZF != 0) goto inst_next;
    call JumpAddr;
}

:"IF LT JUMP" JumpAddr is type10=3 & call18=0 & cond4=4 & JumpAddr
{
    if (ANF != AVF) goto JumpAddr;
}

:"IF NEG JUMP" JumpAddr is type10=3 & call18=0 & cond4=10 & JumpAddr
{
    if (ASF != 0) goto JumpAddr;
}

:"IF POS JUMP" JumpAddr is type10=3 & call18=0 & cond4=11 & JumpAddr
{
    if (ASF == 0) goto JumpAddr;
}

:"IF GE JUMP" JumpAddr is type10=3 & call18=0 & cond4=5 & JumpAddr
{
    if (ANF == AVF) goto JumpAddr;
}

:"IF GT CALL" JumpAddr is type10=3 & call18=1 & cond4=2 & JumpAddr
{
    if(AZF!=0) goto inst_next;
    if(ANF!=AVF) goto inst_next;
    call JumpAddr;
}

:"IF LT CALL" JumpAddr is type10=3 & call18=1 & cond4=4 & JumpAddr
{
    if (ANF == AVF) goto inst_next;
    call JumpAddr;
}

:"IF EQ CALL" JumpAddr is type10=3 & call18=1 & cond4=0 & JumpAddr
{
    if (AZF == 0) goto inst_next;
    call JumpAddr;
}

# -----------------------------------------------------------------------------
# Type 11 zero-overhead loop setup.
#
# The canonical srvdsp corpus contains one proven CE loop:
#   DO PM:186C UNTIL CE
# followed by the single loop-body/end instruction at PM:186C. Mark that
# instruction with decode context. Its specialized DMWRITE constructor above
# emits the CNTR decrement/back-edge, allowing the behavior engine to recover
# a real loop instead of an opaque userop. Other DO targets intentionally stay
# unsupported until observed in corpus.
# -----------------------------------------------------------------------------


:"DO" LoopAddr "UNTIL CE" is srvdsp_wrapper_mode=0 & type11=5 & term4=14 & LoopAddr
{
    dsp_do_until_ce(LoopAddr);
}

:"DO" LoopAddr "UNTIL CE" is srvdsp_wrapper_mode=1 & type11=5 & loop14=0x186c & term4=14 & LoopAddr
    [ srvdsp_ce_loop_end=1; globalset(LoopAddr, srvdsp_ce_loop_end); ]
{
}

# -----------------------------------------------------------------------------
# Type 12/13 shift+memory forms reached by codec profiles.
# -----------------------------------------------------------------------------

:SR "=" "ASHIFT" ShiftX "(HI)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=4 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{
    local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 a; local src:4=sext(ShiftX)<<16; local count:2=SE; local res:4=src;
    if (count s<0) goto <t12ahi_r>; res=src<<count; goto <t12ahi_d>;
<t12ahi_r> count=-count; res=src s>>count;
<t12ahi_d> SR0=res:2; SR1=res[16,16]; DReg4=fetched; ShiftDagI=a+m;
}
:SR "=" "ASHIFT" ShiftX "(LO)," DReg4 "=" "DM(" ShiftDagI "," ShiftDagM ")" is type12=9 & shift_d=0 & sf4=6 & ShiftX & DReg4 & ShiftDagI & ShiftDagM
{
    local a:2=ShiftDagI; local m:2=ShiftDagM; local fetched:2=*[DM]:2 a; local src:4=sext(ShiftX); local count:2=SE; local res:4=src;
    if (count s<0) goto <t12alo_r>; res=src<<count; goto <t12alo_d>;
<t12alo_r> count=-count; res=src s>>count;
<t12alo_d> SR0=res:2; SR1=res[16,16]; DReg4=fetched; ShiftDagI=a+m;
}
:SR "=" "LSHIFT" ShiftX "(LO)," DReg4 "=" "PM(" DagI "," DagM ")" is op8=0x11 & shift_d=0 & sf4=2 & ShiftX & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local src:4=zext(ShiftX); local count:2=SE; local res:4=src;
    if (count s<0) goto <t13l_r>; res=src<<count; goto <t13l_d>;
<t13l_r> count=-count; res=src>>count;
<t13l_d> SR0=res:2; SR1=res[16,16]; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m;
}


:SR "=" "SR OR LSHIFT" ShiftX "(LO)," DReg4 "=" "PM(" DagI "," DagM ")" is op8=0x11 & shift_d=0 & sf4=3 & ShiftX & DReg4 & DagI & DagM
{
    local a:2=DagI; local m:2=DagM; local word:3=*[PM]:3 a; local src:4=zext(ShiftX); local count:2=SE; local shifted:4=src;
    if(count s<0) goto <final_t13or_r>; shifted=src<<count; goto <final_t13or_d>;
<final_t13or_r> count=-count; shifted=src>>count;
<final_t13or_d> local old:4=(zext(SR1)<<16)|zext(SR0); local res:4=old|shifted; SR0=res:2; SR1=res[16,16]; DReg4=word[8,16]; PX=zext(word[0,8]); DagI=a+m;
}

# Immediate logical shift OR forms (SF=1/3).
:SR "=" "SR OR LSHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=1 & ShiftX & sexp8
{
    local src:4=zext(ShiftX)<<16; local count:1=sexp8; local shifted:4=src;
    if (count s<0) goto <t15ohi_r>; shifted=src<<count; goto <t15ohi_d>;
<t15ohi_r> count=-count; shifted=src>>count;
<t15ohi_d> local old:4=(zext(SR1)<<16)|zext(SR0); local res:4=old|shifted; SR0=res:2; SR1=res[16,16];
}
:SR "=" "SR OR LSHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=3 & ShiftX & sexp8
{
    local src:4=zext(ShiftX); local count:1=sexp8; local shifted:4=src;
    if (count s<0) goto <t15olo_r>; shifted=src<<count; goto <t15olo_d>;
<t15olo_r> count=-count; shifted=src>>count;
<t15olo_d> local old:4=(zext(SR1)<<16)|zext(SR0); local res:4=old|shifted; SR0=res:2; SR1=res[16,16];
}

# EXP(HI) is reference-identified; detailed SE/SS semantics remain explicit.
:"EXP(HI)" ShiftX is op8=0x0e & sf4=12 & ShiftX & mid4=0 & cond4=15
{ dsp_exp_hi(ShiftX); }

# Type 19 unconditional indirect flow. The observed corpus uses I4-I7.
:"JUMP (" JumpI ")" is op8=0x0b & ind_s=0 & cond4=15 & JumpI
{ goto [JumpI]; }
:"CALL (" JumpI ")" is op8=0x0b & ind_s=1 & cond4=15 & JumpI
{ call [JumpI]; }

# -----------------------------------------------------------------------------
# Type 14/16 codec-profile shifter forms.  Non-immediate shifts use SE.
# These are limited to the LO variants exercised in the current corpus.
# -----------------------------------------------------------------------------

:SR "=" "LSHIFT" ShiftX "(LO)," DReg4 "=" DReg is op8=0x10 & sf4=2 & ShiftX & DReg4 & DReg
{
    local src:4 = zext(ShiftX);
    local moved:2 = DReg;
    local count:2 = SE;
    local res:4 = src;
    if (count s< 0) goto <t14_lsh_right>;
    res = src << count;
    goto <t14_lsh_done>;
<t14_lsh_right>
    count = -count;
    res = src >> count;
<t14_lsh_done>
    SR0 = res:2;
    SR1 = res[16,16];
    DReg4 = moved;
}

:SR "=" "LSHIFT" ShiftX "(LO)" is op8=0x0e & sf4=2 & ShiftX & mid4=0 & cond4=15
{
    local src:4 = zext(ShiftX);
    local count:2 = SE;
    local res:4 = src;
    if (count s< 0) goto <t16_lsh_right>;
    res = src << count;
    goto <t16_lsh_done>;
<t16_lsh_right>
    count = -count;
    res = src >> count;
<t16_lsh_done>
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "SR OR LSHIFT" ShiftX "(LO)" is op8=0x0e & sf4=3 & ShiftX & mid4=0 & cond4=15
{
    local src:4 = zext(ShiftX);
    local count:2 = SE;
    local shifted:4 = src;
    if (count s< 0) goto <t16_or_right>;
    shifted = src << count;
    goto <t16_or_done>;
<t16_or_right>
    count = -count;
    shifted = src >> count;
<t16_or_done>
    local oldsr:4 = (zext(SR1) << 16) | zext(SR0);
    local res:4 = oldsr | shifted;
    SR0 = res:2;
    SR1 = res[16,16];
}

# -----------------------------------------------------------------------------
# Type 15 immediate shifter.  srvdsp uses ASHIFT (LO) MR1 BY +4.
# -----------------------------------------------------------------------------

:SR "=" "ASHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=4 & ShiftX & sexp8
{
    local src:4 = sext(ShiftX) << 16;
    local count:1 = sexp8;
    local res:4 = src;
    if (count s< 0) goto <ash_hi_right>;
    res = src << count;
    goto <ash_hi_done>;
<ash_hi_right>
    count = -count;
    res = src s>> count;
<ash_hi_done>
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "ASHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=6 & ShiftX & sexp8
{
    local src:4 = sext(ShiftX);
    local count:1 = sexp8;
    local res:4 = src;
    if (count s< 0) goto <ash_lo_right>;
    res = src << count;
    goto <ash_lo_done>;
<ash_lo_right>
    count = -count;
    res = src s>> count;
<ash_lo_done>
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "LSHIFT" ShiftX "BY" sexp8 "(HI)" is type15=0x1e & sf4=0 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX) << 16;
    local count:1 = sexp8;
    local res:4 = src;
    if (count s< 0) goto <lsh_hi_right>;
    res = src << count;
    goto <lsh_hi_done>;
<lsh_hi_right>
    count = -count;
    res = src >> count;
<lsh_hi_done>
    SR0 = res:2;
    SR1 = res[16,16];
}

:SR "=" "LSHIFT" ShiftX "BY" sexp8 "(LO)" is type15=0x1e & sf4=2 & ShiftX & sexp8
{
    local src:4 = zext(ShiftX);
    local count:1 = sexp8;
    local res:4 = src;
    if (count s< 0) goto <lsh_lo_right>;
    res = src << count;
    goto <lsh_lo_done>;
<lsh_lo_right>
    count = -count;
    res = src >> count;
<lsh_lo_done>
    SR0 = res:2;
    SR1 = res[16,16];
}


# Type 23/24 division steps. AQF models the architectural AQ quotient bit.
:DIVS DivY "," DivX is op8=0x06 & divs_fixed3=0 & DivY & DivX & sexp8=0
{
    local divisor:2=DivY;
    local upper:2=DivX;
    local oldq:2=AY0;
    AQF=((upper s<0) != (divisor s<0));
    local newupper:2=(upper<<1)|(oldq>>15);
    DivX=newupper;
    AY0=oldq<<1;
}
:DIVQ DivX is op8=0x07 & divq_fixed5=2 & DivX & sexp8=0
{
    local divisor:2=DivX;
    local upper:2=AF;
    local oldq:2=AY0;
    local partial:2=upper;
    if(AQF!=0) goto <divq_add>;
    partial=upper-divisor;
    goto <divq_calc>;
<divq_add> partial=upper+divisor;
<divq_calc>
    local newaq:1=((partial s<0)!=(divisor s<0));
    AF=(partial<<1)|(oldq>>15);
    AY0=(oldq<<1)|zext(newaq==0);
    AQF=newaq;
}

# -----------------------------------------------------------------------------
# Type 17 internal data-register move.
# -----------------------------------------------------------------------------

:"" IntDst "=" IntSrc is type17=0x0d0 & IntDst & IntSrc
{
    IntDst = IntSrc;
}

# Target-observed mode/interrupt controls.
:DIS_AR_SAT is whole24=0x0c0800 { MSTAT = MSTAT & 0xfff7; }
:ENA_AR_SAT is whole24=0x0c0c00 { MSTAT = MSTAT | 0x0008; }
:ENA_SEC_REG is whole24=0x0c0030 { MSTAT = MSTAT | 0x0001; }
:DIS_SEC_REG is whole24=0x0c0020 { MSTAT = MSTAT & 0xfffe; }
:DIS_G_MODE is whole24=0x0c0080 { MSTAT = MSTAT & 0xffbf; }
:ENA_G_MODE is whole24=0x0c00c0 { MSTAT = MSTAT | 0x0040; }
:DIS_INTS is whole24=0x040040 { dsp_interrupt_disable(); }
:ENA_INTS is whole24=0x040060 { dsp_interrupt_enable(); }

# Reference-defined mode controls exercised by codec profiles.
:DIS_M_MODE is whole24=0x0c2000 { MSTAT = MSTAT & 0xffef; }
:ENA_M_MODE is whole24=0x0c3000 { MSTAT = MSTAT | 0x0010; }
:DIS_TIMER is whole24=0x0c8000 { MSTAT = MSTAT & 0xffdf; }
:ENA_TIMER is whole24=0x0cc000 { MSTAT = MSTAT | 0x0020; }

# Type 21 MODIFY.  Circular-buffer modulus details are not represented by the
# current register-only model; this matches the linear/post-modify behavior
# already used by the modeled DAG memory-access forms.
:"MODIFY(" ModI "," ModM ")" is op8=0x09 & mod_zero11=0 & ModI & ModM
{
    ModI = ModI + ModM;
}

# Type 26 exact stack-control word observed in AC-3: POP every architected
# stack class.  Stack backing stores are not modeled, so preserve each effect
# explicitly rather than pretending the pops are no-ops.
:"POP STS, POP CNTR, POP PC, POP LOOP" is whole24=0x04001f
{
    dsp_pop_status_stack();
    dsp_pop_counter_stack();
    dsp_pop_pc_stack();
    dsp_pop_loop_stack();
}

# -----------------------------------------------------------------------------
# Type 20 returns used by srvdsp.
# -----------------------------------------------------------------------------

:RTS is ret19=0x5000 & rettype=0 & cond4=15
{
    return [PCSTACKTOP];
}

:RTI is ret19=0x5000 & rettype=1 & cond4=15
{
    dsp_rti_restore_status();
    return [PCSTACKTOP];
}

:"IF EQ RTS" is ret19=0x5000 & rettype=0 & cond4=0
{
    if (AZF == 0) goto inst_next;
    return [PCSTACKTOP];
}

:"IF GT RTS" is ret19=0x5000 & rettype=0 & cond4=2
{
    if (AZF != 0) goto inst_next;
    if (ANF != AVF) goto inst_next;
    return [PCSTACKTOP];
}

:"IF LT RTS" is ret19=0x5000 & rettype=0 & cond4=4
{
    if (ANF == AVF) goto inst_next;
    return [PCSTACKTOP];
}

:"IF NE RTS" is ret19=0x5000 & rettype=0 & cond4=1
{
    if (AZF != 0) goto inst_next;
    return [PCSTACKTOP];
}

:"IF GE RTS" is ret19=0x5000 & rettype=0 & cond4=5
{
    if (ANF != AVF) goto inst_next;
    return [PCSTACKTOP];
}


# Exact core-control forms observed in codec profiles. Detailed architectural
# side effects remain explicit userops until the full MR/status model is present.
:SAT_MR is whole24=0x050000 { dsp_saturate_mr(); }
:IDLE is whole24=0x028000 { dsp_idle(); }

# -----------------------------------------------------------------------------
# Type 29 I/O-space read/write.
# -----------------------------------------------------------------------------

:IOWRITE ioaddr, IODReg is type29=1 & iodir=1 & ioaddr & IODReg
{
    local a:2 = ioaddr;
    *[IO]:2 a = IODReg;
}

:IOREAD IODReg, ioaddr is type29=1 & iodir=0 & ioaddr & IODReg
{
    local a:2 = ioaddr;
    IODReg = *[IO]:2 a;
}

:NOP is whole24=0x000000
{
}
