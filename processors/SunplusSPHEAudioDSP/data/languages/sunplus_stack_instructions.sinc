# Native instruction constructors for the executable software sequencer.
ArchCond: "IF EQ " is cond4=0 { local ok:1=0; arch_test_condition(0:2,ok); export ok; }
ArchCond: "IF NE " is cond4=1 { local ok:1=0; arch_test_condition(1:2,ok); export ok; }
ArchCond: "IF GT " is cond4=2 { local ok:1=0; arch_test_condition(2:2,ok); export ok; }
