:orri rd32,ra32,UImm14 is p_lo=1 & p_hi=1 & major32=13 & cu=0 & rd32 & ra32 & UImm14 { rd32=ra32 | UImm14; }
:orri.c rd32,ra32,UImm14 is p_lo=1 & p_hi=1 & major32=13 & cu=1 & rd32 & ra32 & UImm14 { rd32=ra32 | UImm14; score_set_zn(rd32); }

# LS forms major 16..23
:lw rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=16 & rd32 & ra32 & SImm15 { local a:4=(ra32+SImm15)&0xfffffffc; rd32=*:4 a; }
:lh rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=17 & rd32 & ra32 & SImm15 { local a:4=(ra32+SImm15)&0xfffffffe; local v:2=*:2 a; rd32=sext(v); }
:lhu rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=18 & rd32 & ra32 & SImm15 { local a:4=(ra32+SImm15)&0xfffffffe; local v:2=*:2 a; rd32=zext(v); }
:lb rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=19 & rd32 & ra32 & SImm15 { local a:4=ra32+SImm15; local v:1=*:1 a; rd32=sext(v); }
:sw rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=20 & rd32 & ra32 & SImm15 { local a:4=(ra32+SImm15)&0xfffffffc; *:4 a=rd32; }
:sh rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=21 & rd32 & ra32 & SImm15 { local a:4=(ra32+SImm15)&0xfffffffe; local v:2=rd32:2; *:2 a=v; }
:lbu rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=22 & rd32 & ra32 & SImm15 { local a:4=ra32+SImm15; local v:1=*:1 a; rd32=zext(v); }
:sb rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=23 & rd32 & ra32 & SImm15 { local a:4=ra32+SImm15; local v:1=rd32:1; *:1 a=v; }

:cache rd32,ra32,SImm15 is p_lo=1 & p_hi=1 & major32=24 & rd32 & ra32 & SImm15 { score_cache(); }
:cenew is p_lo=1 & p_hi=1 & major32=28 { score_cenew(); }

# ===========================================================================
# 16-bit instructions (p16 == 0)
# ===========================================================================

:nop! is p16=0 & op16=0 & func16=0 { }
:mlfh! rd16,ra16 is p16=0 & op16=0 & func16=1 & rd16 & ra16 { rd16 = ra16; }
:mhfl! rd16,ra16 is p16=0 & op16=0 & func16=2 & rd16 & ra16 { rd16 = ra16; }
:mv! rd16,ra16 is p16=0 & op16=0 & func16=3 & rd16 & ra16 { rd16=ra16; }
:sll! rd16,ra16 is p16=0 & op16=0 & func16=8 & rd16 & ra16 { local sh:4=ra16&31; rd16=rd16<<sh; }
:addc! rd16,ra16 is p16=0 & op16=0 & func16=9 & rd16 & ra16 { local c:4=(cr1>>1)&1; rd16=rd16+ra16+c; }
:srl! rd16,ra16 is p16=0 & op16=0 & func16=10 & rd16 & ra16 { local sh:4=ra16&31; rd16=rd16>>sh; }
:sra! rd16,ra16 is p16=0 & op16=0 & func16=11 & rd16 & ra16 { local sh:4=ra16&31; rd16=rd16 s>> sh; }

:add! rd16,ra16 is p16=0 & op16=2 & func16=0 & rd16 & ra16 { local old:4=rd16; local result:4=old+ra16; score_set_add_flags(old,ra16,result); rd16=result; }
:sub! rd16,ra16 is p16=0 & op16=2 & func16=1 & rd16 & ra16 { local old:4=rd16; local result:4=old-ra16; score_set_sub_flags(old,ra16,result); rd16=result; }
:neg! rd16,ra16 is p16=0 & op16=2 & func16=2 & rd16 & ra16 { local result:4=0-ra16; score_set_sub_flags(0:4,ra16,result); rd16=result; }
:cmp! rd16,ra16 is p16=0 & op16=2 & func16=3 & rd16 & ra16 { local result:4=rd16-ra16; score_set_sub_flags(rd16,ra16,result); }
:and! rd16,ra16 is p16=0 & op16=2 & func16=4 & rd16 & ra16 { rd16=rd16&ra16; score_set_zn(rd16); }
:or! rd16,ra16 is p16=0 & op16=2 & func16=5 & rd16 & ra16 { rd16=rd16|ra16; score_set_zn(rd16); }
:not! rd16,ra16 is p16=0 & op16=2 & func16=6 & rd16 & ra16 { rd16=~ra16; score_set_zn(rd16); }
:xor! rd16,ra16 is p16=0 & op16=2 & func16=7 & rd16 & ra16 { rd16=rd16^ra16; score_set_zn(rd16); }
:lw! rd16,ra16 is p16=0 & op16=2 & func16=8 & rd16 & ra16 { local a:4=ra16&0xfffffffc; rd16=*:4 a; }
:lh! rd16,ra16 is p16=0 & op16=2 & func16=9 & rd16 & ra16 { local a:4=ra16&0xfffffffe; local v:2=*:2 a; rd16=sext(v); }
:lbu! rd16,ra16 is p16=0 & op16=2 & func16=11 & rd16 & ra16 { local v:1=*:1 ra16; rd16=zext(v); }
:sw! rd16,ra16 is p16=0 & op16=2 & func16=12 & rd16 & ra16 { local a:4=ra16&0xfffffffc; *:4 a=rd16; }
:sh! rd16,ra16 is p16=0 & op16=2 & func16=13 & rd16 & ra16 { local a:4=ra16&0xfffffffe; local v:2=rd16:2; *:2 a=v; }
:sb! rd16,ra16 is p16=0 & op16=2 & func16=15 & rd16 & ra16 { local v:1=rd16:1; *:1 ra16=v; }

:pop! PReg,preg_base is p16=0 & op16=2 & func16=10 & PReg & preg_base { local a:4=preg_base&0xfffffffc; PReg=*:4 a; preg_base=preg_base+4; }
:push! PReg,preg_base is p16=0 & op16=2 & func16=14 & PReg & preg_base { preg_base=preg_base-4; local a:4=preg_base&0xfffffffc; *:4 a=PReg; }

:j! JTarget16 is p16=0 & op16=3 & lk16=0 & JTarget16 { goto JTarget16; }
:jl! JTarget16 is p16=0 & op16=3 & lk16=1 & JTarget16 { ra=inst_next; call JTarget16; }

:ldiu! rd16,imm8 is p16=0 & op16=5 & rd16 & imm8 { rd16=imm8; }

:addei! rd16,imm4 is p16=0 & op16=6 & i16_func3=0 & imm_sign=0 & rd16 & imm4 { local delta:4=1 << imm4; rd16=rd16+delta; score_set_zn(rd16); }
:subei! rd16,imm4 is p16=0 & op16=6 & i16_func3=0 & imm_sign=1 & rd16 & imm4 { local delta:4=1 << imm4; rd16=rd16-delta; score_set_zn(rd16); }
:slli! rd16,imm5 is p16=0 & op16=6 & i16_func3=1 & rd16 & imm5 { rd16=rd16 << imm5; score_set_zn(rd16); }
:sdbbp! rd16 is p16=0 & op16=6 & i16_func3=2 & rd16 { score_debug_break(); }
:srli! rd16,imm5 is p16=0 & op16=6 & i16_func3=3 & rd16 & imm5 { rd16=rd16 >> imm5; score_set_zn(rd16); }
:bitclr! rd16,imm5 is p16=0 & op16=6 & i16_func3=4 & rd16 & imm5 { rd16=rd16 & ~(1 << imm5); score_set_zn(rd16); }
:bitset! rd16,imm5 is p16=0 & op16=6 & i16_func3=5 & rd16 & imm5 { rd16=rd16 | (1 << imm5); score_set_zn(rd16); }
:bittst! rd16,imm5 is p16=0 & op16=6 & i16_func3=6 & rd16 & imm5 { local v:4=rd16 & (1 << imm5); score_set_zn(v); }
:bittgl! rd16,imm5 is p16=0 & op16=6 & i16_func3=7 & rd16 & imm5 { rd16=rd16 ^ (1 << imm5); score_set_zn(rd16); }

:lwp! rd16,imm5 is p16=0 & op16=7 & i16_func3=0 & rd16 & imm5 { local a:4=(fp+(imm5<<2))&0xfffffffc; rd16=*:4 a; }
:lhp! rd16,imm5 is p16=0 & op16=7 & i16_func3=1 & rd16 & imm5 { local a:4=(fp+(imm5<<1))&0xfffffffe; local v:2=*:2 a; rd16=sext(v); }
:lbup! rd16,imm5 is p16=0 & op16=7 & i16_func3=3 & rd16 & imm5 { local a:4=fp+imm5; local v:1=*:1 a; rd16=zext(v); }
:swp! rd16,imm5 is p16=0 & op16=7 & i16_func3=4 & rd16 & imm5 { local a:4=(fp+(imm5<<2))&0xfffffffc; *:4 a=rd16; }
:shp! rd16,imm5 is p16=0 & op16=7 & i16_func3=5 & rd16 & imm5 { local a:4=(fp+(imm5<<1))&0xfffffffe; local v:2=rd16:2; *:2 a=v; }
:sbp! rd16,imm5 is p16=0 & op16=7 & i16_func3=7 & rd16 & imm5 { local a:4=fp+imm5; local v:1=rd16:1; *:1 a=v; }

