:ldi rd32,SImm16 is p_lo=1 & p_hi=1 & major32=1 & ifunc3=6 & rd32 & SImm16 { rd32=SImm16; }

# J-form major 2
:j JTarget32 is p_lo=1 & p_hi=1 & major32=2 & cu=0 & JTarget32 { goto JTarget32; }
:jl JTarget32 is p_lo=1 & p_hi=1 & major32=2 & cu=1 & JTarget32 { ra=inst_next; call JTarget32; }

# RIX pre-increment major 3
:lw rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=0 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local a:4=ra32 & 0xfffffffc; rd32=*:4 a; }
:lh rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=1 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local a:4=ra32 & 0xfffffffe; local v:2=*:2 a; rd32=sext(v); }
:lhu rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=2 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local a:4=ra32 & 0xfffffffe; local v:2=*:2 a; rd32=zext(v); }
:lb rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=3 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local v:1=*:1 ra32; rd32=sext(v); }
:sw rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=4 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local a:4=ra32 & 0xfffffffc; *:4 a=rd32; }
:sh rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=5 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local a:4=ra32 & 0xfffffffe; local v:2=rd32:2; *:2 a=v; }
:lbu rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=6 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local v:1=*:1 ra32; rd32=zext(v); }
:sb rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=3 & rix_func3=7 & rd32 & ra32 & SImm12 { ra32=ra32+SImm12; local v:1=rd32:1; *:1 ra32=v; }

# I-form-2 major 5
:addis rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=0 & cu=0 & rd32 & UImm16 { rd32=rd32+(UImm16<<16); }
:addis.c rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=0 & cu=1 & rd32 & UImm16 { local old:4=rd32; local imm:4=UImm16<<16; local result:4=old+imm; score_set_add_flags(old,imm,result); rd32=result; }
:cmpis.c rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=2 & cu=1 & rd32 & UImm16 { local imm:4=UImm16<<16; local result:4=rd32-imm; score_set_sub_flags(rd32,imm,result); }
:andis rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=4 & cu=0 & rd32 & UImm16 { rd32=rd32 & (UImm16<<16); }
:andis.c rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=4 & cu=1 & rd32 & UImm16 { rd32=rd32 & (UImm16<<16); score_set_zn(rd32); }
:oris rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=5 & cu=0 & rd32 & UImm16 { rd32=rd32 | (UImm16<<16); }
:oris.c rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=5 & cu=1 & rd32 & UImm16 { rd32=rd32 | (UImm16<<16); score_set_zn(rd32); }
:ldis rd32,UImm16 is p_lo=1 & p_hi=1 & major32=5 & ifunc3=6 & rd32 & UImm16 { rd32=UImm16<<16; }

# CR-form major 6
:mtcr rd32,cr_idx is p_lo=1 & p_hi=1 & major32=6 & cr_op=0 & rd32 & cr_idx { cr_idx=rd32; }
:mfcr rd32,cr_idx is p_lo=1 & p_hi=1 & major32=6 & cr_op=1 & rd32 & cr_idx { rd32=cr_idx; }
:rte is p_lo=1 & p_hi=1 & major32=6 & cr_op=0x84 { return [cr5]; }

# RIX post-increment major 7
:lw rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=0 & rd32 & ra32 & SImm12 { local a:4=ra32 & 0xfffffffc; rd32=*:4 a; ra32=ra32+SImm12; }
:lh rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=1 & rd32 & ra32 & SImm12 { local a:4=ra32 & 0xfffffffe; local v:2=*:2 a; rd32=sext(v); ra32=ra32+SImm12; }
:lhu rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=2 & rd32 & ra32 & SImm12 { local a:4=ra32 & 0xfffffffe; local v:2=*:2 a; rd32=zext(v); ra32=ra32+SImm12; }
:lb rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=3 & rd32 & ra32 & SImm12 { local v:1=*:1 ra32; rd32=sext(v); ra32=ra32+SImm12; }
:sw rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=4 & rd32 & ra32 & SImm12 { local a:4=ra32 & 0xfffffffc; *:4 a=rd32; ra32=ra32+SImm12; }
:sh rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=5 & rd32 & ra32 & SImm12 { local a:4=ra32 & 0xfffffffe; local v:2=rd32:2; *:2 a=v; ra32=ra32+SImm12; }
:lbu rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=6 & rd32 & ra32 & SImm12 { local v:1=*:1 ra32; rd32=zext(v); ra32=ra32+SImm12; }
:sb rd32,ra32,SImm12 is p_lo=1 & p_hi=1 & major32=7 & rix_func3=7 & rd32 & ra32 & SImm12 { local v:1=rd32:1; *:1 ra32=v; ra32=ra32+SImm12; }

# RI forms
:addri rd32,ra32,SImm14 is p_lo=1 & p_hi=1 & major32=8 & cu=0 & rd32 & ra32 & SImm14 { rd32=ra32+SImm14; }
:addri.c rd32,ra32,SImm14 is p_lo=1 & p_hi=1 & major32=8 & cu=1 & rd32 & ra32 & SImm14 { local result:4=ra32+SImm14; score_set_add_flags(ra32,SImm14,result); rd32=result; }
:andri rd32,ra32,UImm14 is p_lo=1 & p_hi=1 & major32=12 & cu=0 & rd32 & ra32 & UImm14 { rd32=ra32 & UImm14; }
