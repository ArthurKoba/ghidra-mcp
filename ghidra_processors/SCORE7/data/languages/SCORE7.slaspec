# Sunplus S+CORE 7 / SCORE7
# Native Ghidra SLEIGH processor definition.
#
# Encoding and execution behavior were independently implemented from public
# architectural behavior, with MAME's BSD-3-Clause SCORE7 implementation used
# as a permissive reference and GNU binutils used only as a differential oracle.
#
# SCORE7 uses 16-bit and 32-bit instructions. 32-bit instructions contain
# parity/length marker bits at physical bits 15 and 31; the logical 30-bit
# opcode omits those two bits.

define endian=little;
define alignment=2;

define space ram type=ram_space size=4 wordsize=1 default;
define space register type=register_space size=4;

define register offset=0x000 size=4
[ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 ];

# GCC SCORE ABI: r0=r0, r2=r2, r3=return address, r28=r28.
# Keep one physical varnode per architectural register; ABI roles live in
# SCORE7.cspec instead of duplicate SLEIGH register aliases.

define register offset=0x100 size=4
[ cr0 cr1 cr2 cr3 cr4 cr5 cr6 cr7 cr8 cr9 cr10 cr11 cr12 cr13 cr14 cr15 cr16 cr17 cr18 cr19 cr20 cr21 cr22 cr23 cr24 cr25 cr26 cr27 cr28 cr29 cr30 cr31 ];

# Control registers remain canonical cr0..cr31. Their architectural names
# (PSR, condition register, ECR, EXCPVEC, CCR, EPC, EMA, ...) are documented
# in the module and can be surfaced by register markup without duplicate
# varnodes.

define register offset=0x200 size=4 [ sr0 sr1 sr2 ];
define register offset=0x210 size=4 [ ceh cel ];
define register offset=0x300 size=4 pc;

# SCORE7 long instructions and PCE packets may only begin at 4-byte packet
# boundaries.  Ghidra's instruction alignment is 2 bytes because ordinary
# compact instructions can start at +2, so derive the packet phase from the
# actual instruction address before matching the instruction subtable.
define register offset=0x304 size=4 score_context;
define context score_context
    packet_phase=(0,0) noflow
;

# System/custom operations whose architectural side effects are not modeled
# by the permissive reference implementation.
define pcodeop score_syscall;
define pcodeop score_trap;
define pcodeop score_debug_break;
define pcodeop score_pflush;
define pcodeop score_cache;
define pcodeop score_cenew;
define pcodeop score_custom_engine;
define pcodeop score_pce;
define pcodeop score_parity_error;

# Physical 32-bit encoding. p_lo/p_hi are marker/parity bits and are not part
# of the logical 30-bit opcode.
define token score32(32)
    p_lo        = (15,15)
    p_hi        = (31,31)
    major32     = (26,30)
    rd32        = (21,25)
    ra32        = (16,20)
    rb32        = (10,14)
    func6       = (1,6)
    cu          = (0,0)

    ifunc3      = (18,20)
    imm16_lo    = (1,14)
    imm16_hi    = (16,17)
    imm16_hi_s  = (16,17) signed

    ri_imm14    = (1,14)
    ri_imm14_s  = (1,14) signed

    jdisp_lo    = (1,14)
    jdisp_hi    = (16,25)

    bc_disp_lo  = (1,9)
    bc_disp_hi  = (16,25)
    bc_disp_hi_s= (16,25) signed
    bc_cond     = (10,14)

    rix_func3   = (0,2)
    rix_imm12   = (3,14) signed

    cr_op       = (0,7)
    cr_idx      = (16,20)

    ls_imm15    = (0,14) signed
    ls_imm15_u  = (0,14)

    pce_lo      = (0,14)
    pce_hi      = (16,30)
;

# Physical 16-bit encoding. Bit 15 is the SCORE parity/length marker.
define token score16(16)
    p16         = (15,15)
    op16        = (12,14)
    rd16        = (8,11)
    ra16        = (4,7)
    func16      = (0,3)

    j11         = (1,11)
    lk16        = (0,0)

    b8          = (0,7) signed
    cond16      = (8,11)

    imm8        = (0,7)
    i16_func3   = (0,2)
    imm5        = (3,7)
    imm4        = (3,6)
    imm_sign    = (7,7)

    preg_base   = (4,6)
    preg_hi     = (7,7)
    preg_lo     = (8,11)
;

attach variables [ rd32 ra32 rb32 ] [
    r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31
];

attach variables [ cr_idx ] [
    cr0 cr1 cr2 cr3 cr4 cr5 cr6 cr7 cr8 cr9 cr10 cr11 cr12 cr13 cr14 cr15 cr16 cr17 cr18 cr19 cr20 cr21 cr22 cr23 cr24 cr25 cr26 cr27 cr28 cr29 cr30 cr31
];

attach variables [ rd16 ra16 ] [
    r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
];

attach variables [ preg_base ] [
    r0 r1 r2 r3 r4 r5 r6 r7
];

# ----- computed immediates / targets -----

SImm16: val is imm16_lo & imm16_hi_s
    [ val = (imm16_hi_s << 14) | imm16_lo; ]
    { export *[const]:4 val; }

UImm16: val is imm16_lo & imm16_hi
    [ val = (imm16_hi << 14) | imm16_lo; ]
    { export *[const]:4 val; }

SImm14: ri_imm14_s is ri_imm14_s
    { export *[const]:4 ri_imm14_s; }

UImm14: ri_imm14 is ri_imm14
    { export *[const]:4 ri_imm14; }

SImm12: rix_imm12 is rix_imm12
    { export *[const]:4 rix_imm12; }

SImm15: ls_imm15 is ls_imm15
    { export *[const]:4 ls_imm15; }

JTarget32: addr is jdisp_lo & jdisp_hi
    [ addr = (inst_start & 0xfe000000) | (((jdisp_hi << 14) | jdisp_lo) << 1); ]
    { export *:4 addr; }

BTarget32: addr is bc_disp_lo & bc_disp_hi_s
    [ addr = inst_start + (((bc_disp_hi_s << 9) | bc_disp_lo) << 1); ]
    { export *:4 addr; }

JTarget16: addr is j11
    [ addr = (inst_start & 0xfffff000) | (j11 << 1); ]
    { export *:4 addr; }

BTarget16: addr is b8
    [ addr = inst_start + (b8 << 1); ]
    { export *:4 addr; }

# 5-bit push/pop register is physically split across bit 7 and bits 8..11.
PReg: r0 is preg_hi=0 & preg_lo=0 & r0 { export r0; }
PReg: r1 is preg_hi=0 & preg_lo=1 & r1 { export r1; }
PReg: r2 is preg_hi=0 & preg_lo=2 & r2 { export r2; }
PReg: r3 is preg_hi=0 & preg_lo=3 & r3 { export r3; }
PReg: r4 is preg_hi=0 & preg_lo=4 & r4 { export r4; }
PReg: r5 is preg_hi=0 & preg_lo=5 & r5 { export r5; }
PReg: r6 is preg_hi=0 & preg_lo=6 & r6 { export r6; }
PReg: r7 is preg_hi=0 & preg_lo=7 & r7 { export r7; }
PReg: r8 is preg_hi=0 & preg_lo=8 & r8 { export r8; }
PReg: r9 is preg_hi=0 & preg_lo=9 & r9 { export r9; }
PReg: r10 is preg_hi=0 & preg_lo=10 & r10 { export r10; }
PReg: r11 is preg_hi=0 & preg_lo=11 & r11 { export r11; }
PReg: r12 is preg_hi=0 & preg_lo=12 & r12 { export r12; }
PReg: r13 is preg_hi=0 & preg_lo=13 & r13 { export r13; }
PReg: r14 is preg_hi=0 & preg_lo=14 & r14 { export r14; }
PReg: r15 is preg_hi=0 & preg_lo=15 & r15 { export r15; }
PReg: r16 is preg_hi=1 & preg_lo=0 & r16 { export r16; }
PReg: r17 is preg_hi=1 & preg_lo=1 & r17 { export r17; }
PReg: r18 is preg_hi=1 & preg_lo=2 & r18 { export r18; }
PReg: r19 is preg_hi=1 & preg_lo=3 & r19 { export r19; }
PReg: r20 is preg_hi=1 & preg_lo=4 & r20 { export r20; }
PReg: r21 is preg_hi=1 & preg_lo=5 & r21 { export r21; }
PReg: r22 is preg_hi=1 & preg_lo=6 & r22 { export r22; }
PReg: r23 is preg_hi=1 & preg_lo=7 & r23 { export r23; }
PReg: r24 is preg_hi=1 & preg_lo=8 & r24 { export r24; }
PReg: r25 is preg_hi=1 & preg_lo=9 & r25 { export r25; }
PReg: r26 is preg_hi=1 & preg_lo=10 & r26 { export r26; }
PReg: r27 is preg_hi=1 & preg_lo=11 & r27 { export r27; }
PReg: r28 is preg_hi=1 & preg_lo=12 & r28 { export r28; }
PReg: r29 is preg_hi=1 & preg_lo=13 & r29 { export r29; }
PReg: r30 is preg_hi=1 & preg_lo=14 & r30 { export r30; }
PReg: r31 is preg_hi=1 & preg_lo=15 & r31 { export r31; }


# High GPR bank used by mlfh!/mhfl!.
HighRA: r16 is ra16=0 & r16 { export r16; }
HighRA: r17 is ra16=1 & r17 { export r17; }
HighRA: r18 is ra16=2 & r18 { export r18; }
HighRA: r19 is ra16=3 & r19 { export r19; }
HighRA: r20 is ra16=4 & r20 { export r20; }
HighRA: r21 is ra16=5 & r21 { export r21; }
HighRA: r22 is ra16=6 & r22 { export r22; }
HighRA: r23 is ra16=7 & r23 { export r23; }
HighRA: r24 is ra16=8 & r24 { export r24; }
HighRA: r25 is ra16=9 & r25 { export r25; }
HighRA: r26 is ra16=10 & r26 { export r26; }
HighRA: r27 is ra16=11 & r27 { export r27; }
HighRA: r28 is ra16=12 & r28 { export r28; }
HighRA: r29 is ra16=13 & r29 { export r29; }
HighRA: r30 is ra16=14 & r30 { export r30; }
HighRA: r31 is ra16=15 & r31 { export r31; }
HighRD: r16 is rd16=0 & r16 { export r16; }
HighRD: r17 is rd16=1 & r17 { export r17; }
HighRD: r18 is rd16=2 & r18 { export r18; }
HighRD: r19 is rd16=3 & r19 { export r19; }
HighRD: r20 is rd16=4 & r20 { export r20; }
HighRD: r21 is rd16=5 & r21 { export r21; }
HighRD: r22 is rd16=6 & r22 { export r22; }
HighRD: r23 is rd16=7 & r23 { export r23; }
HighRD: r24 is rd16=8 & r24 { export r24; }
HighRD: r25 is rd16=9 & r25 { export r25; }
HighRD: r26 is rd16=10 & r26 { export r26; }
HighRD: r27 is rd16=11 & r27 { export r27; }
HighRD: r28 is rd16=12 & r28 { export r28; }
HighRD: r29 is rd16=13 & r29 { export r29; }
HighRD: r30 is rd16=14 & r30 { export r30; }
HighRD: r31 is rd16=15 & r31 { export r31; }

# ----- flag helpers -----
# cr1 low bits: V=bit0, C=bit1, Z=bit2, N=bit3, T=bit4.

macro score_set_zn(value) {
    local z:1 = (value == 0);
    local n:1 = (value s< 0);
    cr1 = cr1 & 0xfffffff3;
    cr1 = cr1 | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_add_flags(a,b,result) {
    local c:1 = carry(a,b);
    local v:1 = scarry(a,b);
    local z:1 = (result == 0);
    local n:1 = (result s< 0);
    cr1 = cr1 & 0xfffffff0;
    cr1 = cr1 | zext(v) | (zext(c) << 1) | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_sub_flags(a,b,result) {
    local c:1 = (a >= b);
    local v:1 = sborrow(a,b);
    local z:1 = (result == 0);
    local n:1 = (result s< 0);
    cr1 = cr1 & 0xfffffff0;
    cr1 = cr1 | zext(v) | (zext(c) << 1) | (zext(z) << 2) | (zext(n) << 3);
}

macro score_set_t(value) {
    local t:1 = (value != 0);
    cr1 = (cr1 & 0xffffffef) | (zext(t) << 4);
}

# ----- address phase / root instruction wrapper -----

ScorePhase: is epsilon
    [ packet_phase = (inst_start >> 1) $and 1; ]
    { }

:^ScoreInstruction is ScorePhase & ScoreInstruction {
    build ScoreInstruction;
}

# ----- parity / parallel encoding guards -----

ScoreInstruction:parity_error is packet_phase=0 & p_lo=1 & p_hi=0 {
    score_parity_error();
}

ScoreInstruction:pce pce_lo, pce_hi is packet_phase=0 & p_lo=0 & p_hi=1 & pce_lo & pce_hi {
    score_pce();
}

# ===========================================================================
# 32-bit instructions
# ===========================================================================

# Special form (major 0)
ScoreInstruction:nop is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=0 & cu=0 { }
ScoreInstruction:syscall rd32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=1 & rd32 { score_syscall(); }
ScoreInstruction:sdbbp ra32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=3 & ra32 { score_debug_break(); }
ScoreInstruction:pflush is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=5 { score_pflush(); }

ScoreInstruction:add rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=8 & cu=0 & rd32 & ra32 & rb32 {
    rd32 = ra32 + rb32;
}
ScoreInstruction:add.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=8 & cu=1 & rd32 & ra32 & rb32 {
    local result:4 = ra32 + rb32;
    score_set_add_flags(ra32,rb32,result);
    rd32 = result;
}
ScoreInstruction:addc rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=9 & cu=0 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    rd32 = ra32 + rb32 + c;
}
ScoreInstruction:addc.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=9 & cu=1 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    local op2:4 = rb32 + c;
    local result:4 = ra32 + op2;
    score_set_add_flags(ra32,op2,result);
    rd32 = result;
}
ScoreInstruction:sub rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=10 & cu=0 & rd32 & ra32 & rb32 {
    rd32 = ra32 - rb32;
}
ScoreInstruction:sub.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=10 & cu=1 & rd32 & ra32 & rb32 {
    local result:4 = ra32 - rb32;
    score_set_sub_flags(ra32,rb32,result);
    rd32 = result;
}
ScoreInstruction:subc rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=11 & cu=0 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    rd32 = ra32 - rb32 - (1-c);
}
ScoreInstruction:subc.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=11 & cu=1 & rd32 & ra32 & rb32 {
    local c:4 = (cr1 >> 1) & 1;
    local borrow:4 = 1-c;
    local op1:4 = ra32-borrow;
    local result:4 = op1-rb32;
    score_set_sub_flags(op1,rb32,result);
    rd32=result;
}
ScoreInstruction:cmp.c ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=12 & cu=1 & rd32=0 & ra32 & rb32 {
    local result:4=ra32-rb32;
    score_set_sub_flags(ra32,rb32,result);
    score_set_t(result==0);
}
ScoreInstruction:cmpz.c ra32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=13 & cu=1 & rd32=0 & ra32 {
    local result:4=ra32;
    score_set_sub_flags(ra32,0:4,result);
    score_set_t(result==0);
}
ScoreInstruction:neg rd32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=15 & cu=0 & rd32 & rb32 {
    rd32=0-rb32;
}
ScoreInstruction:neg.c rd32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=15 & cu=1 & rd32 & rb32 {
    local result:4=0-rb32;
    score_set_sub_flags(0:4,rb32,result);
    rd32=result;
}
ScoreInstruction:and rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=16 & cu=0 & rd32 & ra32 & rb32 { rd32=ra32 & rb32; }
ScoreInstruction:and.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=16 & cu=1 & rd32 & ra32 & rb32 { rd32=ra32 & rb32; score_set_zn(rd32); }
ScoreInstruction:or rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=17 & cu=0 & rd32 & ra32 & rb32 { rd32=ra32 | rb32; }
ScoreInstruction:or.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=17 & cu=1 & rd32 & ra32 & rb32 { rd32=ra32 | rb32; score_set_zn(rd32); }
ScoreInstruction:not rd32,ra32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=18 & cu=0 & rd32 & ra32 { rd32=~ra32; }
ScoreInstruction:not.c rd32,ra32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=18 & cu=1 & rd32 & ra32 { rd32=~ra32; score_set_zn(rd32); }
ScoreInstruction:xor rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=19 & cu=0 & rd32 & ra32 & rb32 { rd32=ra32 ^ rb32; }
ScoreInstruction:xor.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=19 & cu=1 & rd32 & ra32 & rb32 { rd32=ra32 ^ rb32; score_set_zn(rd32); }

ScoreInstruction:bitclr rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=20 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 & ~(1 << sh); }
ScoreInstruction:bitclr.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=20 & cu=1 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 & ~(1 << sh); score_set_zn(rd32); }
ScoreInstruction:bitset rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=21 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 | (1 << sh); }
ScoreInstruction:bitset.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=21 & cu=1 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 | (1 << sh); score_set_zn(rd32); }
ScoreInstruction:bittst.c ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=22 & cu=1 & ra32 & rb32 { local sh:4=rb32 & 31; local v:4=ra32 & (1 << sh); score_set_zn(v); }
ScoreInstruction:bittgl rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=23 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 ^ (1 << sh); }
ScoreInstruction:bittgl.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=23 & cu=1 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 ^ (1 << sh); score_set_zn(rd32); }

ScoreInstruction:sll rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=24 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 << sh; }
ScoreInstruction:sll.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=24 & cu=1 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 << sh; score_set_zn(rd32); }
ScoreInstruction:srl rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=26 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 >> sh; }
ScoreInstruction:srl.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=26 & cu=1 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 >> sh; score_set_zn(rd32); }
ScoreInstruction:sra rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=27 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 s>> sh; }
ScoreInstruction:sra.c rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=27 & cu=1 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=ra32 s>> sh; score_set_zn(rd32); }

ScoreInstruction:ror rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=28 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=(ra32 >> sh) | (ra32 << (32-sh)); }
ScoreInstruction:rol rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=30 & cu=0 & rd32 & ra32 & rb32 { local sh:4=rb32 & 31; rd32=(ra32 << sh) | (ra32 >> (32-sh)); }
ScoreInstruction:rorc rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=29 & rd32 & ra32 & rb32 { score_custom_engine(); }
ScoreInstruction:rolc rd32,ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=31 & rd32 & ra32 & rb32 { score_custom_engine(); }

ScoreInstruction:mul ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=32 & ra32 & rb32 {
    local a:8=sext(ra32); local b:8=sext(rb32); local product:8=a*b;
    cel=product:4;
    local upper:8=product >> 32;
    ceh=upper:4;
}
ScoreInstruction:mulu ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=33 & ra32 & rb32 {
    local a:8=zext(ra32); local b:8=zext(rb32); local product:8=a*b;
    cel=product:4;
    local upper:8=product >> 32;
    ceh=upper:4;
}
ScoreInstruction:div ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=34 & ra32 & rb32 {
    if (rb32 == 0) goto <bad>; cel=ra32 s/ rb32; ceh=ra32 s% rb32; goto <done>;
    <bad> score_trap();
    <done>
}
ScoreInstruction:divu ra32,rb32 is packet_phase=0 & p_lo=1 & p_hi=1 & major32=0 & func6=35 & ra32 & rb32 {
    if (rb32 == 0) goto <bad>; cel=ra32 / rb32; ceh=ra32 % rb32; goto <done>;
    <bad> score_trap();
    <done>
}

